{
  "name": "scan-chat-ai",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Scan-Chat Medical AI — pilot scaffold (Astro + Tailwind + Vercel + Gemini)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
    "preview": "astro preview",
    "start": "astro dev",
    "verify:ad-hoc": "npm run verify:ad-hoc-archive && npm run verify:ad-hoc-parse && npm run verify:ad-hoc-e2e && npm run verify:ad-hoc-write-guard && npm run verify:ad-hoc-chunked && npm run verify:ad-hoc-genoplan-pages && npm run verify:ad-hoc-health-wiring && npm run verify:ad-hoc-questionnaire-manual && npm run verify:ad-hoc-external-form && npm run verify:ad-hoc-questionnaire-branch && npm run verify:ad-hoc-single-write && npm run verify:ad-hoc-payload-gate",
    "verify:ad-hoc-archive": "node scripts/verify-ad-hoc-archive.mjs",
    "verify:ad-hoc-chunked": "node scripts/verify-ad-hoc-chunked.mjs",
    "verify:ad-hoc-e2e": "node scripts/verify-ad-hoc-e2e.mjs",
    "verify:ad-hoc-external-form": "node scripts/verify-ad-hoc-external-form.mjs",
    "verify:ad-hoc-genoplan-pages": "node scripts/verify-ad-hoc-genoplan-pages.mjs",
    "verify:ad-hoc-health-wiring": "node scripts/verify-ad-hoc-health-wiring.mjs",
    "verify:ad-hoc-parse": "node scripts/verify-ad-hoc-parse.mjs",
    "verify:ad-hoc-payload-gate": "node scripts/verify-ad-hoc-payload-gate.mjs",
    "verify:ad-hoc-questionnaire-branch": "node scripts/verify-ad-hoc-questionnaire-branch.mjs",
    "verify:ad-hoc-questionnaire-manual": "node scripts/verify-ad-hoc-questionnaire-manual.mjs",
    "verify:ad-hoc-single-write": "node scripts/verify-ad-hoc-single-write.mjs",
    "verify:ad-hoc-write-guard": "node scripts/verify-ad-hoc-write-guard.mjs",
    "verify:blood-csv": "esbuild scripts/verify-blood-csv-structure.ts --bundle --platform=node --format=esm | node --input-type=module",
    "verify:blood-parser": "esbuild scripts/verify-blood-parser.ts --bundle --platform=node --format=esm --log-level=error | node --input-type=module",
    "verify:demecal-final-setup": "node scripts/verify-demecal-final-setup.mjs",
    "verify:demecal-flow": "node scripts/verify-demecal-flow.mjs",
    "verify:demecal-health": "node scripts/verify-demecal-health.mjs",
    "verify:demecal-installer": "node scripts/verify-demecal-installer.mjs",
    "verify:demecal-production": "node scripts/verify-demecal-production.mjs",
    "verify:demecal-range": "node scripts/verify-demecal-range.mjs",
    "verify:demecal-scheduler": "node scripts/verify-demecal-scheduler.mjs",
    "verify:demo-gate": "node scripts/verify-demo-gate.mjs",
    "verify:elith-intake": "node scripts/verify-elith-intake.mjs",
    "verify:executive-diagnosis": "node scripts/verify-executive-diagnosis.mjs",
    "verify:intake-scope": "esbuild scripts/verify-intake-scope.ts --bundle --platform=node --format=esm --log-level=error | node --input-type=module",
    "verify:interview-ui": "node scripts/verify-interview-ui.mjs",
    "verify:laif-revoke-key": "node scripts/verify-laif-revoke-key.mjs",
    "verify:print": "node scripts/verify-print-pdf.mjs",
    "verify:probe-bat-gate": "node scripts/verify-probe-bat-gate.mjs",
    "verify:ps1-order": "esbuild scripts/verify-ps1-order.ts --bundle --platform=node --format=esm --log-level=error | node --input-type=module",
    "verify:report": "npm run verify:report-model && npm run verify:sheet-contract && npm run verify:demo-gate",
    "verify:report-model": "esbuild scripts/verify-report-model.ts --bundle --platform=node --format=esm --log-level=error \"--define:import.meta.env={}\" | node --input-type=module",
    "verify:scan-async": "node scripts/verify-scan-async.mjs",
    "verify:scan-pages": "node scripts/verify-scan-pages.mjs",
    "verify:scan-persist": "esbuild scripts/verify-scan-persist.ts --bundle --platform=node --format=esm --log-level=error \"--define:import.meta.env={}\" --outfile=node_modules/.cache/verify-scan-persist.mjs && node node_modules/.cache/verify-scan-persist.mjs",
    "verify:scan-upload": "npm run verify:scan-upload-key && node scripts/verify-scan-upload.mjs",
    "verify:scan-upload-key": "esbuild scripts/verify-scan-upload-key.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/verify-scan-upload-key.mjs && node node_modules/.cache/verify-scan-upload-key.mjs",
    "verify:screen": "node scripts/verify-screen.mjs",
    "verify:sheet-contract": "esbuild scripts/verify-sheet-contract.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/verify-sheet-contract.mjs && node node_modules/.cache/verify-sheet-contract.mjs",
    "verify:single-purchase": "node scripts/verify-single-purchase.mjs",
    "verify:special-accounts": "node scripts/verify-special-accounts.mjs",
    "verify:staging-bridge": "node scripts/verify-staging-bridge.mjs",
    "verify:viewer-origin": "node scripts/verify-viewer-origin.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^8.2.11",
    "@aws-sdk/client-s3": "^3.1072.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@google/genai": "^2.6.0",
    "@lucide/astro": "^1.31.0",
    "@supabase/supabase-js": "^2.46.1",
    "@zip.js/zip.js": "^2.14.0",
    "astro": "^5.18.2",
    "marked": "^18.0.4",
    "qrcode-generator": "^2.0.4",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
