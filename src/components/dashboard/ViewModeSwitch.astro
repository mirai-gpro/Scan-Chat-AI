---
/**
 * **Real / Demo の切り替え** (PR-C・正本
 * `docs/specs/special_demo_integration_spec_20261022.md` §4.2)。
 *
 * 【出す相手】**`viewMode.switchable` が true のときだけ** = 本人のセッションで
 * Demo の資格を持つ人。**一般の利用者には 1 px も出ない**・代理表示・共有・
 * 未サインインでも出ない (サーバが同じ判定で 403 にするので、画面と API が食い違わない)。
 *
 * 【見た目は既存の型だけ】「データ / グラフ」と同じ**同格の淡色ペア**
 * (`.btn-pair` + `.btn-data` / `.btn-graph`・`global.css`)。新しい視覚の型を作らない。
 * **brand 塗りは使わない** — 1 画面 1 つの塗りは AI疾病予防報告書のタイルのもの。
 */
import AppIcon from '../AppIcon.astro';
import type { ViewMode } from '../../lib/view-mode';

interface Props {
  mode: ViewMode;
  /** Real の資格 (スペシャル枠) も持っているか。文言を変えるためだけに使う。 */
  dual: boolean;
}
const { mode, dual } = Astro.props;
---

<section
  class="card mb-4 border-navy-400"
  aria-label="表示モードの切り替え"
  data-view-mode-switch
  data-mode={mode}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-slate-700">
      {mode === 'demo'
        ? 'デモのサンプルデータを表示しています。'
        : dual
          ? 'ご自身の検査データを表示しています。'
          : 'ご自身のデータを表示しています。'}
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        class={`btn-pair btn-data${mode === 'real' ? '' : ' btn-pair-off'}`}
        data-view-mode="real"
        aria-pressed={mode === 'real'}
      >
        <AppIcon name="ok" size={18} />自分のデータ
      </button>
      <button
        type="button"
        class={`btn-pair btn-graph${mode === 'demo' ? '' : ' btn-pair-off'}`}
        data-view-mode="demo"
        aria-pressed={mode === 'demo'}
      >
        <AppIcon name="trend" size={18} />デモ表示
      </button>
    </div>
  </div>
  <p class="mt-2 text-sm text-slate-700" data-view-mode-error hidden></p>
</section>

<script>
  /*
   * **Cookie は HttpOnly なので JS から書けない。** 必ずサーバの口を通す
   * (= サーバが毎回資格を確かめてから書く)。成功したら**ページを開き直す** —
   * 表示モードはサーバ側の全問い合わせに効くので、部分更新だと食い違う。
   */
  const root = document.querySelector('[data-view-mode-switch]');
  if (root) {
    const err = root.querySelector('[data-view-mode-error]') as HTMLElement | null;
    const current = root.getAttribute('data-mode');
    for (const btn of Array.from(root.querySelectorAll('[data-view-mode]'))) {
      btn.addEventListener('click', async () => {
        const want = btn.getAttribute('data-view-mode');
        if (!want || want === current) return; // いまと同じなら何もしない
        const buttons = Array.from(root.querySelectorAll('button'));
        for (const b of buttons) (b as HTMLButtonElement).disabled = true;
        try {
          const r = await fetch('/api/session/view-mode', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ mode: want }),
          });
          if (!r.ok) throw new Error(String(r.status));
          location.reload();
          return;
        } catch {
          // **行き止まりにしない** — 失敗を黙らせず、押し直せる状態へ戻す。
          if (err) { err.textContent = '表示モードを切り替えられませんでした。時間をおいてお試しください。'; err.hidden = false; }
          for (const b of buttons) (b as HTMLButtonElement).disabled = false;
        }
      });
    }
  }
</script>
