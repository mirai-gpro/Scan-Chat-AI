---
import AppIcon from '../AppIcon.astro';
import KitProgressRows from './KitProgressRows.astro';
import type { KitShipment } from '../../types/supabase';
import { formatJpDate } from '../../lib/dashboard-queries';
import { AI_PREVENTION_REPORT_LABEL } from '../../lib/display-names';

/**
 * **進捗** — 検査キットだけでなく、AI問診と検診・人間ドックのスキャンも含めた 1 本の流れ。
 *
 * 正本: `docs/operations/スペシャルアカウント_仕様書.md` §14。
 *
 * 【なぜ統合したか (発注者指示 2026-09-15)】
 * 「検査キットだけの進捗管理ではなく、スキャンや AI 問診も含めた進捗管理に」。
 * **コースプランでも、最初に検診・人間ドックのスキャンと AI 問診が要る**ので、
 * キットの進捗だけを出しても「次に何をすればよいか」が分からなかった。
 *
 * 【入口で中身が変わる】
 *   course … ① AI問診 → ② スキャン → ③ 検査キット → ④ 報告書
 *   single … ① AI問診 → ② スキャン →           ③ 報告書
 * 単品購入 (スペシャルアカウント) はキットが 1 つも無いので ③ を出さない。
 * **埋まらない枠を並べない。**
 *
 * 【状態は DB の事実だけ】未実行 / 完了済 の 2 値と、その日付。
 * **推測しない** — 届いていない報告書に「もうすぐできます」とは書かない (時期を当社は知らない)。
 */
interface Props {
  /** `course` = 検査プラン契約 / `single` = 単品購入 (スペシャルアカウント)。 */
  mode: 'course' | 'single';
  /** ヘッダーに出すプラン名。**単品購入でも出す** (発注者指示 2026-09-15)。 */
  planName?: string | null;
  /** `diagnosis.interview_completions` の最新。null = 未実行。 */
  interviewCompletedAt: string | null;
  /** `test_artifacts` の `health_checkup` 件数 (= スキャン済みの回数)。 */
  checkupCount: number;
  latestCheckupDate: string | null;
  /** `diagnosis_results.received_at`。null = まだ届いていない。 */
  reportReceivedAt: string | null;
  /**
   * **新着 (New) か** (発注者要望 2026-09「作成済のステータス New バッジ等」)。
   * 受領日から N 日以内 (判定は dashboard.astro が持つ・app_config `ui.report_new_days`)。
   * reportDone かつ新着のときだけ New ピルを出す。
   */
  reportIsNew?: boolean;
  /** 以下は course のみ。 */
  shipments?: (KitShipment & { lab_name: string | null })[];
  nextTestAt?: string | null;
  diagnosticUserId?: string;
  detailHref?: string;
  /** `?u=` を引き継ぐためのクエリ (admin の代理表示用)。 */
  q?: string;
}
const {
  mode,
  planName = null,
  interviewCompletedAt,
  checkupCount,
  latestCheckupDate,
  reportReceivedAt,
  reportIsNew = false,
  shipments = [],
  nextTestAt = null,
  diagnosticUserId = '',
  detailHref = '/kit',
  q = '',
} = Astro.props as Props;

const course = mode === 'course';
const interviewDone = !!interviewCompletedAt;
const checkupDone = checkupCount > 0;
const reportDone = !!reportReceivedAt;

/* 曜日は落として 1 行に収める (formatJpDate は「2026年9月15日 (月)」を返す)。 */
const shortJpDate = (iso: string | null | undefined) => formatJpDate(iso).replace(/\s*\(.\)$/, '');

/*
 * **「未実行」と「完了済」の 2 語で言い切る** (発注者指示 2026-09-15)。
 * 状態は**アイコン + テキスト + 色の 3 点セット**で出す (UI 確定事項)。色だけで表さない。
 */
const doneSteps = [interviewDone, checkupDone].filter(Boolean).length;

const steps = [
  {
    icon: 'interview' as const,
    title: 'AI 問診',
    done: interviewDone,
    detail: interviewDone ? `完了済 ${shortJpDate(interviewCompletedAt)}` : '',
    note: interviewDone
      ? '答え直したいときは、もう一度はじめから答えられます。'
      : '生活習慣をうかがいます。実行してください（途中でやめても続きから再開できます）。',
    href: `/chat${q}`,
    action: interviewDone ? 'もう一度実行する' : 'AI 問診を実行する',
  },
  {
    icon: 'scan' as const,
    title: '検診・人間ドックのスキャン',
    done: checkupDone,
    detail: checkupDone
      ? `完了済 ${checkupCount} 回分${latestCheckupDate ? `（最新 ${shortJpDate(latestCheckupDate)}）` : ''}`
      : '',
    note: checkupDone
      ? '別の年度の結果も、同じ手順で追加できます。'
      : '結果票を撮影するか、PDF・画像を選んでください。実行してください。',
    href: `/scan${q}`,
    action: checkupDone ? '別の年度を追加する' : 'スキャンを実行する',
  },
];
---

<section class="card">
  <header class="mb-3.5 flex flex-wrap items-center justify-between gap-2">
    <h2 class="flex shrink-0 items-center gap-2 text-base font-bold text-navy-800">
      <AppIcon name="kit" size={20} class="text-brand-700" /><span class="whitespace-nowrap">進捗</span>
    </h2>
    <div class="flex flex-wrap items-center gap-3">
      {planName && (
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-sm font-medium text-slate-700">
          {planName}
        </span>
      )}
      <span class="tnum text-sm text-slate-600">{doneSteps} / 2 完了</span>
      {/*
        詳細ページ (/kit) は**キットの話しか無い**ので、キットを持たない単品購入では出さない。
        押した先に自分に関係のあるものが 1 つも無いリンクを置かない。
      */}
      {course && (
        <a href={detailHref} class="inline-flex min-h-touch items-center gap-1.5 text-base font-semibold text-brand-700 hover:underline">
          進捗の詳細を見る
          <AppIcon name="next" size={18} />
        </a>
      )}
    </div>
  </header>

  <ol class="flex flex-col gap-3">
    {steps.map((s, i) => (
      <li class="flex flex-wrap items-center gap-x-3 gap-y-2.5 rounded-xl border border-slate-200 bg-white p-3 xl:flex-nowrap xl:gap-4">
        <span class={`grid h-10 w-10 shrink-0 place-items-center rounded-xl ${
          s.done ? 'bg-brand-50 text-brand-700' : 'bg-mist text-navy-800'
        }`}>
          <AppIcon name={s.icon} size={20} />
        </span>

        <span class="flex min-w-0 flex-1 flex-col gap-1">
          <span class="flex flex-wrap items-center gap-2">
            <span class="text-base font-bold text-navy-800">{i + 1}. {s.title}</span>
            <span class={`status-pill ${s.done ? 'status-ok' : 'status-action'}`}>
              <AppIcon name={s.done ? 'ok' : 'action'} size={14} />{s.done ? '完了済' : '未実行'}
            </span>
          </span>
          {s.detail && <span class="tnum text-sm font-medium text-brand-700">{s.detail}</span>}
          <span class="text-sm text-slate-600">{s.note}</span>
        </span>

        <a href={s.href} class={`btn-pair ${s.done ? 'btn-graph' : 'btn-data'} w-full xl:w-auto`}>
          <AppIcon name={s.icon} size={18} />{s.action}
        </a>
      </li>
    ))}

    {/*
      ③ 検査キット (コースプランのみ)。**行の描画は `KitProgressRows` が持つ** —
      6 段ステッパーと自己申告ボタンは `kit-self-report.ts` と組なので、写して増やさない。
    */}
    {course && (
      <li class="flex flex-col gap-2.5 rounded-xl border border-slate-200 bg-white p-3">
        <span class="text-base font-bold text-navy-800">3. 検査キット</span>
        <KitProgressRows shipments={shipments} nextTestAt={nextTestAt} diagnosticUserId={diagnosticUserId} />
      </li>
    )}

    {/*
      最後は報告書。**状態だけで、ボタンは置かない** — 押す先は上の報告書タイルが持っている。
      同じ画面に同じ行き先のボタンを 2 つ並べない。
    */}
    <li class="flex flex-wrap items-center gap-x-3 gap-y-2.5 rounded-xl border border-dashed border-slate-300 p-3 xl:flex-nowrap xl:gap-4">
      <span class={`grid h-10 w-10 shrink-0 place-items-center rounded-xl ${
        reportDone ? 'bg-brand-50 text-brand-700' : 'bg-slate-100 text-slate-500'
      }`}>
        <AppIcon name="report" size={20} />
      </span>
      <span class="flex min-w-0 flex-1 flex-col gap-1">
        <span class="flex flex-wrap items-center gap-2">
          <span class="text-base font-bold text-navy-800">{course ? 4 : 3}. {AI_PREVENTION_REPORT_LABEL}</span>
          <span class={`status-pill ${reportDone ? 'status-ok' : 'status-unknown'}`}>
            <AppIcon name={reportDone ? 'ok' : 'clock'} size={14} />{reportDone ? 'お届け済み' : '未着'}
          </span>
          {reportDone && reportIsNew && (
            <span class="rounded-full bg-brand-600 px-2 py-0.5 text-xs font-bold tracking-wide text-white">New</span>
          )}
        </span>
        {reportDone && <span class="tnum text-sm font-medium text-brand-700">{shortJpDate(reportReceivedAt)}</span>}
        <span class="text-sm text-slate-600">
          {reportDone
            ? '上の「報告書を読む」から開けます。'
            : `1 と 2 がそろうと、AI 診断にかけて${AI_PREVENTION_REPORT_LABEL}をお届けします。`}
        </span>
      </span>
    </li>
  </ol>
</section>
