---
/**
 * 受取時・外部検査ID — **どの用紙のどこを読むか**を図で示す。
 *
 * 正本: `docs/lab/kit_receipt_external_id_capture_spec.md` §4.6。
 *
 * 【なぜ図が要るか】
 * 用紙には**数字が何種類も印字されている**（問合せ窓口の電話番号・右上の管理番号・
 * 未記入の検査ID欄）。文章だけだと別の数字を撮ってしまい、
 * **形式検証を通らない値ばかりが `review_required` で溜まる**（＝事務局の手作業が増える）。
 *
 * 【実物に基づくのはデメカルだけ】
 * 2026-10-12 に**実物の用紙 1 枚**を確認できたのはデメカル
 * （「検査申し込み用紙（返送用）」）。**プリベントの同梱書面はまだ見ていない**ので
 * **図を描かない**（想像で枠を描くと、利用者は「この図のとおりの紙」を探してしまう）。
 * 実物を確認したら同じ形で足す。
 *
 * 【図に本物の番号を入れない】
 * 問合せ番号は外部検査IDそのもので、`maskExternalId` で末尾 4 桁しか画面に出さない値。
 * **図のサンプルは 0 の並び**にして、桁数だけが伝わるようにする。
 *
 * 【実物の写真を同梱しない】
 * 写真には実際の番号が写る。**線画にすれば PII を持たずに位置だけ伝えられる**し、
 * 端末やテーマによらず同じ見え方になる（画像アセットも増えない）。
 */
import type { ExternalIdProvider } from '../../lib/external-test-id';

interface Props {
  provider: ExternalIdProvider;
}
const { provider } = Astro.props as Props;

/** 図を持っている provider だけ。**実物を見ていないものは描かない**。 */
const hasDiagram = provider === 'demecal';

/*
 * 「これではありません」= **実物で数字が印字されていると確認できた場所だけ**を挙げる。
 * 推測で増やさない（挙げた場所が無いと、利用者はそれを探して余計に迷う）。
 */
const CONFUSABLE: string[] = [
  '「問合せ窓口」の電話番号（0120 で始まる番号）',
  '「検査ID」の欄（D で始まるマス目。初めての方は未記入のままで結構です）',
  '用紙の右上・右下にある管理用の記号',
];
---

{hasDiagram && (
  <div class="mt-3 rounded-xl border border-navy-400 bg-white p-3">
    <p class="text-base font-semibold text-navy-800">この用紙の、この場所です</p>

    {/*
      用紙の上部の模式図。**実物の配置をなぞった線画**で、数字はダミー。
      `role="img"` + `<title>` で、読み上げでも何の図か分かるようにする。
    */}
    <svg
      viewBox="0 0 320 136"
      class="mt-2 h-auto w-full max-w-[26rem]"
      role="img"
      aria-labelledby={`sheet-fig-${provider}`}
    >
      <title id={`sheet-fig-${provider}`}>
        検査申し込み用紙（返送用）の上部。問合せ番号と、その右の横線のバーコードを囲んだ図。
      </title>

      {/* 紙 */}
      <rect x="2" y="2" width="316" height="132" rx="4" fill="#FFFFFF" stroke="#CBD5E1" />

      {/* 見出しの帯 */}
      <rect x="10" y="9" width="150" height="16" rx="2" fill="#DCECEF" />
      <text x="16" y="21" font-size="9" fill="#102B3A">検査申し込み用紙（返送用）</text>
      <rect x="166" y="9" width="20" height="16" rx="2" fill="#287F86" />
      <text x="170" y="21" font-size="8" fill="#FFFFFF">重要</text>

      {/* 検査名の行 */}
      <rect x="10" y="31" width="44" height="16" rx="2" fill="#DCECEF" />
      <text x="15" y="43" font-size="8" fill="#102B3A">検査名</text>
      <rect x="58" y="31" width="252" height="16" rx="2" fill="#FFFFFF" stroke="#CBD5E1" />
      <line x1="66" y1="40" x2="190" y2="40" stroke="#CBD5E1" stroke-width="3" />

      {/* 問合せ番号の行 — ここが読み取り対象 */}
      <rect x="10" y="53" width="44" height="22" rx="2" fill="#DCECEF" />
      <text x="13" y="68" font-size="8" fill="#102B3A">問合せ番号</text>
      <rect x="58" y="53" width="252" height="22" rx="2" fill="#FFFFFF" stroke="#CBD5E1" />
      <text x="64" y="68" font-size="10" fill="#94A3B8" font-family="ui-monospace, monospace">
        000000000000000
      </text>
      <text x="160" y="68" font-size="7" fill="#94A3B8">（15桁・例）</text>
      {/* バーコード (縞の幅は実物の規格を表していない。位置だけを示す) */}
      {[0, 4, 7, 12, 15, 19, 24, 27, 32, 36, 39, 44, 48, 51, 56, 60, 64, 68].map((d, i) => (
        <rect x={214 + d} y="56" width={i % 3 === 0 ? 2.5 : 1.2} height="16" fill="#102B3A" />
      ))}

      {/* 読み取り対象の囲み */}
      <rect
        x="56" y="51" width="256" height="26" rx="4"
        fill="none" stroke="#287F86" stroke-width="2"
      />
      <text x="56" y="86" font-size="8" font-weight="bold" fill="#287F86">
        ↑ この行（番号と、右の横線のバーコード）
      </text>

      {/* 問合せ窓口の行 — 取り違えやすいので図にも出す */}
      <rect x="10" y="92" width="44" height="16" rx="2" fill="#DCECEF" />
      <text x="13" y="104" font-size="8" fill="#102B3A">問合せ窓口</text>
      <rect x="58" y="92" width="252" height="16" rx="2" fill="#FFFFFF" stroke="#CBD5E1" />
      <text x="64" y="104" font-size="8" fill="#94A3B8">0120-…（電話番号。これではありません）</text>

      {/* 以降の記入欄 (薄く) */}
      <rect x="10" y="114" width="44" height="14" rx="2" fill="#F1F5F9" />
      <text x="17" y="124" font-size="7" fill="#94A3B8">検査ID</text>
      <rect x="58" y="114" width="252" height="14" rx="2" fill="#FFFFFF" stroke="#E2E8F0" />
      <text x="64" y="124" font-size="7" fill="#CBD5E1">D ────────（未記入で結構です）</text>
    </svg>

    <p class="mt-2 text-sm text-slate-700">
      用紙は<strong>複写式</strong>です。<strong>1 枚目</strong>（返送する用紙）でも
      2 枚目の控えでも、同じ番号が印字されています。
    </p>

    <p class="mt-2 text-sm font-semibold text-slate-800">これではありません</p>
    <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm text-slate-700">
      {CONFUSABLE.map((t) => <li>{t}</li>)}
    </ul>
  </div>
)}
