---
/**
 * 受取時・外部検査ID — **どの用紙のどこを読むか**を図で示す。
 *
 * 正本: `docs/lab/kit_receipt_external_id_capture_spec.md` §4.6。
 *
 * 【なぜ図が要るか】
 * 用紙には**数字が何種類も印字されている**（問合せ窓口の電話番号・右上の管理番号・
 * 未記入の検査ID欄）。文章だけだと別の数字を撮ってしまい、
 * **形式検証を通らない値ばかりが `review_required` で溜まる**（＝事務局の手作業が増える）。
 *
 * 【どちらも実物に基づく】
 *   - デメカル … 「検査申し込み用紙（返送用）」（2026-10-12 に実物 1 枚を確認）
 *   - プリベント … 「シール台紙」（2026-10-13 に実物 1 枚を確認）
 * **実物を見ていない様式の図は描かない**（想像で枠を描くと、利用者は
 * 「この図のとおりの紙」を探してしまう）。
 *
 * 【図に本物の番号を入れない】
 * 問合せ番号は外部検査IDそのもので、`maskExternalId` で末尾 4 桁しか画面に出さない値。
 * **デメカルの図のサンプルは 0 の並び**にして、桁数だけが伝わるようにする。
 * **プリベントはリポジトリ共通のダミー `704000123`** を使う（ポータルのサンプル CSV・
 * 先方宛の依頼文と同じ値）。`704000` は先方の固定の接頭辞で、残り 3 桁は作り物。
 * **パスワードの値は図にも書かない**（台紙に印字されているが、ここで見せる必要が無い）。
 *
 * 【プリベントの図は白黒。実物の台紙がそうだから】
 * **2026-10-21 に描き直した**（発注者指示「用紙イメージが実物と違う。色味も含め実際の
 * 用紙に合わせて」・実物の写真を見て写した）。実物は**白地に黒 1 色の印刷物**で、
 * **黒丸に白抜きの番号**（1〜4）・上段の貼付用シール・右列のバーコードシール・
 * 下段のログイン用ブロック（QR と URL／ユーザーID／パスワード）という配置。
 * 淡色の装飾（`#DCECEF` 等）を紙に使うと、**手元の紙と図が別物に見える**。
 * **brand 色を使うのは当社の注記（囲みと「↑ ここ」）だけ** — 台紙に無い線だと分かるように。
 * **写真そのものはリポジトリに入れない**（実在の番号とパスワードが写っている）。
 *
 * 【実物の写真を同梱しない】
 * 写真には実際の番号が写る。**線画にすれば PII を持たずに位置だけ伝えられる**し、
 * 端末やテーマによらず同じ見え方になる（画像アセットも増えない）。
 */
import type { ExternalIdProvider } from '../../lib/external-test-id';

interface Props {
  provider: ExternalIdProvider;
}
const { provider } = Astro.props as Props;

/** 図を持っている provider だけ。**実物を見ていないものは描かない**。 */
const hasDiagram = provider === 'demecal' || provider === 'prevent';

/*
 * 「これではありません」= **実物で確認できた、取り違えやすい印字だけ**を挙げる。
 * 推測で増やさない（挙げた場所が無いと、利用者はそれを探して余計に迷う）。
 */
const CONFUSABLE: Record<string, string[]> = {
  demecal: [
    '「問合せ窓口」の電話番号（0120 で始まる番号）',
    '「検査ID」の欄（D で始まるマス目。初めての方は未記入のままで結構です）',
    '用紙の右上・右下にある管理用の記号',
  ],
  prevent: [
    'QR コード（四角い模様）と、その横の URL',
    '**パスワード**（英字と数字が混ざったもの。これは登録用で、番号ではありません）',
  ],
};
const confusable = CONFUSABLE[provider] ?? [];

/**
 * バーコードの縞の位置。**実物の規格（Codabar）を表すものではない** —
 * 「ここに横線のバーコードがある」ことだけを伝えるための並び。
 */
const BARS = [0, 4, 7, 12, 15, 19, 24, 27, 32, 36, 39, 44, 48, 51, 56, 60, 64, 68, 72, 76, 80, 84];
/** 右列の小さいシールに入る縞（同じ理由で位置だけ）。 */
const MINI_BARS = [0, 3, 5, 9, 11, 14, 18, 21, 24, 28, 31, 35];
---

{hasDiagram && (
  <div class="mt-3 rounded-xl border border-navy-400 bg-white p-3">
    <p class="text-base font-semibold text-navy-800">この用紙の、この場所です</p>

    {/*
    用紙の上部の模式図。**実物の配置をなぞった線画**で、数字はダミー。
    `role="img"` + `<title>` で、読み上げでも何の図か分かるようにする。
    */}
    {provider === 'demecal' && (
      <svg
        viewBox="0 0 320 136"
        class="mt-2 h-auto w-full max-w-[26rem]"
        role="img"
        aria-labelledby={`sheet-fig-${provider}`}
      >
        <title id={`sheet-fig-${provider}`}>
          検査申し込み用紙（返送用）の上部。問合せ番号と、その右の横線のバーコードを囲んだ図。
        </title>
  
        {/* 紙 */}
        <rect x="2" y="2" width="316" height="132" rx="4" fill="#FFFFFF" stroke="#CBD5E1" />
  
        {/* 見出しの帯 */}
        <rect x="10" y="9" width="150" height="16" rx="2" fill="#DCECEF" />
        <text x="16" y="21" font-size="9" fill="#102B3A">検査申し込み用紙（返送用）</text>
        <rect x="166" y="9" width="20" height="16" rx="2" fill="#287F86" />
        <text x="170" y="21" font-size="8" fill="#FFFFFF">重要</text>
  
        {/* 検査名の行 */}
        <rect x="10" y="31" width="44" height="16" rx="2" fill="#DCECEF" />
        <text x="15" y="43" font-size="8" fill="#102B3A">検査名</text>
        <rect x="58" y="31" width="252" height="16" rx="2" fill="#FFFFFF" stroke="#CBD5E1" />
        <line x1="66" y1="40" x2="190" y2="40" stroke="#CBD5E1" stroke-width="3" />
  
        {/* 問合せ番号の行 — ここが読み取り対象 */}
        <rect x="10" y="53" width="44" height="22" rx="2" fill="#DCECEF" />
        <text x="13" y="68" font-size="8" fill="#102B3A">問合せ番号</text>
        <rect x="58" y="53" width="252" height="22" rx="2" fill="#FFFFFF" stroke="#CBD5E1" />
        <text x="64" y="68" font-size="10" fill="#94A3B8" font-family="ui-monospace, monospace">
          000000000000000
        </text>
        <text x="160" y="68" font-size="7" fill="#94A3B8">（15桁・例）</text>
        {/* バーコード (縞の幅は実物の規格を表していない。位置だけを示す) */}
        {[0, 4, 7, 12, 15, 19, 24, 27, 32, 36, 39, 44, 48, 51, 56, 60, 64, 68].map((d, i) => (
          <rect x={214 + d} y="56" width={i % 3 === 0 ? 2.5 : 1.2} height="16" fill="#102B3A" />
        ))}
  
        {/* 読み取り対象の囲み */}
        <rect
          x="56" y="51" width="256" height="26" rx="4"
          fill="none" stroke="#287F86" stroke-width="2"
        />
        <text x="56" y="86" font-size="8" font-weight="bold" fill="#287F86">
          ↑ この行（番号と、右の横線のバーコード）
        </text>
  
        {/* 問合せ窓口の行 — 取り違えやすいので図にも出す */}
        <rect x="10" y="92" width="44" height="16" rx="2" fill="#DCECEF" />
        <text x="13" y="104" font-size="8" fill="#102B3A">問合せ窓口</text>
        <rect x="58" y="92" width="252" height="16" rx="2" fill="#FFFFFF" stroke="#CBD5E1" />
        <text x="64" y="104" font-size="8" fill="#94A3B8">0120-…（電話番号。これではありません）</text>
  
        {/* 以降の記入欄 (薄く) */}
        <rect x="10" y="114" width="44" height="14" rx="2" fill="#F1F5F9" />
        <text x="17" y="124" font-size="7" fill="#94A3B8">検査ID</text>
        <rect x="58" y="114" width="252" height="14" rx="2" fill="#FFFFFF" stroke="#E2E8F0" />
        <text x="64" y="124" font-size="7" fill="#CBD5E1">D ────────（未記入で結構です）</text>
      </svg>
    )}

    {/*
    プリベントの「シール台紙」の模式図。**実物の配置をなぞった白黒の線画**で、番号はダミー。
    実物ではバーコードの下に **`A` で挟んだ形**が印字されている（Codabar の start/stop）。
    **図でもそのまま見せる** — 利用者が見る文字と図が食い違うと、かえって迷う。
    黒丸の番号（1〜4）は台紙に印字されている目印。**こちらで意味づけはしない**
    （何の手順かを書くと、見ていない説明文を当社が作ることになる）。
    */}
    {provider === 'prevent' && (
      <svg
        viewBox="0 0 320 196"
        class="mt-2 h-auto w-full max-w-[26rem]"
        role="img"
        aria-labelledby={`sheet-fig-${provider}`}
      >
        <title id={`sheet-fig-${provider}`}>
          プリベントのシール台紙。白黒の台紙で、ユーザーIDの印字と、その下の横線のバーコードを囲んだ図。
        </title>

        {/* 台紙。**実物は白黒の印刷物**なので、地は白・インクは黒だけで描く。 */}
        <rect x="2" y="2" width="316" height="192" rx="3" fill="#FFFFFF" stroke="#111827" stroke-width="0.8" />

        {/* 最上部の黒帯（白抜きの文字）。 */}
        <rect x="10" y="8" width="300" height="15" fill="#111827" />
        <text x="17" y="19.5" font-size="8.5" fill="#FFFFFF">シール台紙</text>

        {/* ── 上段: 貼って使うシール。切り取り線は破線で表す ── */}
        <rect x="10" y="29" width="92" height="30" fill="#FFFFFF" stroke="#111827" stroke-width="0.8" stroke-dasharray="3 2" />
        <circle cx="20" cy="39" r="6" fill="#111827" />
        <text x="20" y="41.5" font-size="7" fill="#FFFFFF" text-anchor="middle">1</text>
        <text x="30" y="42" font-size="6.5" fill="#111827">口止めシール</text>

        <rect x="108" y="29" width="92" height="30" fill="#FFFFFF" stroke="#111827" stroke-width="0.8" stroke-dasharray="3 2" />
        <circle cx="118" cy="39" r="6" fill="#111827" />
        <text x="118" y="41.5" font-size="7" fill="#FFFFFF" text-anchor="middle">2</text>
        <text x="128" y="42" font-size="6.5" fill="#111827">口止めシール</text>

        <rect x="206" y="29" width="104" height="30" fill="#FFFFFF" stroke="#111827" stroke-width="0.8" stroke-dasharray="3 2" />
        <circle cx="216" cy="39" r="6" fill="#111827" />
        <text x="216" y="41.5" font-size="7" fill="#FFFFFF" text-anchor="middle">3</text>
        <text x="226" y="42" font-size="6.5" fill="#111827">返信シール</text>

        {/* ── 中段左: 読み取り対象 = ユーザーID と、その下のバーコード ── */}
        <rect x="10" y="68" width="186" height="58" fill="#FFFFFF" stroke="#111827" stroke-width="0.8" />
        <text x="18" y="81" font-size="7.5" fill="#111827">ユーザーID</text>
        <text x="62" y="81.5" font-size="10" fill="#111827" font-family="ui-monospace, monospace">704000123</text>
        <text x="126" y="81" font-size="6.5" fill="#6B7280">（9桁・例）</text>
        <line x1="18" y1="87" x2="188" y2="87" stroke="#9CA3AF" stroke-width="0.8" />
        {/* バーコード（縞の幅は実物の規格を表していない。位置だけを示す）。 */}
        {BARS.map((d, i) => (
          <rect x={22 + d} y="92" width={i % 3 === 0 ? 2.6 : 1.2} height="18" fill="#111827" />
        ))}
        <text x="22" y="120" font-size="7" fill="#111827" font-family="ui-monospace, monospace">A704000123A</text>

        {/* 読み取り対象の囲み。**台紙には無い線＝当社の注記**なので、ここだけ brand 色。 */}
        <rect x="8" y="66" width="190" height="62" rx="4" fill="none" stroke="#287F86" stroke-width="2" />
        <text x="8" y="139" font-size="8" font-weight="bold" fill="#287F86">↑ ここ（ユーザーIDと、その下のバーコード）</text>

        {/* ── 中段右: 検体に貼るバーコードシール（同じ番号が入っている） ── */}
        {[68, 88, 108].map((y) => (
          <>
            <rect x="206" y={y} width="104" height="17" fill="#FFFFFF" stroke="#111827" stroke-width="0.8" stroke-dasharray="3 2" />
            <text x="212" y={y + 11} font-size="6" fill="#111827">バーコードシール</text>
            {MINI_BARS.map((d) => (
              <rect x={266 + d} y={y + 3} width="1.2" height="11" fill="#111827" />
            ))}
          </>
        ))}

        {/* ── 下段: ログイン用のブロック。**ここは読み取らない** ── */}
        <rect x="10" y="146" width="300" height="42" fill="#F3F4F6" stroke="#111827" stroke-width="0.8" />
        <circle cx="20" cy="156" r="6" fill="#111827" />
        <text x="20" y="158.5" font-size="7" fill="#FFFFFF" text-anchor="middle">4</text>
        <rect x="32" y="152" width="30" height="30" fill="#FFFFFF" stroke="#111827" stroke-width="0.8" />
        {/* QR の目印は 3 隅の四角だけ。**模様は実物を写したものではない**（読み取れる図にしない）。 */}
        <rect x="35" y="155" width="7" height="7" fill="#111827" />
        <rect x="52" y="155" width="7" height="7" fill="#111827" />
        <rect x="35" y="172" width="7" height="7" fill="#111827" />
        <text x="70" y="160" font-size="7" fill="#111827">URL ／ ユーザーID ／ パスワード</text>
        <text x="70" y="172" font-size="7.5" font-weight="bold" fill="#A98558">
          ここは読み取りません（登録用）
        </text>
        <text x="70" y="182" font-size="6.5" fill="#6B7280">パスワードは英字と数字が混ざっています</text>
      </svg>
    )}

    {provider === 'demecal' && (
      <p class="mt-2 text-sm text-slate-700">
        用紙は<strong>複写式</strong>です。<strong>1 枚目</strong>（返送する用紙）でも
        2 枚目の控えでも、同じ番号が印字されています。
      </p>
    )}
    {provider === 'prevent' && (
      <p class="mt-2 text-sm text-slate-700">
        <strong>シールを貼る前に撮影してください。</strong>
        台紙のシールは採尿容器や封筒に貼ってしまうと、台紙から無くなります。
      </p>
    )}

    <p class="mt-2 text-sm font-semibold text-slate-800">これではありません</p>
    <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm text-slate-700">
      {confusable.map((t) => <li set:html={t.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')}></li>)}
    </ul>
  </div>
)}
