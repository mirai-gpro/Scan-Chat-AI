---
import AppIcon from '../AppIcon.astro';
import ExternalIdSheetGuide from './ExternalIdSheetGuide.astro';
import {
  PROVIDER_ID_KIND, PROVIDER_ID_LABEL, type ExternalIdProvider,
} from '../../lib/external-test-id';

/**
 * 受取時・外部検査ID の撮影／登録ブロック。
 *
 * 正本: `docs/lab/kit_receipt_external_id_capture_spec.md` §4。
 *
 * 【カメラは**アプリ内**で開く (`getUserMedia`)。`<input capture>` は使わない】
 *
 * **2026-10-13 に方針を変えた。** それまでは `<input type="file" capture="environment">`
 * で OS のカメラアプリに任せていたが、**Android Chrome の実機で破綻した**:
 * 端末のカメラがバーコードを自動検出し、「この番号を調べる」側へ遷移してしまう。
 * **写真が返ってこないのでアプリ側では何も起きない** (エラーも出ない)。
 * **バーコードを撮る機能が、OS のバーコード検出に割り込まれる**という噛み合わせの悪さで、
 * 注意書きでは直らない (文言も挙動も端末ごとに違う)。
 *
 * → **`/scan` と同じアプリ内カメラ** (`initCameraScan` の `onShot`) に変えた。
 *   OS のカメラアプリを開かないので、検出に割り込まれる余地が無い。
 *
 *   - **権限拒否・カメラ無しのときは撮り直し／スマートフォンへ誘導する** (仕様 §4.4)。
 *   - PC には**カメラのボタンを出さない** (`touch-only` = CSS の `(pointer: coarse)`)。
 *     JS 側も同じ条件で判定する (`CLAUDE.md`「画面に出ていないカメラが JS から起動する」)。
 *
 * 【入口は撮影だけ。「写真を選ぶ」も「手で入力」も置かない (発注者指示 2026-10-21)】
 *   - **「写真を選ぶ」を撤去**: 主経路は撮影なのに同格の選択肢が 2 つ並んでいた。
 *   - **手入力を撤去**: 発注者指示「**チェックデジットもないのに、重要な検査IDを
 *     手入力させる対応はありえない**」。
 *     **この番号には検査用のチェックディジットが無い** (有無そのものが未確認・仕様 §2.3) ので、
 *     1 桁打ち間違えても**正しい形の別の番号**になる。画面も台帳も `linked` と表示するので
 *     **黙って別の検査に紐づく**。読めなかった回は**撮り直す**のが唯一の正しい道で、
 *     それでも読めない回は **admin の確認・訂正経路 (§12.1)** が引き受ける。
 *   - 「行き止まりにしない」(§5.1) は**撮り直し**と**スマートフォンへの導線**で満たす。
 *     **誤りを混ぜる逃げ道を置くことでは満たさない。**
 * サーバ側の `captureMethod` は `'file'` / `'manual'` も受け続ける
 * (既存の台帳行と DB の check 制約。**画面から送る値は `camera` だけ**になった)。
 *
 * 【登録済みでも「登録し直す」から撮り直せる (発注者指示 2026-10-21)】
 * 仕様 §8.3 は「再撮影を第一選択」だが、**画面に戻る口が無かった** — 一度登録すると
 * 登録済みの表示だけになり、撮り直すには台帳を手で直すしかなかった。
 * API は以前から撮り直しに対応している (`external-id-persist.ts` が旧行を `superseded` に
 * 落として入れ直す) ので、**足したのは UI だけ**。
  *
 * 【PC ではスマートフォンへの導線を出す (`/scan` と同じ流儀)】
 * カメラが `touch-only` なので、PC では撮影ボタンそのものが無い。そのまま何も出さないと
 * 「用紙は手元にあるのに撮れない」で行き止まりになるので、**同じ画面を開くための QR** を
 * `.pointer-only` で出す (`scan.astro:140-168` と同じ形・QR の生成は `src/lib/qr.ts`)。
 *   - **QR は固定パス `/kit` の公開 URL** を符号化する。`scan.astro` は現在の URL を
 *     そのまま入れているが、こちらは**クエリやパスの文脈を QR に持ち込まない**ため固定にした
 *     (`?u=` は 2026-09-29 に撤去済み・代理表示では撮影ブロックごと出ないが、
 *      URL を機械が読み取れる形にする以上、載せないものを明示的に決めておく)。
 *   - **uid は入れない。** スマホ側では改めてサインインしてもらう。
 *   - QR の SVG は**ページで 1 つだけ定義して `<use>` で参照する** (`kit.astro`)。
 *     出荷ごとにパスを展開すると 1 個 3.2KB × 最大 10 件になる (実測)。
 *
 * 【撮影ガイドは書面全体を示す。QR を対象にしない】
 * プリベントの同梱書面には QR も印字されているが、要るのは
 * **「ユーザーID」の印字と 1次元バーコード**。ここで QR を見せると
 * **ユーザーが QR を撮って「撮れた」と思い、読めない画像が集まり続ける** (仕様 §2.1)。
 *
 * 【`id="extid-<出荷ID>"` を持つ理由】
 * 7 日ワーニング (`ExternalIdReminder.astro`・仕様 §7.1) の「撮影して登録する」が
 * **このブロックへ直接飛ぶ**ため。出荷は最大 10 件並ぶので、ページ先頭へ送るだけでは
 * どれを撮ればよいか分からない。
 */
interface Props {
  shipmentId: string;
  provider: ExternalIdProvider;
  /** 既に登録済みなら末尾 4 桁のマスク (全文は出さない)。 */
  registeredMask?: string | null;
  /** 登録済みだが確認待ちか。 */
  needsReview?: boolean;
  /** PC 導線で見せる URL (スマホで開いてもらう先)。無ければ導線を出さない。 */
  shareUrl?: string | null;
  /** 同じページに 1 つだけ置いた QR の `<symbol>` の id。 */
  qrSymbolId?: string | null;
  /** その QR の viewBox の一辺。 */
  qrSize?: number | null;
}
const {
  shipmentId, provider, registeredMask = null, needsReview = false,
  shareUrl = null, qrSymbolId = null, qrSize = null,
} = Astro.props as Props;
/** 3 つ揃ってはじめて QR を出せる (欠けたら導線ごと出さない = 読めない QR を出さない)。 */
const canHandOff = !!shareUrl && !!qrSymbolId && !!qrSize;

/**
 * 撮影対象の案内。**どこを枠に入れるか**を具体的に書く。
 *
 * **プリベントは空（発注者指示 2026-10-22「以下の説明文を削除して」・仕様 §4.4.4）。**
 * 同じことを**図**（`ExternalIdSheetGuide`）が描いているので、文と図で二重に言っていた。
 * 図の側に「シールを貼る前に撮影」「ユーザーID ＋ バーコードの枠＝読み取り対象」
 * 「ここは読み取りません（QR・パスワード）」が入っているので、**案内は欠けない**。
 * 文が無い provider では `<ul>` そのものを描かない（空のリストを出さない）。
 */
const GUIDE: Record<ExternalIdProvider, string[]> = {
  prevent: [],
  demecal: [
    '「検査申し込み用紙（返送用）」の**全体**が入るように撮影してください。',
    '枠に入れるのは用紙の上部にある「**問合せ番号**」（15桁の数字）です。',
    '**QRコードは読み取りません。**',
  ],
};
const idLabel = PROVIDER_ID_LABEL[provider];
const idKind = PROVIDER_ID_KIND[provider];
---

<section
  id={`extid-${shipmentId}`}
  class="mt-3 rounded-xl border border-navy-400 bg-brand-50 p-4"
  data-extid-capture
  data-shipment-id={shipmentId}
  data-provider={provider}
  data-id-kind={idKind}
  data-id-label={idLabel}
>
  <h4 class="flex items-center gap-2 text-base font-semibold text-navy-800">
    <AppIcon name="kit" size={18} />検査キットの{idLabel}を登録
  </h4>

  {registeredMask && (
    <div class="mt-2" data-extid-done>
      <p class="text-base text-slate-800">
        <span class="status-pill status-ok"><AppIcon name="ok" size={14} />登録済み</span>
        <span class="ml-2 tnum">{registeredMask}</span>
        {needsReview && (
          <span class="mt-1 block text-sm text-slate-600">番号は事務局で確認します。</span>
        )}
      </p>

      {/*
        登録し直す (仕様 §8.3「再撮影を第一選択」)。
        **押しただけでは撮影の面を出さない** — 1 段挟んで、上書きになることを先に伝える。
      */}
      <div class="mt-2">
        <button type="button" class="btn-pair btn-graph min-h-touch" data-extid-redo-open>
          <AppIcon name="camera" size={18} />番号を登録し直す
        </button>
      </div>

      {/* 確認。**赤にしない** (誤りではなく、やり直せることなので `status-watch`)。 */}
      <div class="mt-2 hidden rounded-xl border p-3 status-watch" data-extid-redo-confirm role="status">
        <p class="text-base">
          現在 <span class="tnum font-semibold">{registeredMask}</span> が登録されています。
          撮り直して<strong>この番号を上書き</strong>しますか？
        </p>
        <p class="mt-1 text-sm">前の番号は記録として残り、事務局で確認できます。</p>
        <div class="mt-2 flex flex-wrap gap-2">
          <button type="button" class="btn-pair btn-data min-h-touch" data-extid-redo-yes>
            <AppIcon name="camera" size={18} />登録し直す
          </button>
          <button type="button" class="btn-pair btn-graph min-h-touch" data-extid-redo-no>
            <AppIcon name="close" size={18} />やめる
          </button>
        </div>
      </div>
    </div>
  )}

  {/*
    撮影〜登録の面。**登録済みでも markup は出しておき、`hidden` で隠すだけ**にする。
    「登録し直す」で開くときに、同じ画面を JS で組み立て直さないため
    (画面はサーバが出す・JS は見せ方だけ変える)。
  */}
  <div class={registeredMask ? 'hidden' : ''} data-extid-form>
      {GUIDE[provider].length > 0 && (
        <ul class="mt-2 list-disc space-y-1 pl-5 text-base text-slate-800">
          {GUIDE[provider].map((line) => (
            <li set:html={line.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')}></li>
          ))}
        </ul>
      )}

      {/* どの用紙のどこを読むかの図。**実物を見ていない provider では何も出ない**。 */}
      <ExternalIdSheetGuide provider={provider} />

      {/*
        撮影のボタンは**大きく・目立たせる** (発注者指示 2026-10-22・仕様 §4.4.4)。
        この面でやることは 1 つなので**面積**で優先度を出す。
        **色は `.btn-data` のまま** = brand 塗りにしない (塗りは画面に 1 つ
        = AI疾病予防報告書のタイル、という確定事項。この帯はダッシュボードでそれと並ぶ)。
        高さ・級数は `global.css` の `.btn-pair.btn-pair-lg` 1 か所が持つ。
      */}
      <div class="mt-3 flex flex-wrap gap-2">
        {/* スマホだけに出す。PC には出さない (CSS `.touch-only` = (pointer: coarse))。 */}
        <button
          type="button"
          class="touch-only btn-pair btn-pair-lg btn-data w-full"
          data-extid-camera-open
        >
          <AppIcon name="camera" size={22} />カメラで撮影
        </button>
      </div>

      {/*
        アプリ内カメラ。**開くのは上のボタンを押したときだけ** — ここが自動で開くと
        PC や、撮る気のない人の端末でカメラが起動する。
      */}
      <div class="mt-3 hidden" data-extid-camera>
        <div class="overflow-hidden rounded-xl border border-navy-400 bg-black">
          <video
            class="block h-auto w-full"
            playsinline
            muted
            autoplay
            data-extid-video
          ></video>
        </div>
        <canvas class="hidden" data-extid-canvas></canvas>
        <p class="mt-2 text-sm text-slate-600" data-extid-camera-status aria-live="polite"></p>
        <div class="mt-2 flex flex-wrap gap-2">
          {/* 大きく (§4.4.4)。隣の「閉じる」はそのまま = やめる側を目立たせない。 */}
          <button type="button" class="btn-pair btn-pair-lg btn-data flex-1" data-extid-shot>
            <AppIcon name="camera" size={22} />この位置で撮る
          </button>
          <button type="button" class="btn-pair btn-graph min-h-touch" data-extid-camera-close>
            <AppIcon name="close" size={18} />閉じる
          </button>
        </div>
      </div>

      {/* 進行・結果。**JS が無いと何も起きないので、その旨を出す。** */}
      <p class="mt-2 text-sm text-slate-600" data-extid-status aria-live="polite"></p>

      {/*
        読めなかった / 別の数字を読んだときの案内。
        **行き止まりにしない** — 候補が出ているときは消さず、横に注意として添える
        （`status-watch` = 注意。赤にしない）。**上の図をもう一度見てもらう**のが目的なので、
        図は 1 つだけにして「上の図」と指す（同じ図を 2 回描かない）。
      */}
      <div class="mt-2 hidden rounded-xl border p-3 status-watch" data-extid-wrong role="status">
        <p class="flex items-start gap-2 text-base font-semibold">
          <AppIcon name="watch" size={18} class="mt-1 shrink-0" /><span data-extid-wrong-title></span>
        </p>
        <p class="mt-1 text-sm" data-extid-wrong-body></p>
      </div>

      <div class="mt-3 hidden" data-extid-confirm>
        <p class="text-base text-slate-800">
          読み取った{idLabel}: <span class="tnum font-semibold" data-extid-candidate></span>
        </p>
        <p class="mt-1 text-sm text-slate-600" data-extid-note></p>
        <div class="mt-2 flex flex-wrap gap-2">
          <button type="button" class="btn-pair btn-data min-h-touch" data-extid-register>
            <AppIcon name="ok" size={18} />この番号で登録する
          </button>
          {/*
            **番号を直す口は置かない** (発注者指示 2026-10-21)。
            チェックディジットが無いので、手で直すと**正しい形の別の番号**になり得る。
            読み取りが違っていたら**撮り直す**。
          */}
          <button type="button" class="btn-pair btn-graph min-h-touch" data-extid-retake>
            <AppIcon name="camera" size={18} />撮り直す
          </button>
        </div>
      </div>

      {/*
        PC 向け: カメラが無いのでスマートフォンへ移ってもらう導線。
        `.pointer-only` = `(pointer: coarse)` で消える (カメラボタンの `touch-only` と対)。
        **入口は撮影だけ**になったので、**PC から登録する手段は無い**。
        ここはスマートフォンへ送るための唯一の導線。
      */}
      {canHandOff && (
        <div class="pointer-only mt-3 rounded-xl border border-slate-200 bg-white p-3.5 text-left">
          <p class="flex items-center gap-2 text-base font-semibold text-navy-800">
            <AppIcon name="camera" size={20} class="text-slate-600" />
            撮影はスマートフォンから
          </p>
          <p class="mt-1.5 text-sm text-slate-700">
            PC ではカメラを使えません。下の QR コードをスマートフォンで読み取って
            同じ画面を開き、用紙を撮影してください。
          </p>

          <div class="mt-3 flex flex-wrap items-center gap-5">
            {/* QR はサーバ側で生成した静的 SVG (外部サービスへ URL を送らない)。 */}
            <svg
              viewBox={`0 0 ${qrSize} ${qrSize}`}
              width="160"
              height="160"
              class="shrink-0 rounded-lg border border-slate-200 bg-white p-1"
              role="img"
              aria-label="検査キットの番号を登録する画面を開くための QR コード"
            >
              <use href={`#${qrSymbolId}`} />
            </svg>
            <p class="min-w-0 flex-1 text-sm text-slate-700">
              スマートフォンのカメラを向けると、この画面が開きます。<br />
              サインインを求められたら、PC と同じアカウントでサインインしてください。<br />
              読み取れない場合は下の URL をお使いください。
            </p>
          </div>

          <div class="mt-3 flex flex-wrap items-center gap-2">
            {/*
              **値はサーバ側で入れる** (JS が無くても読める)。
              `location.href` で上書きしない — QR と文字の URL が食い違うし、
              代理表示のパスを持ち込むことになる。
            */}
            <input
              type="text"
              readonly
              value={shareUrl}
              class="min-h-touch flex-1 rounded-xl border border-slate-300 bg-slate-50 px-3 text-sm text-slate-800"
              aria-label="この画面の URL"
              data-extid-share-url
            />
            <button type="button" class="btn-secondary !py-2 !text-sm" data-extid-share-copy>
              <AppIcon name="attachment" size={16} class="mr-1.5" />URL をコピー
            </button>
          </div>
          <p class="mt-1.5 text-sm text-slate-600" data-extid-share-msg aria-live="polite"></p>
        </div>
      )}
  </div>
</section>
