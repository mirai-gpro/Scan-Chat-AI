---
import AppIcon from '../AppIcon.astro';
import {
  PROVIDER_ID_KIND, type ExternalIdProvider,
} from '../../lib/external-test-id';

/**
 * 受取時・外部検査ID の撮影／登録ブロック。
 *
 * 正本: `docs/lab/kit_receipt_external_id_capture_spec.md` §4。
 *
 * 【カメラは `getUserMedia` を使わない】
 * `<input type="file" capture="environment">` にしてある。理由:
 *   - スマホではカメラが直接開き、**権限拒否時はそのままファイル選択に落ちる**
 *     (仕様 §4.4 の「カメラ権限拒否時は画像ファイル選択へフォールバック」が
 *      ブラウザ側の挙動として自動的に満たされる)。
 *   - PC には**カメラのボタンを出さない** (`touch-only` = CSS の `(pointer: coarse)`)。
 *     `CLAUDE.md`「画面に出ていないカメラが JS から起動する」事故を構造的に避ける。
 *
 * 【撮影ガイドは書面全体を示す。QR を対象にしない】
 * プリベントの同梱書面には QR も印字されているが、要るのは
 * **「ユーザーID」の印字と 1次元バーコード**。ここで QR を見せると
 * **ユーザーが QR を撮って「撮れた」と思い、読めない画像が集まり続ける** (仕様 §2.1)。
 */
interface Props {
  shipmentId: string;
  provider: ExternalIdProvider;
  /** 既に登録済みなら末尾 4 桁のマスク (全文は出さない)。 */
  registeredMask?: string | null;
  /** 登録済みだが確認待ちか。 */
  needsReview?: boolean;
}
const { shipmentId, provider, registeredMask = null, needsReview = false } = Astro.props as Props;

/** 先方の呼び方をそのまま使う (当社で言い換えない)。 */
const ID_LABEL: Record<ExternalIdProvider, string> = {
  prevent: 'バーコードNo.',
  demecal: '問合せ番号',
};
/** 撮影対象の案内。**どこを枠に入れるか**を具体的に書く。 */
const GUIDE: Record<ExternalIdProvider, string[]> = {
  prevent: [
    '同梱の IDシート**全体**が入るように撮影してください。',
    '枠に入れるのは「**ユーザーID**」の印字と、その近くの**横線のバーコード**です。',
    '**QRコード（四角い模様）は読み取りません。** 写っていてもかまいません。',
  ],
  demecal: [
    '「検査申し込み用紙（返送用）」の**全体**が入るように撮影してください。',
    '枠に入れるのは用紙の上部にある「**問合せ番号**」（15桁の数字）です。',
    '**QRコードは読み取りません。**',
  ],
};
const idLabel = ID_LABEL[provider];
const idKind = PROVIDER_ID_KIND[provider];
---

<section
  class="mt-3 rounded-xl border border-navy-400 bg-brand-50 p-4"
  data-extid-capture
  data-shipment-id={shipmentId}
  data-provider={provider}
  data-id-kind={idKind}
  data-id-label={idLabel}
>
  <h4 class="flex items-center gap-2 text-base font-semibold text-navy-800">
    <AppIcon name="kit" size={18} />検査キットの{idLabel}を登録
  </h4>

  {registeredMask ? (
    <p class="mt-2 text-base text-slate-800" data-extid-done>
      <span class="status-pill status-ok"><AppIcon name="ok" size={14} />登録済み</span>
      <span class="ml-2 tnum">{registeredMask}</span>
      {needsReview && (
        <span class="mt-1 block text-sm text-slate-600">番号は事務局で確認します。</span>
      )}
    </p>
  ) : (
    <>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-base text-slate-800">
        {GUIDE[provider].map((line) => (
          <li set:html={line.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')}></li>
        ))}
      </ul>

      <div class="mt-3 flex flex-wrap gap-2">
        {/* スマホだけに出す。PC には出さない (CSS `.touch-only` = (pointer: coarse))。 */}
        <label class="touch-only btn-pair btn-data min-h-touch cursor-pointer">
          <AppIcon name="camera" size={18} />カメラで撮影
          <input type="file" accept="image/*" capture="environment" class="hidden" data-extid-file="camera" />
        </label>
        <label class="btn-pair btn-graph min-h-touch cursor-pointer">
          <AppIcon name="upload" size={18} />写真を選ぶ
          <input type="file" accept="image/*" class="hidden" data-extid-file="file" />
        </label>
      </div>

      {/* 進行・結果・手入力。**JS が無いと何も起きないので、その旨を出す。** */}
      <p class="mt-2 text-sm text-slate-600" data-extid-status aria-live="polite"></p>

      <div class="mt-3 hidden" data-extid-confirm>
        <p class="text-base text-slate-800">
          読み取った{idLabel}: <span class="tnum font-semibold" data-extid-candidate></span>
        </p>
        <p class="mt-1 text-sm text-slate-600" data-extid-note></p>
        <div class="mt-2 flex flex-wrap gap-2">
          <button type="button" class="btn-pair btn-data min-h-touch" data-extid-register>
            <AppIcon name="ok" size={18} />この番号で登録する
          </button>
          <button type="button" class="btn-pair btn-graph min-h-touch" data-extid-retake>
            <AppIcon name="camera" size={18} />撮り直す
          </button>
          <button type="button" class="btn-pair btn-graph min-h-touch" data-extid-edit>
            <AppIcon name="tool" size={18} />番号を修正する
          </button>
        </div>
      </div>

      {/* 読み取れなかったとき・修正したいときの逃げ道。**行き止まりにしない** (仕様 §5.1)。 */}
      <div class="mt-3 hidden" data-extid-manual>
        <label class="block text-base text-slate-800">
          {idLabel}を入力
          <input
            type="text"
            inputmode="numeric"
            autocomplete="off"
            class="mt-1 block w-full rounded-xl border border-navy-400 px-3 py-2 text-base tnum"
            data-extid-input
            placeholder="数字のみ"
          />
        </label>
        <button type="button" class="mt-2 btn-pair btn-data min-h-touch" data-extid-register-manual>
          <AppIcon name="ok" size={18} />この番号で登録する
        </button>
      </div>
    </>
  )}
</section>
