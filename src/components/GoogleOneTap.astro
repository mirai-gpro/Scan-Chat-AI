---
/**
 * Google One Tap (GSI client) + Supabase Auth 統合。
 *
 * JavaScript API 方式 (g_id_onload は使わない) で初期化する。
 * HTML data-callback 方式だと、GSI client 初期化時に
 * `window[data-callback]` が未定義 → "callback is not a function"
 * エラーで config が捨てられる race condition があるため。
 *
 * 動作:
 *   1. Google GSI client を非同期ロード (<script is:inline async>)
 *   2. bundled module: handleCredentialResponse() を定義
 *   3. google.accounts.id が ready になったら initialize() で
 *      function 参照を直接渡し、prompt() で One Tap 起動
 *   4. 認証成功 → signInWithIdToken → ?u=<uid> に redirect
 *
 * 【表示との分界】この部品は **Google の認証処理だけ**を持ち、画面は SignInPanel.astro。
 *   メール＋パスワードは `EmailPasswordAuth.astro` が同じ流儀で担当する
 *   (合流点は双方とも `POST /api/auth/resolve`・2026-10-05)。
 *   One Tap は iOS Safari の ITP や Google 未サインインの環境では**出ない**ので、
 *   `#gsi-button` があれば Google 公式ボタンをそこに描画し、進捗と失敗を
 *   `welltect:signin` イベントで SignInPanel に渡す (契約は SignInPanel 側に記載)。
 *
 * iOS Safari / ITP ブラウザ対応: itp_support: true
 *
 * 環境変数: PUBLIC_GOOGLE_CLIENT_ID
 *   未設定なら何もレンダリングしない (フォールバック: ?u= 直渡し)
 */
import { resolveViewer } from '../lib/viewer';
import { readAdminCred } from '../lib/admin-identity';

const clientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ?? '';
const enabled = !!clientId;

/**
 * **Cookie の自己修復**（2026-08-30）。
 *
 * Cookie は**サインイン時にしか発行されない**（下の One Tap は
 * サインインパネルが在るとき＝未サインインのときだけ `prompt()` する）。
 * 有効期間は 30 日あるので、**判定の内容を変えても既存 Cookie を持っている人には
 * 最大 30 日届かない**。実測 2026-08-30: email 由来の admin 判定を本番へ入れても
 * 報告書が空のままだった — **修正が本番に在るのに効かない**という最悪の形。
 * → 旧形式の Cookie を見つけたら、**その場で `/api/auth/resolve` を呼び直す**。
 */
const viewer = enabled ? await resolveViewer(Astro) : null;
/**
 * **タブごとに 1 回、admin フラグを取り直す。**
 *
 * 旧形式 Cookie だけを対象にしていたのは誤りだった —
 * **`admin=0` で発行された新形式 Cookie も 30 日そのまま**なので、
 * 判定を直しても届かない (実測 2026-08-30)。サインイン済みなら常に印を出す。
 * 実際に呼ぶかは `sessionStorage` が番をするので、タブあたり 1 回で済む。
 */
/*
 * **`welltect_admin_v` を持つ人も対象に入れる（2026-09-30）。**
 *
 * uid を持たない admin は **`welltect_v` が無い**ので `selfUid` も `cookieStale` も
 * 立たず、**この口を一度も叩かない**＝ **admin_users から外しても credential が
 * 30 日残る**（権限剥奪が効かない）。代理表示中も同じ理由で叩かせる。
 */
const hasAdminCred = enabled ? !!(await readAdminCred(Astro)) : false;
const needsCookieRefresh = !!viewer?.selfUid || !!viewer?.cookieStale || hasAdminCred;

/**
 * **番人の鍵にデプロイの版を混ぜる (2026-08-30・実測)。**
 *
 * `sessionStorage` は**リロードでは消えない**。固定の鍵で番をすると、
 * **一度試したタブでは判定を直して再デプロイしても二度と取り直されない**。
 * 実際にこれで「本番に修正が入っているのに、再読込しても admin に戻らない」
 * 状態になった (タブを開き直すまで直らない)。
 * → 鍵にビルドの SHA を混ぜ、**デプロイのたびに 1 回だけ再試行**する。
 *   同じ版の中ではタブあたり 1 回のままなので、通常の負荷は変わらない。
 */
const buildSha = (
  (import.meta.env as Record<string, string | undefined>).VERCEL_GIT_COMMIT_SHA
  ?? (typeof process !== 'undefined' ? process.env?.VERCEL_GIT_COMMIT_SHA : '')
  ?? ''
).slice(0, 7) || 'local';
---

{enabled && (
  <>
    {/* Google Identity Services client (async load) */}
    <script is:inline async defer src="https://accounts.google.com/gsi/client"></script>

    {/*
      **admin フラグを取り直す必要がある人**への印 (旧形式 Cookie / まだ admin でない)。
      **1 回だけ**試す (sessionStorage で番をする) — 失敗したときに再読込を繰り返さない。
    */}
    {needsCookieRefresh && <span id="viewer-cookie-stale" hidden data-stale="1" data-build={buildSha}></span>}

    <script>
      import { createClient } from '@supabase/supabase-js';

      const supabaseUrl  = import.meta.env.PUBLIC_SUPABASE_URL as string;
      const supabaseAnon = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string;

      /**
       * **Cookie の自己修復。** admin フラグを取り直す必要があるとき
       * (旧形式 Cookie / まだ admin でない) に、手元の Supabase セッションで
       * `/api/auth/refresh-admin` を呼んで発行し直す。
       * **サインインし直さなくても、管理者リストへの登録がその場で届く。**
       *
       * **1 回だけ**試す。失敗しても画面は壊さない (今までどおり表示されるだけ)。
       */
      async function refreshViewerCookie(): Promise<void> {
        const mark = document.getElementById('viewer-cookie-stale');
        if (!mark) return;
        // 鍵にビルドの版を混ぜる (固定の鍵だとタブを開き直すまで再試行されない)。
        const KEY = `welltect.cookie.refreshed.${mark.dataset.build ?? 'x'}`;
        try { if (sessionStorage.getItem(KEY)) return; sessionStorage.setItem(KEY, '1'); } catch { /* 使えなくても進む */ }
        try {
          const sb = createClient(supabaseUrl, supabaseAnon);
          const { data } = await sb.auth.getSession();
          const accessToken = data.session?.access_token;
          if (!accessToken) return;                      // セッションが無いなら何もしない
          // admin フラグだけを入れ直す軽い口。Cookie が無ければ本来の resolve へ。
          const res = await fetch('/api/auth/refresh-admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ accessToken }),
          });
          // **200 + linked:false**（uid を持たない admin）はここへ来ない — 401 だけが本解決へ。
          if (res.status === 401) {                      // Cookie が無い/切れている → 本解決
            const r2 = await fetch('/api/auth/resolve', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ accessToken }),
            });
            if (r2.ok) location.reload();
            return;
          }
          if (!res.ok) return;
          const payload = await res.json().catch(() => ({} as { changed?: boolean }));
          // **変わったときだけ**描き直す (毎回リロードしない)。
          if (payload && (payload as { changed?: boolean }).changed) location.reload();
        } catch { /* 失敗しても従来どおり */ }
      }
      void refreshViewerCookie();
      const clientId     = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID as string;

      type GsiCredentialResponse = { credential: string };
      type GsiId = {
        initialize: (cfg: Record<string, unknown>) => void;
        renderButton: (el: HTMLElement, cfg: Record<string, unknown>) => void;
        prompt: (cb?: (n: unknown) => void) => void;
        cancel: () => void;
      };

      /** SignInPanel へ通知する。パネルが無いページでは alert にフォールバックする。 */
      function notify(detail: { state?: string; text?: string; tone?: string }) {
        const hasPanel = !!document.getElementById('signin-status');
        if (hasPanel) {
          document.dispatchEvent(new CustomEvent('welltect:signin', { detail }));
          return;
        }
        if (detail.text && detail.tone === 'error') alert(detail.text);
      }

      async function handleCredentialResponse(response: GsiCredentialResponse) {
        console.log('[OneTap] callback fired, credential length:', response.credential?.length ?? 0);
        try {
          if (!supabaseUrl || !supabaseAnon) {
            console.error('[OneTap] PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY が未設定');
            notify({ text: 'Supabase 環境変数が未設定です', tone: 'error' });
            return;
          }
          const sb = createClient(supabaseUrl, supabaseAnon);

          notify({ text: '確認しています…', tone: 'info' });
          console.log('[OneTap] calling signInWithIdToken…');
          const { data, error } = await sb.auth.signInWithIdToken({
            provider: 'google',
            token: response.credential,
          });
          if (error) {
            console.error('[OneTap] Supabase auth error:', error);
            notify({ text: `認証エラー: ${error.message}`, tone: 'error' });
            return;
          }
          const accessToken = data.session?.access_token;
          console.log('[OneTap] signInWithIdToken OK, uid:', data.user?.id, 'hasToken:', !!accessToken);
          if (!accessToken) {
            notify({ text: 'サインインセッションの取得に失敗しました', tone: 'error' });
            return;
          }

          const url = new URL(window.location.href);
          if (url.pathname === '/' || url.pathname === '') url.pathname = '/dashboard';

          // サーバー側で本人解決 (本番: resolve-customer / dev: customer モック email 解決)。
          // email/sub はサーバーがアクセストークンから検証するため、ここでは送らない。
          console.log('[OneTap] resolving customer server-side…');
          const res = await fetch('/api/auth/resolve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ accessToken }),
          });
          const payload = await res.json().catch(() => ({}));
          if (!res.ok) {
            console.error('[OneTap] resolve error:', payload);
            notify({ text: `連携処理エラー: ${payload.error ?? `HTTP ${res.status}`}`, tone: 'error' });
            return;
          }
          /*
           * **uid を持たない admin を handoff の続きで行き止まりにしない** (2026-09-30)。
           *
           * `admin_users` に居るが Scan-Chat-AI 側の `diagnostic_user_id` を持たない人が居る。
           * その人は `resolve` が `{ linked:false }` を返すので、従来はここで
           * 「お客様情報が見つかりませんでした」と出て**止まっていた**。
           * ところが `resolve` は**その前に `welltect_admin_v` を発行している**ので、
           * **代理表示の続き (`/admin/handoff/...`) は成立する**。
           *
           * **`/admin/handoff/` の下でだけ**進める。ダッシュボード等でこれをやると
           * 「サインインできたのに何も出ない」画面へ送ることになる (uid が無いので当然)。
           */
          if (!payload.linked && payload.admin === true && url.pathname.startsWith('/admin/handoff/')) {
            console.log('[OneTap] admin (uid 無し) → handoff の続きへ');
            window.location.replace(url.toString());
            return;
          }
          if (!payload.linked || !payload.diagnosticUserId) {
            console.warn('[OneTap] not linked');
            notify({
              text: 'お客様情報が見つかりませんでした。検査のお申し込み状況をご確認のうえ、サポートまでご連絡ください。',
              tone: 'error',
            });
            return;
          }

          /*
           * **`?u=` は付けない** (2026-09-29)。
           *
           * 以前はここで `url.searchParams.set('u', payload.diagnosticUserId)` してから
           * リダイレクトしていた。**これが一般ユーザーの URL に diagnostic_user_id が
           * 出る唯一の起点**だった。入場は既に上の `/api/auth/resolve` が発行した
           * HttpOnly Cookie が担っているので、`?u=` なしで遷移すれば
           * 次のリクエストで `resolveViewer` が Cookie から本人を解決する。
           *
           * **リダイレクト自体と、`resolve` 成功後に行うという順序は変えない** —
           * `:176-177` の `/` → `/dashboard` の差し替えと、Cookie 発行前に
           * 遷移しないことの両方が要る。
           */
          console.log('[OneTap] linked → redirect:', url.toString());
          window.location.replace(url.toString());
        } catch (err) {
          console.error('[OneTap] callback exception:', err);
          notify({ text: `サインイン処理エラー: ${err instanceof Error ? err.message : String(err)}`, tone: 'error' });
        }
      }

      /** GSI client が ready になるまで待つ */
      function whenGsiReady(cb: (gsi: GsiId) => void, attempts = 50): void {
        const gsi = (window as unknown as { google?: { accounts?: { id?: GsiId } } }).google?.accounts?.id;
        if (gsi) { cb(gsi); return; }
        if (attempts <= 0) {
          // ここに来る = GSI を読み込めなかった。放置するとスピナーのまま
          // 行き止まりになるので、画面側に再読み込み導線を出させる。
          console.warn('[OneTap] GSI client not available');
          notify({ state: 'unavailable' });
          return;
        }
        setTimeout(() => whenGsiReady(cb, attempts - 1), 100);
      }

      console.log('[OneTap] module loaded, clientId:', clientId ? `${clientId.slice(0, 10)}…` : '(missing)');

      whenGsiReady((gsi) => {
        console.log('[OneTap] GSI ready, initializing…');
        gsi.initialize({
          client_id: clientId,
          callback: handleCredentialResponse,
          auto_select: false,
          cancel_on_tap_outside: false,
          itp_support: true,
          context: 'signin',
        });

        // One Tap が出ない環境 (iOS Safari の ITP・Google 未サインイン等) の受け皿。
        // 器がある画面でだけ、Google 公式ボタンを描画する。
        const slot = document.getElementById('gsi-button');
        if (slot) {
          gsi.renderButton(slot, {
            type: 'standard',
            theme: 'outline',
            size: 'large',
            shape: 'pill',
            text: 'signin_with',
            locale: 'ja',
          });
        }
        notify({ state: 'ready' });

        /*
         * 自動プロンプトを出すのは **サインインが必要な画面のときだけ**。
         *
         * 以前は「`?u=` があればスキップ」だったが、2026-08-30 に入場を Cookie へ移したので
         * `?u=` の有無は本人かどうかを表さない。Cookie が切れた状態でブックマークの
         * `?u=` 付き URL を開くと、プロンプトが出ないまま止まってしまう。
         * → サインインパネル (`#gsi-button`) が描かれているかで判定する。
         */
        if (!slot) {
          console.log('[OneTap] signed in (no sign-in panel), skip prompt');
          return;
        }

        console.log('[OneTap] calling prompt()');
        gsi.prompt((notification: unknown) => {
          console.log('[OneTap] prompt notification:', notification);
        });
      });
    </script>
  </>
)}
