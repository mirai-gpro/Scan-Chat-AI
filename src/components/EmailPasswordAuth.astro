---
/**
 * メールアドレス＋パスワード認証 (Supabase Auth)。
 *
 * 【位置づけ】`GoogleOneTap.astro` と**同じ流儀**の「処理だけ」の部品。
 *   markup は持たず、`SignInPanel.astro` が描いた器に対して動き、
 *   進捗と失敗は `welltect:signin` イベントで表示側へ渡す。
 *   器が無いページでは**何もしない** (BaseLayout に置いてあるが no-op)。
 *
 * 【独自認証を作らない】既存 HP／EC (`wellfort-site/src/components/LoginModal.astro`) と
 *   同じ Supabase Auth の口だけを使う:
 *     ログイン   … `sb.auth.signInWithPassword({ email, password })`
 *     新規登録   … `sb.auth.signUp({ email, password, options:{ emailRedirectTo } })`
 *   **`updateUser({ password })` は実装しない** (発注者指示 2026-10-05 §4)。
 *   Google 認証済みのアカウントへ後からパスワードを足す独自処理は作らない。
 *
 * 【合流点は 1 つ】認証に成功したら Google とまったく同じ経路へ入る:
 *   `access_token` → `POST /api/auth/resolve` → サーバが `getUser()` で本人検証
 *   → 通常顧客 / staging / special / demo の既存解決 → `welltect_v` Cookie。
 *   **メール認証専用の本人解決 API は作らない** (§7)。
 *
 * 【User Enumeration 対策】(§5)
 *   未認証の人に**既存アカウントの有無や認証方式を悟らせない**。
 *   - `signUp` の結果は、セッションが返らなければ**常に同じ文言**
 *     (Confirm Email ON の新規・既存アドレスの obfuscated response を区別しない)
 *   - Supabase の `error.message` を画面へ出さない (`already registered` 等が漏れるため)
 *   - wellfort-site の「このメールアドレスは既に登録済みです」は**意図的に移植しない**
 *
 * 【HP／EC とアカウントは共有されない】HP/EC と本アプリは**別の Supabase プロジェクト**
 *   なので、HP で設定したパスワードでは入れない。本アプリで新規登録してもらう (§1)。
 */
---

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl  = import.meta.env.PUBLIC_SUPABASE_URL as string;
  const supabaseAnon = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string;

  /** 新規登録の確認メールから戻る先。Supabase の Redirect URLs に許可が要る。 */
  const SIGNUP_REDIRECT = '/dashboard';

  /**
   * **セッションが返らなかったときの唯一の文言。**
   * 新規かどうか・別の方式で登録済みかどうかを**区別しない** (§5 / §6)。
   */
  const SIGNUP_SENT =
    '確認メールを送信しました。メールが届かない場合は、以前利用したログイン方法もお試しください。';

  /** SignInPanel へ通知する。パネルが無いページでは何もしない。 */
  function notify(detail: { state?: string; text?: string; tone?: string }) {
    if (!document.getElementById('signin-status')) return;
    document.dispatchEvent(new CustomEvent('welltect:signin', { detail }));
  }

  function busy(el: HTMLButtonElement | null, on: boolean, label: string) {
    if (!el) return;
    el.disabled = on;
    el.textContent = on ? '処理中…' : label;
  }

  /**
   * **Google と同じ合流点。** 取れたセッションの `access_token` を
   * `/api/auth/resolve` へ渡し、返ってきた判断で遷移する。
   * **ここでの分岐は `GoogleOneTap.astro` と同じ**にしてある (admin の handoff を含む)。
   */
  async function resolveAndGo(accessToken: string): Promise<void> {
    const url = new URL(window.location.href);
    if (url.pathname === '/' || url.pathname === '') url.pathname = '/dashboard';

    const res = await fetch('/api/auth/resolve', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ accessToken }),
    });
    const payload = await res.json().catch(() => ({} as Record<string, unknown>));
    if (!res.ok) {
      /*
       * **409 はサーバが用意した文言をそのまま出す** (認証方式の競合)。
       * この応答は**本人確認済みのセッション**にしか返らないので、
       * 第三者に既存アカウントの存在を教えることにはならない。
       */
      notify({ text: String((payload as { error?: string }).error ?? `サインインできませんでした (HTTP ${res.status})`), tone: 'error' });
      return;
    }
    const linked = (payload as { linked?: boolean }).linked;
    const admin = (payload as { admin?: boolean }).admin;
    const uid = (payload as { diagnosticUserId?: string }).diagnosticUserId;
    // uid を持たない admin は handoff の続きだけ通す (GoogleOneTap と同条件)。
    if (!linked && admin === true && url.pathname.startsWith('/admin/handoff/')) {
      window.location.replace(url.toString());
      return;
    }
    if (!linked || !uid) {
      notify({
        text: 'お客様情報が見つかりませんでした。検査のお申し込み状況をご確認のうえ、サポートまでご連絡ください。',
        tone: 'error',
      });
      return;
    }
    // `?u=` は付けない (入場は resolve が発行した HttpOnly Cookie が担う)。
    window.location.replace(url.toString());
  }

  function client() {
    if (!supabaseUrl || !supabaseAnon) {
      notify({ text: 'サインイン機能を初期化できませんでした。時間をおいてお試しください。', tone: 'error' });
      return null;
    }
    return createClient(supabaseUrl, supabaseAnon);
  }

  const loginForm  = document.getElementById('signin-email-login-form') as HTMLFormElement | null;
  const signupForm = document.getElementById('signin-email-signup-form') as HTMLFormElement | null;
  if (loginForm || signupForm) {
    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('signin-login-submit') as HTMLButtonElement | null;
      const email = (document.getElementById('signin-login-email') as HTMLInputElement | null)?.value.trim() ?? '';
      const password = (document.getElementById('signin-login-password') as HTMLInputElement | null)?.value ?? '';
      if (!email || !password) return;
      const sb = client();
      if (!sb) return;
      busy(btn, true, 'サインイン');
      notify({ text: '確認しています…', tone: 'info' });
      try {
        const { data, error } = await sb.auth.signInWithPassword({ email, password });
        if (error || !data.session?.access_token) {
          /*
           * Supabase は「登録が無い」と「パスワードが違う」を区別せず
           * `Invalid login credentials` を返す。**こちらでも区別しない。**
           */
          console.error('[EmailAuth] signInWithPassword error:', error);
          notify({ text: 'メールアドレスまたはパスワードが正しくありません。', tone: 'error' });
          return;
        }
        await resolveAndGo(data.session.access_token);
      } catch (err) {
        console.error('[EmailAuth] signIn exception:', err);
        notify({ text: 'サインインできませんでした。時間をおいてお試しください。', tone: 'error' });
      } finally {
        busy(btn, false, 'サインイン');
      }
    });

    signupForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('signin-signup-submit') as HTMLButtonElement | null;
      const email = (document.getElementById('signin-signup-email') as HTMLInputElement | null)?.value.trim() ?? '';
      const password = (document.getElementById('signin-signup-password') as HTMLInputElement | null)?.value ?? '';
      if (!email || !password) return;
      if (password.length < 8) {
        notify({ text: 'パスワードは8文字以上で設定してください。', tone: 'error' });
        return;
      }
      const sb = client();
      if (!sb) return;
      busy(btn, true, '新規登録');
      notify({ text: '登録しています…', tone: 'info' });
      try {
        const { data, error } = await sb.auth.signUp({
          email,
          password,
          options: { emailRedirectTo: `${location.origin}${SIGNUP_REDIRECT}` },
        });
        if (error) {
          /*
           * **`error.message` を画面に出さない。** `already registered` 等が
           * 既存アカウントの存在を教えてしまう (§5)。詳細は console だけ。
           */
          console.error('[EmailAuth] signUp error:', error);
          notify({ text: '登録を受け付けられませんでした。時間をおいてお試しください。', tone: 'error' });
          return;
        }
        /*
         * **セッションが返らない = 確認メール経路、または既存アドレスの
         * obfuscated response。どちらも同じ文言**にする (区別させない)。
         */
        if (!data.session?.access_token) {
          notify({ text: SIGNUP_SENT, tone: 'info' });
          return;
        }
        // Confirm Email が OFF の設定では、ここで即セッションが返る。
        await resolveAndGo(data.session.access_token);
      } catch (err) {
        console.error('[EmailAuth] signUp exception:', err);
        notify({ text: '登録を受け付けられませんでした。時間をおいてお試しください。', tone: 'error' });
      } finally {
        busy(btn, false, '新規登録');
      }
    });
  }
</script>
