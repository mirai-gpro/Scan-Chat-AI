---
import BackToDashboard from '../components/BackToDashboard.astro';
import AppNav from '../components/AppNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import MetricTrendChart from '../components/dashboard/MetricTrendChart.astro';
import TrendItemsDialog from '../components/dashboard/TrendItemsDialog.astro';
import { loadDashboard, testTypeLabel } from '../lib/dashboard-queries';
import { getMeasurementTrend, getTrendCandidates, DEFAULT_TREND_ITEMS } from '../lib/measurement-queries';
import { countUnreadImportant } from '../lib/notice-queries';
import { refreshConfig, cfg } from '../lib/app-config';
import { resolveViewer } from '../lib/viewer';
import { noStore } from '../lib/http-cache';

/**
 * 検査値の推移 (グラフ)。ダッシュボードの検査カードにある「グラフ」の遷移先。
 *
 * v1.0 でダッシュボードから推移グラフを外し、検査種別ごとにこのページで見せる形にした
 * (発注者指示 2026-08)。`?type=` が無ければ全種別をまとめて出す。
 *
 * 【表示項目の設定】候補は**実データ由来** (`getTrendCandidates`) で、
 * 「この方の検査値に実在し、線が引ける項目」だけ。20 項目のマスタはこちらで作らない
 * (選定基準が未確定・ミッション④)。
 * サーバは**候補を全部描き**、クライアントが選択に応じて出し分ける (リロードしない)。
 * 既定は `DEFAULT_TREND_ITEMS` のうち実在するもの (従来の表示と同じ) を上限 8 件まで。
 */
export const prerender = false;

// Cookie で個人化される SSR ページ: 共有キャッシュに保存させない
noStore(Astro.response);

/** 同時に表示できる項目数の上限 (モックの既定 8 件に合わせる)。 */
const MAX_ITEMS = 8;

const url = new URL(Astro.request.url);
// 入場は Cookie で本人を判定する (`src/lib/viewer.ts`)。`?u=` は admin の代理表示のみ。
const viewer = await resolveViewer(Astro);
/**
 * デモ表示の可否は**閲覧している本人が admin か**で決まる (spec §4.6)。
 * **代理表示中 (`?u=` で他人を見ている) は渡さない** — 相手の実データを見せるため。
 */
const u = viewer.uid;
const type = url.searchParams.get('type');

const authEnabled = !!import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
const needsSignIn = authEnabled && !u;

/*
 * **app_config はデータ取得より前に読み込む。**
 * デモ用アカウントの一覧 (`demo.account_uids`) をここから引くため、
 * 後ろに置くと初回リクエストで admin の登録が効かない (コード既定に落ちる)。
 */
await refreshConfig();
const result = needsSignIn ? null : await loadDashboard(u, viewer.origin);
const hasError = result ? 'error' in result : false;
const data = !result || hasError ? null : (result as Exclude<typeof result, { error: string }>);

const candidates = data ? await getTrendCandidates(data.resultUid, type ?? undefined) : [];

// 既定の選択: 従来出していた項目のうち実在するもの → 足りなければ候補の先頭から補う。
const preferred = candidates.filter((n) => (DEFAULT_TREND_ITEMS as readonly string[]).includes(n));
const defaults = (preferred.length > 0 ? preferred : candidates).slice(0, MAX_ITEMS);

// カードは候補を全部描く (出し分けはクライアント)。候補が無ければ従来どおり既定で引く。
const series = data
  ? await getMeasurementTrend(
      data.resultUid,
      candidates.length > 0 ? candidates : undefined,
      12,
      type ?? undefined,
    )
  : [];

const unreadNotices = data ? await countUnreadImportant(data.diagnosticUserId) : 0;
const supportContact = cfg('ui.support_contact');

const typeName = type ? testTypeLabel(type).name : null;
---

<BaseLayout title="検査値の推移 | Welltect" width="app">
  <AppNav u={u} current="/dashboard" unreadNotices={unreadNotices} supportContact={supportContact} />

  <header class="hero-gradient px-5 py-4">
    <BackToDashboard u={u} />
    <div class="mt-1 flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-2xl font-bold tracking-tight text-navy-800">
        検査値の推移{typeName && <span class="ml-2 text-lg font-medium text-slate-700">{typeName}</span>}
      </h1>
      {candidates.length > 0 && (
        <TrendItemsDialog
          candidates={candidates}
          defaults={defaults}
          scope={type ?? 'all'}
          max={MAX_ITEMS}
        />
      )}
    </div>
  </header>

  <main class="flex flex-1 flex-col gap-5 px-5 pb-12 pt-5">
    {needsSignIn ? (
      <p class="card text-base text-slate-700">ダッシュボードからお進みください。</p>
    ) : series.length === 0 ? (
      <p class="card text-base text-slate-700">
        この検査の推移グラフはまだありません。
        <span class="mt-2 block text-sm text-slate-600">
          推移は 2 回目の検査から表示されます。
        </span>
      </p>
    ) : (
      <>
        {/* 全部外したときの行き止まり防止。既定では隠しておき、0 件になったら出す。 */}
        <p id="trend-empty-selection" hidden class="card text-base text-slate-700">
          表示する項目が選ばれていません。右上の「表示項目の設定」から選んでください。
        </p>
        <MetricTrendChart series={series} title={typeName ? `${typeName}の推移` : '検査値の推移'} />
      </>
    )}
  </main>
</BaseLayout>
