---
import AppIcon from '../components/AppIcon.astro';
import BackToDashboard from '../components/BackToDashboard.astro';
/**
 * AI ヘルスコーチ ページ。
 *
 * 表示デザイン・説明・機能は AI 問診 (chat.astro) と統一:
 *   - hero-gradient ヘッダー (戻る / オンライン pill / リセット)
 *   - モード切替:  音声 / ⌨ テキスト
 *   - 開始 hero (大きな mic-fab)
 *   - 開始後: チャットログ + 回答パネル (中断 / 音声 ON/OFF)
 *   - 「話す / タップ どちらでも OK」 dual-mode 案内
 *
 * 機能:
 *   - 音声入力: Web Speech API (SpeechRecognition, ja-JP)
 *   - 音声出力: Web Speech API (SpeechSynthesis, 日本語 voice)
 *   - テキスト入力: textarea
 *   - 履歴: localStorage に直近 30 件保持、リセットで全消去
 *
 * Server-side で AI 診断 context を読み込み、Gemini に 3 ルール system prompt
 * で問い合わせ (POST /api/coach/ask)。
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { buildCoachContext } from '../lib/coach-context';
import { resolveViewer, viewerLinkQuery } from '../lib/viewer';
import { noStore } from '../lib/http-cache';

export const prerender = false;

// Cookie で個人化される SSR ページ: 共有キャッシュに保存させない
noStore(Astro.response);

const url = new URL(Astro.request.url);
// 入場は Cookie で本人を判定する (`src/lib/viewer.ts`)。`?u=` は admin の代理表示のみ。
const viewer = await resolveViewer(Astro);
const diagnosticUserId = viewer.uid;
/** リンクに引き継ぐクエリ ('' か '?u=<uid>')。一般ユーザーは '' = URL に uid を出さない。 */
const linkQuery = viewerLinkQuery(viewer);

const ctx = diagnosticUserId ? await buildCoachContext(diagnosticUserId).catch(() => null) : null;
const hasContext = !!ctx;
const displayName = ctx?.displayName ?? 'お客様';
const sectionCount = ctx?.sections.length ?? 0;
const urgentAlert = ctx?.urgentAlert ?? null;

// 開始ボタン押下時に AI が最初に喋る挨拶文 (会話履歴が空の時のみ)。
// 緊急アラートがあれば追記。
const initialGreeting = urgentAlert
  ? `${displayName}、こんにちは AI ヘルスコーチです。最新の AI疾病予防報告書を読み込みました。検査結果に「${urgentAlert.title}」の留意事項がございますので、もし気になることがあればお尋ねください。健康に関するご質問は何でもお気軽にどうぞ。`
  : `${displayName}、こんにちは AI ヘルスコーチです。最新の AI疾病予防報告書を読み込みました。健康に関するご質問は何でもお気軽にお尋ねください。`;
---

<BaseLayout title="AI ヘルスコーチ | Welltect" width="flow">
  <header class="hero-gradient relative px-5 pt-5 pb-3">
    <div class="flex items-center justify-between">
      <BackToDashboard linkQuery={linkQuery} class="!px-2.5 !text-sm" />
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <h1 class="text-base font-semibold">AI ヘルスコーチ</h1>
      </div>
      <button
        id="reset-btn"
        type="button"
        class="text-xs text-slate-500 hover:text-slate-800"
      >リセット</button>
    </div>

    {hasContext && (
      <p class="mt-2 text-xs text-slate-600">
        {displayName} の AI疾病予防報告書 (Elith {sectionCount} セクション) を参照中
      </p>
    )}
  </header>

  {!diagnosticUserId && (
    <main class="flex flex-1 flex-col items-center justify-center gap-3 px-5 text-center">
      <AppIcon name="lock" size={32} class="text-slate-500" />
      <h2 class="text-base font-semibold">ユーザー指定が必要です</h2>
      <p class="text-xs text-slate-500">ダッシュボードから AI ヘルスコーチを開いてください。</p>
      <a href="/dashboard" class="btn-primary mt-2">ダッシュボードへ</a>
    </main>
  )}

  {diagnosticUserId && !hasContext && (
    <main class="flex flex-1 flex-col items-center justify-center gap-3 px-5 text-center">
      <AppIcon name="result" size={32} class="text-slate-500" />
      <h2 class="text-base font-semibold">AI疾病予防報告書が見つかりません</h2>
      <p class="text-xs text-slate-500">検査結果が表示されているかダッシュボードでご確認ください。</p>
      <a
        href={`/dashboard${linkQuery}`}
        class="btn-primary mt-2"
      >ダッシュボードへ</a>
    </main>
  )}

  {hasContext && (
    <>
      <div class="flex items-center justify-between px-5 pt-2 pb-1">
        <div class="inline-flex rounded-full bg-slate-100 p-1" role="tablist" id="mode-toggle">
          <button type="button" data-mode="voice" class="mode-pill on" role="tab" aria-selected="true">
            <AppIcon name="mic" size={20} /> 音声
          </button>
          <button type="button" data-mode="text" class="mode-pill" role="tab" aria-selected="false">
            ⌨ テキスト
          </button>
        </div>
        <span id="coach-status" class="text-xs text-slate-500">待機中</span>
      </div>

      {urgentAlert && (
        <div class="mx-5 mt-1 rounded-xl border border-red-300 bg-red-50 px-3 py-2 text-xs text-red-900">
          <strong><AppIcon name="record" size={20} /> 緊急留意事項:</strong> {urgentAlert.title}
        </div>
      )}

      <main
        id="coach-main"
        class="flex flex-1 flex-col gap-3 px-5 pt-3 pb-4"
        data-diagnostic-user-id={diagnosticUserId}
        data-initial-greeting={initialGreeting}
      >
        <div
          id="coach-log"
          class="card flex-1 space-y-3 overflow-y-auto"
          style="min-height: 22vh; max-height: 45vh;"
          aria-live="polite"
          aria-atomic="false"
        >
          <div id="coach-empty" class="flex h-full flex-col items-center justify-center gap-2 py-6 text-center text-slate-400">
            <AppIcon name="interview" size={32} class="text-slate-500" />
            <p class="text-xs">下の <span class="font-medium text-brand-600"><AppIcon name="interview" size={20} /> 相談を開始</span> から始めてください</p>
          </div>
        </div>

        <section
          id="answer-panel"
          class="card border-brand-200"
        >
          <!-- ━━━ START HERO（未開始時のみ表示） ━━━ -->
          <div id="start-hero" class="flex flex-col items-center gap-3 py-2">
            <p class="text-center text-xs text-slate-500">
              下のボタンで相談を開始します
            </p>
            <button
              id="start-btn"
              type="button"
              class="mic-fab mic-fab-hero"
              aria-label="相談を開始する"
            >
              <svg
                class="mic-icon"
                width="44" height="44" viewBox="0 0 24 24"
                fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M11 2v2"/>
                <path d="M5 2v2"/>
                <path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/>
                <path d="M8 15a6 6 0 0 0 12 0v-3"/>
                <circle cx="20" cy="10" r="2"/>
              </svg>
              <span class="mic-label mt-1 text-xs font-semibold">相談を開始</span>
            </button>
            <div class="mt-1 flex items-center gap-2 rounded-full bg-slate-50 px-3 py-1.5 text-xs text-slate-600">
              <span><AppIcon name="mic" size={20} /> 話す</span>
              <span class="text-slate-400">/</span>
              <span>⌨ 入力する</span>
              <span class="text-slate-400">—</span>
              <span class="font-medium text-brand-700">どちらでも OK</span>
            </div>
          </div>

          <!-- ━━━ QA AREA（開始後に表示） ━━━ -->
          <div id="qa-area" hidden>
            <div class="mb-3 flex items-start gap-2">
              <div id="coach-hint" class="flex-1 text-sm font-medium leading-relaxed text-slate-700">
                {displayName}、健康に関するご質問にお答えします <AppIcon name="sprout" size={20} />
              </div>
              <button
                id="mic-btn"
                type="button"
                class="mic-fab compact shrink-0"
                aria-label="音声入力を開始"
              >
                <span class="mic-icon text-lg"><AppIcon name="mic" size={20} /></span>
                <span class="mic-label text-xs">話す</span>
              </button>
              <button
                id="speaker-btn"
                type="button"
                class="speaker-fab shrink-0"
                aria-label="音声の ON/OFF"
                title="音声 ON/OFF"
              >
                <svg
                  class="speaker-ico speaker-ico-on"
                  width="22" height="22" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                  <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
                  <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
                </svg>
                <svg
                  class="speaker-ico speaker-ico-off"
                  width="22" height="22" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                  <line x1="22" y1="9" x2="16" y2="15"/>
                  <line x1="16" y1="9" x2="22" y2="15"/>
                </svg>
                <span class="speaker-label text-xs">音声</span>
              </button>
            </div>

            <!-- 二刀流ヒント -->
            <div
              id="dual-hint"
              class="mb-2 flex items-center justify-center gap-2 rounded-full bg-brand-50 px-3 py-1 text-xs text-brand-700"
            >
              <span><AppIcon name="mic" size={20} /> 話してもOK</span>
              <span class="text-brand-400">・</span>
              <span>⌨ 入力してもOK</span>
            </div>

            <!-- 音声モード -->
            <div id="ui-voice" class="flex flex-col items-center gap-2 py-3">
              <div id="voice-indicator" class="grid place-items-center">
                <AppIcon name="mic" size={32} class="text-slate-500" />
              </div>
              <p class="text-center text-xs text-slate-500">
                右上の「話す」ボタンを押して質問してください
              </p>
            </div>

            <!-- テキストモード -->
            <div id="ui-text" class="flex flex-col gap-2" hidden>
              <textarea
                id="text-input"
                rows="2"
                maxlength="500"
                class="resize-none rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
                placeholder="健康に関する質問を入力してください"
              ></textarea>
              <button id="text-submit" type="button" class="btn-primary">送信</button>
            </div>
          </div>
        </section>

        <p class="text-center text-xs text-slate-400">
          ※ 医療アドバイスには該当しません。診断・治療は主治医にご相談ください。
        </p>
      </main>
    </>
  )}
</BaseLayout>

<script>
  interface CoachMessage {
    role: 'user' | 'assistant';
    text: string;
    at: string;
  }

  interface SpeechRecognitionResult {
    readonly isFinal: boolean;
    readonly length: number;
    [index: number]: { transcript: string };
  }
  interface SpeechRecognitionEventLike extends Event {
    readonly resultIndex: number;
    readonly results: {
      readonly length: number;
      [index: number]: SpeechRecognitionResult;
    };
  }
  interface SpeechRecognitionLike extends EventTarget {
    lang: string;
    interimResults: boolean;
    continuous: boolean;
    start(): void;
    stop(): void;
    abort(): void;
    onresult: ((ev: SpeechRecognitionEventLike) => void) | null;
    onerror: ((ev: Event & { error?: string }) => void) | null;
    onend: (() => void) | null;
  }
  type SpeechRecognitionCtor = new () => SpeechRecognitionLike;

  const STORAGE_KEY_PREFIX = 'coach.history.';

  function $opt<T extends HTMLElement = HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }
  function $<T extends HTMLElement = HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Element #${id} not found`);
    return el as T;
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderMarkdown(text: string): string {
    return escapeHtml(text)
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/\n/g, '<br/>');
  }

  document.addEventListener('DOMContentLoaded', () => {
    const main = $opt('coach-main');
    if (!main) return;

    const diagnosticUserId = main.dataset.diagnosticUserId ?? '';
    if (!diagnosticUserId) return;
    const initialGreeting = main.dataset.initialGreeting ?? '';

    const storageKey = STORAGE_KEY_PREFIX + diagnosticUserId;

    const logEl       = $('coach-log');
    const emptyEl     = $opt('coach-empty');
    const statusEl    = $('coach-status');
    const resetBtn    = $<HTMLButtonElement>('reset-btn');
    const modeToggle  = $('mode-toggle');

    const startHero   = $('start-hero');
    const startBtn    = $<HTMLButtonElement>('start-btn');
    const qaArea      = $('qa-area');

    const micBtn      = $<HTMLButtonElement>('mic-btn');
    const speakerBtn  = $<HTMLButtonElement>('speaker-btn');

    const uiVoice     = $('ui-voice');
    const uiText      = $('ui-text');
    const textInput   = $<HTMLTextAreaElement>('text-input');
    const textSubmit  = $<HTMLButtonElement>('text-submit');

    let history: CoachMessage[] = loadHistory();
    let mode: 'voice' | 'text' = 'voice';
    let speakerOn = true;
    let sending = false;

    // ─── 履歴 ───
    function loadHistory(): CoachMessage[] {
      try {
        const raw = localStorage.getItem(storageKey);
        if (!raw) return [];
        const arr = JSON.parse(raw);
        return Array.isArray(arr)
          ? arr.filter((m): m is CoachMessage =>
              m && typeof m.text === 'string' &&
              (m.role === 'user' || m.role === 'assistant'))
          : [];
      } catch { return []; }
    }
    function saveHistory() {
      try { localStorage.setItem(storageKey, JSON.stringify(history.slice(-30))); } catch { /* ignore */ }
    }

    // ─── レンダリング ───
    function makeBubble(m: CoachMessage): HTMLDivElement {
      const wrap = document.createElement('div');
      const isUser = m.role === 'user';
      wrap.className = isUser ? 'flex justify-end bubble-in' : 'flex justify-start bubble-in';
      const bubble = document.createElement('div');
      bubble.className = isUser
        ? 'max-w-[80%] rounded-2xl rounded-br-md bg-brand-600 px-3.5 py-2 text-sm text-white shadow-sm'
        : 'max-w-[85%] rounded-2xl rounded-bl-md border border-slate-200 bg-white px-3.5 py-2 text-sm leading-relaxed text-slate-800 shadow-sm';
      bubble.innerHTML = renderMarkdown(m.text);
      wrap.appendChild(bubble);
      return wrap;
    }
    function renderHistory() {
      logEl.innerHTML = '';
      for (const m of history) logEl.appendChild(makeBubble(m));
      if (emptyEl) emptyEl.hidden = history.length > 0;
      if (history.length > 0 && emptyEl) {
        logEl.removeChild(emptyEl);
      }
      scrollLog();
    }
    function appendBubble(m: CoachMessage) {
      if (emptyEl && emptyEl.parentNode === logEl) logEl.removeChild(emptyEl);
      logEl.appendChild(makeBubble(m));
      scrollLog();
    }
    function scrollLog() {
      requestAnimationFrame(() => { logEl.scrollTop = logEl.scrollHeight; });
    }
    function setStatus(text: string) { statusEl.textContent = text; }

    function makePending(): { remove: () => void } {
      const wrap = document.createElement('div');
      wrap.className = 'flex justify-start bubble-in';
      const bubble = document.createElement('div');
      bubble.className =
        'max-w-[85%] rounded-2xl rounded-bl-md border border-slate-200 bg-white px-3.5 py-2 text-sm text-slate-500 shadow-sm';
      bubble.innerHTML =
        '<span class="inline-flex items-center gap-1">' +
        '<span class="h-1.5 w-1.5 animate-bounce rounded-full bg-slate-400" style="animation-delay:0ms"></span>' +
        '<span class="h-1.5 w-1.5 animate-bounce rounded-full bg-slate-400" style="animation-delay:120ms"></span>' +
        '<span class="h-1.5 w-1.5 animate-bounce rounded-full bg-slate-400" style="animation-delay:240ms"></span>' +
        '<span class="ml-2 text-xs">あなたの AI疾病予防報告書を読込んでいます。少々お待ちください。</span>' +
        '</span>';
      wrap.appendChild(bubble);
      logEl.appendChild(wrap);
      scrollLog();
      return { remove: () => wrap.remove() };
    }

    function appendError(msg: string) {
      const wrap = document.createElement('div');
      wrap.className = 'flex justify-start bubble-in';
      const bubble = document.createElement('div');
      bubble.className =
        'max-w-[85%] rounded-2xl rounded-bl-md border border-red-200 bg-red-50 px-3.5 py-2 text-sm text-red-700 shadow-sm';
      bubble.textContent = ` ${msg}`;
      wrap.appendChild(bubble);
      logEl.appendChild(wrap);
      scrollLog();
    }

    // ─── API ───
    async function sendMessage(text: string) {
      if (sending || !text.trim()) return;
      sending = true;
      setStatus('問い合わせ中…');

      const userMsg: CoachMessage = { role: 'user', text, at: new Date().toISOString() };
      history.push(userMsg);
      saveHistory();
      appendBubble(userMsg);

      const pending = makePending();

      try {
        const res = await fetch('/api/coach/ask', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            diagnosticUserId,
            message: text,
            history: history.slice(0, -1).map((m) => ({ role: m.role, text: m.text })),
          }),
        });
        pending.remove();

        if (!res.ok) {
          const body = await res.json().catch(() => null) as { error?: string } | null;
          appendError(body?.error ?? `送信に失敗しました (HTTP ${res.status})`);
          setStatus('エラー');
          return;
        }
        const data = await res.json() as { answer: string; generatedAt: string };
        const aiMsg: CoachMessage = { role: 'assistant', text: data.answer, at: data.generatedAt ?? new Date().toISOString() };
        history.push(aiMsg);
        saveHistory();
        appendBubble(aiMsg);
        setStatus('待機中');

        if (mode === 'voice' && speakerOn) speak(data.answer);
      } catch (err) {
        pending.remove();
        appendError(`通信エラー: ${err instanceof Error ? err.message : String(err)}`);
        setStatus('エラー');
      } finally {
        sending = false;
      }
    }

    // ─── 音声入力 (STT) ───
    const win = window as unknown as {
      SpeechRecognition?: SpeechRecognitionCtor;
      webkitSpeechRecognition?: SpeechRecognitionCtor;
    };
    const SttCtor = win.SpeechRecognition ?? win.webkitSpeechRecognition;
    const sttSupported = !!SttCtor;
    let recog: SpeechRecognitionLike | null = null;
    let recording = false;

    function startRecording() {
      if (recording || !sttSupported || !SttCtor) return;
      cancelSpeak();
      try { recog = new SttCtor(); }
      catch { return; }
      recog.lang = 'ja-JP';
      recog.interimResults = true;
      recog.continuous = false;

      recog.onresult = (ev) => {
        let interim = '';
        let final = '';
        for (let i = ev.resultIndex; i < ev.results.length; i++) {
          const r = ev.results[i];
          const t = r[0]?.transcript ?? '';
          if (r.isFinal) final += t;
          else interim += t;
        }
        if (final) {
          stopRecording();
          void sendMessage(final.trim());
        } else if (interim) {
          setStatus(`聞き取り中: ${interim.slice(0, 30)}`);
        }
      };
      recog.onerror = (ev) => {
        stopRecording();
        if (ev.error === 'not-allowed' || ev.error === 'service-not-allowed') {
          setStatus('マイク権限が必要です');
        } else if (ev.error === 'no-speech') {
          setStatus('声が聞こえませんでした');
        } else {
          setStatus('音声入力エラー');
        }
      };
      recog.onend = () => { if (recording) stopRecording(); };

      try {
        recog.start();
        recording = true;
        micBtn.classList.add('active');
        micBtn.setAttribute('aria-label', '音声入力を停止');
        micBtn.querySelector('.mic-icon')!.textContent = '⏸';
        micBtn.querySelector('.mic-label')!.textContent = '停止';
        setStatus(' 聞き取り中…');
      } catch {
        recording = false;
      }
    }
    function stopRecording() {
      recording = false;
      micBtn.classList.remove('active');
      micBtn.setAttribute('aria-label', '音声入力を開始');
      micBtn.querySelector('.mic-icon')!.textContent = '';
      micBtn.querySelector('.mic-label')!.textContent = '話す';
      if (recog) {
        try { recog.stop(); } catch { /* ignore */ }
        recog = null;
      }
      if (statusEl.textContent?.startsWith('')) setStatus('待機中');
    }

    // ─── 音声出力 (TTS) ───
    function speak(text: string) {
      if (!('speechSynthesis' in window)) return;
      cancelSpeak();
      const plain = text.replace(/\*\*/g, '').replace(/[#`]/g, '');
      const utter = new SpeechSynthesisUtterance(plain);
      utter.lang = 'ja-JP';
      utter.rate = 1.0;
      utter.pitch = 1.0;
      const voices = speechSynthesis.getVoices();
      const ja = voices.find((v) => v.lang?.startsWith('ja'));
      if (ja) utter.voice = ja;
      utter.onstart = () => setStatus(' 読み上げ中…');
      utter.onend = () => { if (statusEl.textContent?.startsWith('')) setStatus('待機中'); };
      try { speechSynthesis.speak(utter); }
      catch { /* ignore */ }
    }
    function cancelSpeak() {
      if ('speechSynthesis' in window) {
        try { speechSynthesis.cancel(); } catch { /* ignore */ }
      }
    }

    // ─── モード切替 ───
    function setMode(next: 'voice' | 'text') {
      mode = next;
      modeToggle.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((btn) => {
        const on = btn.dataset.mode === next;
        btn.classList.toggle('on', on);
        btn.setAttribute('aria-selected', String(on));
      });
      uiVoice.hidden = next !== 'voice';
      uiText.hidden = next !== 'text';
      micBtn.hidden = next !== 'voice';
      speakerBtn.hidden = next !== 'voice';
      if (next === 'text') {
        stopRecording();
        cancelSpeak();
        textInput.focus();
      }
    }

    // ─── 開始 / リセット ───
    function startSession(opts: { speakGreeting?: boolean } = {}) {
      startHero.hidden = true;
      qaArea.hidden = false;
      setStatus('待機中');

      // 履歴が空なら、AI からの初期挨拶文を chat に投入 (音声モードなら読み上げ)
      if (history.length === 0 && initialGreeting) {
        const greetMsg: CoachMessage = {
          role: 'assistant',
          text: initialGreeting,
          at: new Date().toISOString(),
        };
        history.push(greetMsg);
        saveHistory();
        appendBubble(greetMsg);
        if (opts.speakGreeting && mode === 'voice' && speakerOn) {
          speak(initialGreeting);
        }
      }

      if (mode === 'text') textInput.focus();
    }

    // ─── イベント配線 ───
    modeToggle.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const btn = t.closest<HTMLButtonElement>('[data-mode]');
      if (!btn) return;
      const next = btn.dataset.mode === 'text' ? 'text' : 'voice';
      setMode(next);
    });

    startBtn.addEventListener('click', () => startSession({ speakGreeting: true }));

    micBtn.addEventListener('click', () => {
      if (!sttSupported) {
        setStatus('お使いのブラウザは音声入力に未対応です');
        setMode('text');
        return;
      }
      if (recording) stopRecording();
      else startRecording();
    });

    speakerBtn.addEventListener('click', () => {
      speakerOn = !speakerOn;
      speakerBtn.classList.toggle('muted', !speakerOn);
      speakerBtn.setAttribute('aria-label', speakerOn ? '音声 OFF' : '音声 ON');
      if (!speakerOn) cancelSpeak();
    });

    textSubmit.addEventListener('click', () => {
      const t = textInput.value.trim();
      if (!t) return;
      void sendMessage(t);
      textInput.value = '';
    });
    textInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        const t = textInput.value.trim();
        if (!t) return;
        void sendMessage(t);
        textInput.value = '';
      }
    });

    resetBtn.addEventListener('click', () => {
      if (history.length === 0 && startHero.hidden === false) return;
      if (!confirm('会話履歴をリセットしますか?')) return;
      history = [];
      saveHistory();
      stopRecording();
      cancelSpeak();
      startHero.hidden = false;
      qaArea.hidden = true;
      renderHistory();
      setStatus('待機中');
    });

    // 初期 render
    renderHistory();
    // 会話履歴があれば hero をスキップ (挨拶は再生しない — 履歴に既にある)
    if (history.length > 0) startSession();
  });
</script>
