---
import AppIcon from '../../components/AppIcon.astro';
import BackToDashboard from '../../components/BackToDashboard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadResult } from '../../lib/result-queries';
import { testTypeLabel, formatJpDate } from '../../lib/dashboard-queries';
import { renderReportMarkdown } from '../../lib/report-view';
import { AI_PREVENTION_REPORT_LABEL } from '../../lib/display-names';
import { resolveViewer, viewerLinkQuery, viewerPathPrefix } from '../../lib/viewer';
import { noStore } from '../../lib/http-cache';

export const prerender = false;

// Cookie で個人化される SSR ページ: 共有キャッシュに保存させない
// (他の 8 ページは既に通していて、ここだけ抜けていた・2026-09-29)
noStore(Astro.response);

const { id } = Astro.params;
const url = new URL(Astro.request.url);
// 入場は Cookie で本人を判定する (`src/lib/viewer.ts`)。`?u=` は admin の代理表示のみ。
const viewer = await resolveViewer(Astro);
const u = viewer.uid ?? '';
/** リンクに引き継ぐクエリ ('' か '?u=<uid>')。一般ユーザーは '' = URL に uid を出さない。 */
const linkQuery = viewerLinkQuery(viewer);
// **代理表示の path prefix**。一般ユーザーは `''`（`viewer.ts` に集約・2026-09-30）。
const linkPrefix = viewerPathPrefix(viewer);
// mode = summary (a) | highlights (b) | full (c)
const mode = url.searchParams.get('mode') ?? 'summary';
// PDF deep link target page (a/b の [pN] クリックで mode=full&page=N に遷移してくる)
const initialPage = (() => {
  const p = parseInt(url.searchParams.get('page') ?? '', 10);
  return Number.isFinite(p) && p > 0 ? p : 1;
})();

const result = await loadResult(id ?? '', u);
const hasError = 'error' in result;
const data = hasError ? null : result;

const tt = data ? testTypeLabel(data.artifact.test_type) : { name: '検査', icon: 'result' as const };

const linkFor = (m: string) => {
  const qs = new URLSearchParams(linkQuery.replace(/^\?/, ''));
  qs.set('mode', m);
  return `?${qs.toString()}`;
};

/*
 * 「検査結果の数値」の列は**中身がある列だけ**出す。
 * がんリスク検査 (ALA-PDS) は基準値を持たないので、空の「基準値」列を並べると
 * 全行が「—」になり、**当社が欄を作って埋められなかった**ように見える
 * (AI疾病予防報告書で同じことを指摘された・CLAUDE.md 2026-09-18)。
 * **プレースホルダを置かず、列ごと出さない。**
 */
const ms = data?.measurements ?? [];
const hasUnit = ms.some((m) => m.unit != null);
const hasRef = ms.some((m) => m.refLow != null || m.refHigh != null);
const hasJudged = ms.some((m) => m.flag != null || m.assessment != null);
/** 基準値の表示。**原本の表記をそのまま並べるだけ**（計算しない）。 */
const refText = (m: { refLow: string | null; refHigh: string | null }): string => {
  if (m.refLow != null && m.refHigh != null) return `${m.refLow}〜${m.refHigh}`;
  return m.refHigh ?? m.refLow ?? '';
};

/** 本文 Markdown → HTML。和文組版は src/lib/report-view.ts に集約 (/report と共通)。
    `[pN]` の PDF ページジャンプは廃止した — 新形式に `[pN]` は 0 件で成立しないため
    (docs/旧版・ボツ/ai_prevention_report_generation_spec.md §5.1)。 */
function md(text: string): string {
  return renderReportMarkdown(text);
}

/*
 * 「過去データ」。同じ検査種別の他の回へ切り替える。
 * ダッシュボードには置かず「データ」を押した先のここに置く (発注者指示 2026-08)。
 * 1 回分しか無いときは出さない (切替先が無いので押しても何も起きない)。
 */
const siblings = data?.siblings ?? [];
const hasPast = siblings.length > 1;
const siblingHref = (sid: string) => {
  const qs = new URLSearchParams(linkQuery.replace(/^\?/, ''));
  if (mode !== 'summary') qs.set('mode', mode);
  const query = qs.toString();
  return `/result/${sid}${query ? `?${query}` : ''}`;
};

const pdfSrcWithPage = data?.samplePdfUrl
  ? `${data.samplePdfUrl}#page=${initialPage}`
  : null;
---

<BaseLayout title={data ? `${tt.name} | Welltect` : '検査結果 | Welltect'} width="app">
  {hasError && (
    <main class="flex flex-1 flex-col items-center justify-center gap-3 px-5 text-center">
      <AppIcon name="watch" size={32} class="text-slate-500" />
      <h1 class="text-lg font-bold">検査結果を読み込めませんでした</h1>
      <p class="text-sm text-red-700">{(result as { error: string }).error}</p>
      <BackToDashboard linkQuery={linkQuery} linkPrefix={linkPrefix} class="mt-3" />
    </main>
  )}

  {!hasError && data && (
    <>
      <header class="hero-gradient px-5 pt-6 pb-3">
        <div class="flex items-center justify-between">
          <BackToDashboard linkQuery={linkQuery} linkPrefix={linkPrefix} />
          <p class="text-xs font-medium uppercase tracking-wider text-brand-700/80">RESULT</p>
          <span class="w-10"></span>
        </div>
        <div class="mt-3 flex items-center gap-3">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-mist text-2xl">
            <AppIcon name={tt.icon} size={20} class="text-brand-700" />
          </span>
          <div class="flex-1">
            <h1 class="text-lg font-bold tracking-tight">{tt.name}</h1>
            <p class="mt-0.5 text-xs text-slate-600">
              {formatJpDate(data.artifact.test_date)}
              {data.artifact.lab_name && <span> · {data.artifact.lab_name}</span>}
              {data.artifact.page_count && data.artifact.page_count > 1 && <span> · {data.artifact.page_count}pg</span>}
            </p>
          </div>
          {data.artifact.source === 'user_upload' && (
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">自分でUP</span>
          )}
        </div>

        {/* 過去データ (同じ検査の他の回)。<details> で畳んでおき、開くと日付が並ぶ。 */}
        {hasPast && (
          <details class="mt-3 rounded-xl border border-navy-400 bg-white">
            <summary class="flex min-h-touch cursor-pointer items-center gap-2 px-3 text-base font-semibold text-navy-800">
              <AppIcon name="clock" size={18} />
              過去データ
              <span class="tnum text-sm font-medium text-slate-600">全 {siblings.length} 回</span>
              <AppIcon name="expand" size={18} class="ml-auto text-slate-600" />
            </summary>
            <ul class="border-t border-slate-200 p-2">
              {siblings.map((sib) => {
                const current = sib.id === data.artifact.id;
                return (
                  <li>
                    {current ? (
                      <span class="flex min-h-touch items-center gap-2 rounded-lg bg-mist px-3 text-base font-semibold text-navy-800">
                        <AppIcon name="check" size={18} />
                        <span class="tnum">{formatJpDate(sib.testDate)}</span>
                        <span class="ml-auto text-sm font-medium text-slate-700">表示中</span>
                      </span>
                    ) : (
                      <a
                        href={siblingHref(sib.id)}
                        class="flex min-h-touch items-center gap-2 rounded-lg px-3 text-base text-slate-800 hover:bg-brand-50"
                      >
                        <span class="tnum">{formatJpDate(sib.testDate)}</span>
                        <AppIcon name="next" size={18} class="ml-auto text-slate-600" />
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          </details>
        )}

        {/* 原本 PDF へのクイックアクセス (kensa_sample) */}
        {data.samplePdfUrl && (
          <div class="mt-3 flex items-center justify-between gap-2 rounded-xl border border-slate-200 bg-white/70 px-3 py-2 text-xs">
            <span class="flex items-center gap-1 text-slate-600">
              <span><AppIcon name="report" size={20} /></span>
              <span class="font-medium">{data.samplePdfLabel}</span>
            </span>
            <a
              href={data.samplePdfUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1 rounded-full bg-brand-600 px-3 py-1 text-xs font-medium text-white hover:bg-brand-700"
            >
              原本を開く ↗
            </a>
          </div>
        )}

        {/* 3-モードタブ (本文が無い / single なら非表示) */}
        {data.isThreeMode && data.sections.length > 0 && (
          <nav class="mt-4 inline-flex w-full rounded-full bg-slate-100 p-1" role="tablist" aria-label="表示モード">
            <a
              href={linkFor('summary')}
              role="tab"
              aria-selected={mode === 'summary'}
              class={`flex-1 rounded-full px-3 py-1.5 text-center text-xs font-medium transition ${mode === 'summary' ? 'bg-white text-brand-700 shadow-sm' : 'text-slate-500'}`}
            >
              <AppIcon name="result" size={20} /> サマリー
            </a>
            <a
              href={linkFor('highlights')}
              role="tab"
              aria-selected={mode === 'highlights'}
              class={`flex-1 rounded-full px-3 py-1.5 text-center text-xs font-medium transition ${mode === 'highlights' ? 'bg-white text-brand-700 shadow-sm' : 'text-slate-500'}`}
            >
              <AppIcon name="watch" size={20} /> 要注意
            </a>
            <a
              href={linkFor('full')}
              role="tab"
              aria-selected={mode === 'full'}
              class={`flex-1 rounded-full px-3 py-1.5 text-center text-xs font-medium transition ${mode === 'full' ? 'bg-white text-brand-700 shadow-sm' : 'text-slate-500'}`}
            >
              <AppIcon name="report" size={20} /> 全編
            </a>
          </nav>
        )}
      </header>

      <main class="flex flex-1 flex-col gap-3 px-5 pb-8 pt-3">
        {/*
          アプリ内スキャンで読み取った本文 (scan_md)。
          **原本画像は保存していない** (発注者判断 2026-09-04: 元々ユーザーの手元に
          あるもの) ので、人間ドック / 健康診断はここが中身になる。
          admin 取込の行は scan_md が null なので、この節ごと出ない。
        */}
        {data.artifact.scan_md && (
          <section class="card">
            <h2 class="flex items-center gap-2 text-base font-bold text-navy-800">
              <AppIcon name="result" size={20} class="text-brand-700" />
              読み取り結果
            </h2>
            <p class="mt-1 text-sm text-slate-600">
              アップロード / 撮影した用紙から読み取り、ご確認いただいた内容です。
            </p>
            <div class="md-region mt-3 text-sm leading-relaxed text-slate-800" set:html={md(data.artifact.scan_md)} />
          </section>
        )}

        {/*
          **検査票から読み取った測定値** (`test_artifacts.measurements`)。

          【なぜ足したか (2026-09-30・実測)】この画面は `scan_md` (アプリ内スキャンだけが
          書く) と原本 PDF しか出していなかったので、**admin 取込のがんリスク検査・血液・
          遺伝子は「値」が画面のどこにも出ていなかった**。DB には入っているのに読む側が無い、
          という状態だった。

          出すのは**検査票に印字されている事実だけ** — 項目名・値・単位・基準値と、
          **検査機関が付けた**印 (flag) / 判定コード (assessment)。
          **値と基準値から判定を計算しない** (CLAUDE.md「表示の原則 (ミッション④)」)。
          `flag` が null は「印が無い」であって「基準値内」ではないので、何も出さない。

          `scan_md` がある回 (アプリ内スキャン) では上の「読み取り結果」に同じ値が
          表の形で出ているため、**二重に出さない**。
        */}
        {!data.artifact.scan_md && data.measurements.length > 0 && (
          <section class="card">
            <h2 class="flex items-center gap-2 text-base font-bold text-navy-800">
              <AppIcon name="result" size={20} class="text-brand-700" />
              検査結果の数値
            </h2>
            <p class="mt-1 text-sm text-slate-600">
              検査票に記載された内容です。判定は検査機関が付けたものだけを表示しています。
            </p>
            {/*
              **表に w-full を当てない** (CLAUDE.md 2026-09-05)。幅 100% で固定すると
              狭い端末で列が潰れ、和文が 1 文字ずつ縦に折れる。はみ出しは横スクロールへ流す。
            */}
            <div class="md-region mt-3 overflow-x-auto">
              <table class="w-max min-w-full text-sm">
                <thead>
                  <tr>
                    <th class="whitespace-nowrap text-left">項目</th>
                    <th class="whitespace-nowrap text-left">値</th>
                    {hasUnit && <th class="whitespace-nowrap text-left">単位</th>}
                    {hasRef && <th class="whitespace-nowrap text-left">基準値</th>}
                    {hasJudged && <th class="whitespace-nowrap text-left">検査機関の判定</th>}
                  </tr>
                </thead>
                <tbody>
                  {data.measurements.map((m) => (
                    <tr>
                      <td class="whitespace-nowrap">{m.name}</td>
                      <td class="tnum whitespace-nowrap">{m.value}</td>
                      {hasUnit && <td class="whitespace-nowrap">{m.unit}</td>}
                      {hasRef && <td class="tnum whitespace-nowrap">{refText(m)}</td>}
                      {hasJudged && (
                        <td class="whitespace-nowrap">
                          {m.flag === 'H' && <span class="status-pill status-watch"><AppIcon name="watch" size={16} />高値</span>}
                          {m.flag === 'L' && <span class="status-pill status-watch"><AppIcon name="watch" size={16} />低値</span>}
                          {m.assessment}
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {/* Elith JSON が無い + PDF も無い + 読み取り結果も無い + 数値も無い場合のみ「処理中」表示 */}
        {data.sections.length === 0 && !data.samplePdfUrl && !data.artifact.scan_md && data.measurements.length === 0 && (
          <section class="card text-center">
            <p class="text-sm text-slate-600">
              {data.artifact.source === 'user_upload'
                ? 'スキャン処理中、または LLM 解析待ちです。少し時間を置いて再度ご確認ください。'
                : '検査会社からの結果受信待ちです。'}
            </p>
            <p class="mt-2 text-xs text-slate-500">
              ステータス: {data.artifact.status} / 取込: {formatJpDate(data.artifact.imported_at)}
            </p>
          </section>
        )}

        {/*
          AI疾病予防報告書 (アカウント単位) への導線。
          この画面は検査 1 件の原本を見せる場所なので、報告書の本体は /report に置く。
        */}
        <a
          href={`/report${linkQuery}`}
          class="flex min-h-touch items-center gap-3 rounded-2xl border border-brand-200 bg-brand-50 px-4 py-3 text-slate-800 transition hover:border-brand-400 hover:bg-brand-100"
        >
          <AppIcon name="report" size={24} class="shrink-0 text-brand-700" />
          <span class="flex min-w-0 flex-col">
            <span class="text-base font-semibold text-navy-800">{AI_PREVENTION_REPORT_LABEL}を見る</span>
            <span class="text-sm text-slate-700">検査全体をまとめた Elith の報告書</span>
          </span>
          <AppIcon name="next" size={20} class="ml-auto shrink-0 text-brand-700" />
        </a>

        {/* 原本 (PDF) を主表示 */}
        {data.sections.length === 0 && data.samplePdfUrl && (
          <section class="card">
            <header class="mb-2 flex items-center justify-between gap-2">
              <h2 class="flex items-center gap-2 text-sm font-bold text-slate-800">
                <span><AppIcon name="report" size={20} /></span><span>{data.samplePdfLabel ?? '検査結果 (原本)'}</span>
              </h2>
              <a href={data.samplePdfUrl} target="_blank" rel="noopener" class="text-xs font-medium text-brand-600 hover:underline">別タブで開く ↗</a>
            </header>
            <iframe
              src={data.samplePdfUrl}
              title={data.samplePdfLabel ?? '原本 PDF'}
              class="w-full rounded-lg border border-slate-200"
              style="height: clamp(420px, 70vh, 800px);"
              loading="lazy"
            ></iframe>
            <p class="mt-2 text-sm text-slate-600">
              {data.isOriginal
                ? 'この検査の原本です。'
                : 'この検査の原本がまだ届いていないため、同じ検査種別のサンプルを表示しています。'}
            </p>
          </section>
        )}

        {/* a) サマリー版 */}
        {data.sections.length > 0 && (!data.isThreeMode || mode === 'summary') && (
          <section class="card">
            <header class="mb-2 flex items-center gap-2">
              <span class="text-base"><AppIcon name="result" size={20} /></span>
              <h2 class="text-sm font-bold text-slate-800">サマリー (アブストラクト)</h2>
              {!data.isThreeMode && <span class="ml-auto text-xs text-slate-500">single モード</span>}
            </header>
            {data.summarySection ? (
              <div class="md-region md-summary text-xs leading-relaxed text-slate-700" set:html={md(data.summarySection.text)} />
            ) : (
              <p class="text-xs text-slate-500">アブストラクトセクションが見つかりません。「全編」をご確認ください。</p>
            )}
            {data.isThreeMode && (
              <div class="mt-3 flex gap-2 text-xs">
                <a href={linkFor('highlights')} class="rounded-full bg-amber-50 px-3 py-1 text-amber-700 hover:bg-amber-100">要注意項目を見る →</a>
                <a href={linkFor('full')} class="rounded-full bg-slate-100 px-3 py-1 text-slate-700 hover:bg-slate-200">全編を見る →</a>
              </div>
            )}
          </section>
        )}

        {/* b) 要注意抜粋 */}
        {data.sections.length > 0 && data.isThreeMode && mode === 'highlights' && (
          <section class="space-y-3">
            <div class="card border-amber-300 bg-amber-50/50">
              <header class="mb-2 flex items-center gap-2">
                <span class="text-base"><AppIcon name="watch" size={20} /></span>
                <h2 class="text-sm font-bold text-amber-900">要注意 — 優先して確認したい項目</h2>
              </header>
              <p class="text-xs text-amber-800">
                医療受診の目安や、行動に移しやすい栄養面の指摘を抜粋しています。
              </p>
            </div>
            {data.highlightSections.length === 0 ? (
              <div class="card text-center text-sm text-slate-500">
                要注意項目は抽出されませんでした。
              </div>
            ) : (
              data.highlightSections.map((s) => (
                <article class="card">
                  <h3 class="mb-2 text-sm font-bold text-slate-800">{s.section_name}</h3>
                  <div class="md-region md-summary text-xs leading-relaxed text-slate-700" set:html={md(s.text)} />
                </article>
              ))
            )}
            <a href={linkFor('summary')} class="inline-flex items-center gap-1 text-xs text-brand-600 hover:underline">‹ サマリーへ戻る</a>
          </section>
        )}

        {/* c) 全編 */}
        {data.sections.length > 0 && data.isThreeMode && mode === 'full' && (
          <section class="space-y-3">
            <div class="card border-slate-300 bg-slate-50">
              <header class="mb-2 flex items-center gap-2">
                <span class="text-base"><AppIcon name="report" size={20} /></span>
                <h2 class="text-sm font-bold text-slate-800">全編</h2>
                <span class="ml-auto text-xs text-slate-500">{data.fullSections.length} セクション</span>
              </header>
              <p class="text-xs text-slate-600">AI疾病予防報告書の全編です。原本 PDF と LLM 解析の全テキストを併載しています。</p>
            </div>

            {/* 原本 PDF を iframe で */}
            {pdfSrcWithPage && (
              <article id="pdf-viewer" class="card scroll-mt-24">
                <header class="mb-2 flex items-center justify-between gap-2">
                  <h3 class="flex items-center gap-2 text-sm font-bold text-slate-800">
                    <span><AppIcon name="report" size={20} /></span><span>原本 PDF — {data.samplePdfLabel}</span>
                  </h3>
                  <span class="text-xs text-slate-500">p{initialPage} から表示</span>
                  <a href={data.samplePdfUrl ?? '#'} target="_blank" rel="noopener" class="text-xs font-medium text-brand-600 hover:underline">別タブで開く ↗</a>
                </header>
                <iframe
                  id="result-pdf-iframe"
                  data-pdf-base={data.samplePdfUrl}
                  src={pdfSrcWithPage}
                  title={data.samplePdfLabel ?? '原本 PDF'}
                  class="w-full rounded-lg border border-slate-200"
                  style="height: clamp(420px, 75vh, 900px);"
                  loading="lazy"
                ></iframe>
              </article>
            )}

            {/* 目次 */}
            <nav class="card">
              <h3 class="mb-2 text-xs font-bold text-slate-600">目次</h3>
              <ol class="space-y-1 text-xs">
                {data.fullSections.map((s, i) => (
                  <li>
                    <a href={`#section-${i}`} class="flex items-center justify-between rounded px-2 py-1 hover:bg-slate-100">
                      <span class="text-slate-700">{i + 1}. {s.section_name}</span>
                      <span class="text-xs text-slate-400">{s.char_count.toLocaleString()}字</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>

            {data.fullSections.map((s, i) => (
              <article id={`section-${i}`} class="card scroll-mt-24">
                <header class="mb-2 flex items-baseline justify-between">
                  <h3 class="text-sm font-bold text-slate-800">
                    <span class="text-brand-500">{i + 1}.</span> {s.section_name}
                  </h3>
                  <span class="text-xs text-slate-500">{s.char_count.toLocaleString()}字</span>
                </header>
                <div class="md-region text-xs leading-relaxed text-slate-700" set:html={md(s.text)} />
              </article>
            ))}

            <div class="flex justify-between gap-2">
              <a href={linkFor('summary')} class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-200">‹ サマリーへ戻る</a>
              <a href="#" class="inline-flex items-center gap-1 rounded-full bg-brand-50 px-3 py-1.5 text-xs text-brand-700 hover:bg-brand-100">↑ 先頭へ</a>
            </div>
          </section>
        )}

        {/* メタ情報 (折りたたみ) */}
        <details class="rounded-2xl border border-dashed border-slate-300 p-3">
          <summary class="min-h-touch cursor-pointer text-sm font-medium text-slate-700"><AppIcon name="tool" size={20} /> 詳細メタ</summary>
          <dl class="mt-2 space-y-1 text-xs text-slate-600">
            <div class="flex justify-between"><dt>artifact id:</dt><dd class="font-mono">{data.artifact.id}</dd></div>
            <div class="flex justify-between"><dt>source:</dt><dd>{data.artifact.source}</dd></div>
            <div class="flex justify-between"><dt>test_type:</dt><dd>{data.artifact.test_type}</dd></div>
            <div class="flex justify-between"><dt>display_mode:</dt><dd>{data.artifact.display_mode}</dd></div>
            <div class="flex justify-between"><dt>schema_version:</dt><dd>{data.artifact.schema_version}</dd></div>
            <div class="flex justify-between"><dt>imported_at:</dt><dd>{formatJpDate(data.artifact.imported_at)}</dd></div>
            {data.latestResult && (
              <>
                <div class="flex justify-between"><dt>result id:</dt><dd class="font-mono">{data.latestResult.id}</dd></div>
                <div class="flex justify-between"><dt>received_at:</dt><dd>{formatJpDate(data.latestResult.received_at)}</dd></div>
              </>
            )}
          </dl>
        </details>
      </main>
    </>
  )}
</BaseLayout>

<script is:inline>
  // PDF deep link: [pN] クリックでサーバラウンドトリップせず iframe を直接更新
  (function () {
    document.addEventListener('click', function (e) {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const a = target.closest('a.pdf-page-link');
      if (!a) return;
      const iframe = document.getElementById('result-pdf-iframe');
      if (!iframe) return; // iframe が無いタブ → 通常遷移
      const page = a.getAttribute('data-pdf-page');
      const base = iframe.getAttribute('data-pdf-base');
      if (!page || !base) return;
      e.preventDefault();
      iframe.setAttribute('src', base + '#page=' + page);
      iframe.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>
