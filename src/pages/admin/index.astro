---
import AppIcon from '../../components/AppIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notFoundForNonAdmin } from '../../lib/admin-auth';
import { resolveViewer } from '../../lib/viewer';

export const prerender = false;

const url = new URL(Astro.request.url);
const u = url.searchParams.get('u');
// admin 判定は Cookie の本人で行う (`?u=` を admin uid にしただけでは通らない)。
const viewer = await resolveViewer(Astro);
const allowed = viewer.isAdmin;
const uid = viewer.uid;
if (!allowed) {
  return notFoundForNonAdmin();
}
const qs = `?u=${encodeURIComponent(uid!)}`;
---

<BaseLayout title="管理画面 | Scan-Chat AI">
  <header class="hero-gradient px-5 pt-6 pb-4">
    <div class="flex items-center justify-between">
      <a href={`/${qs}`} class="text-xs text-slate-500 hover:text-slate-700">‹ メニュー</a>
      <p class="text-xs font-medium uppercase tracking-wider text-red-600/80">ADMIN</p>
      <span class="w-10"></span>
    </div>
    <h1 class="mt-3 text-xl font-bold tracking-tight"><AppIcon name="settings" size={20} /> 管理画面</h1>
    <p class="mt-1 text-xs text-slate-600">
      ウェルフォート関係者向け管理機能
    </p>
  </header>

  <main class="flex flex-1 flex-col gap-3 px-5 pb-8">
    <a
      href={`/admin/lab-results/upload${qs}`}
      class="card flex items-center gap-4 transition hover:-translate-y-0.5"
    >
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-status-watch text-white text-xl">
        <AppIcon name="upload" size={20} />
      </div>
      <div class="flex-1">
        <h2 class="text-base font-semibold">検査結果アップロード</h2>
        <p class="text-xs text-slate-600">
          PDF / CSV を一括アップロードして Scan-Chat AI に取り込み
        </p>
      </div>
      <span aria-hidden class="text-slate-400">›</span>
    </a>

    <a
      href={`/admin/transcosmos-reports${qs}`}
      class="card flex items-center gap-4 transition hover:-translate-y-0.5"
    >
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600 text-white text-xl">
        <AppIcon name="upload" size={20} />
      </div>
      <div class="flex-1">
        <h2 class="text-base font-semibold">トランスコスモス10名 報告書 一括登録</h2>
        <p class="text-xs text-slate-600">
          完成済みの AI疾病予防報告書 PDF が入った ZIP を 1 個選ぶだけ
        </p>
      </div>
      <span aria-hidden class="text-slate-400">›</span>
    </a>

    <div class="card text-center text-xs text-slate-500">
      <p>その他の管理機能は順次追加予定</p>
    </div>

    <p class="mt-4 text-center text-xs text-slate-400">
      この画面は管理者専用です
    </p>
  </main>
</BaseLayout>
