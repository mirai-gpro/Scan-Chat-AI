---
/**
 * **admin: 人間ドック 1 件 → 派生 blood（人が押す口）。**
 *
 * 正本: `docs/specs/healthcheckup_blood_extraction_spec_20261001.md` §10.6。
 * 発注者指示 2026-10-02:「発注者に `ADMIN_API_KEY` を用意させて curl させる方式は採用しない。
 * Production secret は Vercel Runtime 内に保持する」。
 *
 * 【3 操作で終わる】開く（自動 DRY-RUN）→ PASS ならボタン 1 回 → Dashboard を見る。
 *
 * 【処理は書かない】`runDerivedBloodBackfillOne()`（`src/lib/derived-blood-backfill.ts`）
 * を呼ぶだけ。その中身も `extractBloodSubset()` / `persistDerivedBloodArtifact()` /
 * `checkFormatsReady()` / `getMeasurementTrend()` という**既存の実装済み関数**。
 *
 * 【対象は固定】uid / 受診日の入力欄を作らない。別ユーザー・別日へ変更できる UI も作らない。
 *
 * 認可 = 既存 admin 画面と同じ `resolveViewer` + `viewer.isAdmin` + `notFoundForNonAdmin()`。
 * **`ADMIN_API_KEY` はブラウザへ出さない**（APPLY は Cookie で同一 origin POST する）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notFoundForNonAdmin } from '../../lib/admin-auth';
import { resolveViewer } from '../../lib/viewer';
import {
  runDerivedBloodBackfillOne, evaluateDryRun, FIXED_TARGET,
  EXPECTED_ITEMS, EXPECTED_ABSENT,
} from '../../lib/derived-blood-backfill';

export const prerender = false;

Astro.response.headers.set('cache-control', 'no-store, max-age=0');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');

const viewer = await resolveViewer(Astro);
if (!viewer.isAdmin) return notFoundForNonAdmin();

const UID = FIXED_TARGET.uid;
const DATE = FIXED_TARGET.testDate;

/** 開いた時点で DRY-RUN。**DB は変更しない**（`apply` を渡していない = 既定 false）。 */
const r = await runDerivedBloodBackfillOne({ diagnosticUserId: UID, testDate: DATE });
const dryRun = r.ok ? r.dryRun : r.dryRun ?? null;
const evaluated = dryRun ? evaluateDryRun(dryRun) : null;
const dryRunPass = !!evaluated?.pass && r.ok;
const errorLine = r.ok ? null : `${r.error}${r.detail ? ` — ${r.detail}` : ''}`;

/** 署名入りの本人表示はしない。**`?u=` を組み立てない**（認可を迂回しない）。 */
const viewerIsSubject = (viewer.uid ?? '').toLowerCase() === UID;

const mono = 'font-mono text-xs break-all';
---

<BaseLayout title="人間ドック → 派生血液データ (管理) | Scan-Chat AI">
  <main class="flex flex-1 flex-col gap-4 px-5 py-6">
    <header>
      <p class="text-xs font-medium uppercase tracking-wider text-red-600/80">ADMIN</p>
      <h1 class="mt-1 text-xl font-bold tracking-tight">人間ドック → 派生血液データ</h1>
      <p class="mt-1 text-xs text-slate-600">
        保存済みの人間ドック・健康診断の読み取り結果から、血液検査 15 項目を抽出して
        血液データとして反映します。**AI スキャンの再解析はしません**（既存の読み取り結果だけを使います）。
      </p>
    </header>

    <section class="card">
      <h2 class="text-sm font-semibold">対象（固定）</h2>
      <dl class="mt-2 grid grid-cols-[auto,1fr] gap-x-3 gap-y-1 text-xs">
        <dt class="text-slate-500">diagnostic_user_id</dt><dd class={mono}>{UID}</dd>
        <dt class="text-slate-500">受診日</dt><dd class={mono}>{DATE}</dd>
        <dt class="text-slate-500">Supabase</dt><dd class={mono}>{r.supabase.host}（{r.supabase.project_ref}）</dd>
      </dl>
    </section>

    {errorLine && (
      <section class="card border border-red-300 bg-red-50">
        <h2 class="text-sm font-semibold text-red-800">停止</h2>
        <p class={`mt-1 text-red-900 ${mono}`}>{errorLine}</p>
      </section>
    )}

    <section class="card">
      <h2 class="text-sm font-semibold">DRY-RUN（開いた時点で実行済み・DB は変更していません）</h2>
      {dryRun && (
        <>
          <dl class="mt-2 grid grid-cols-[auto,1fr] gap-x-3 gap-y-1 text-xs">
            <dt class="text-slate-500">health_checkup</dt><dd class={mono}>{dryRun.health_checkup_count} 件（{dryRun.health_checkup_artifact_id}）</dd>
            <dt class="text-slate-500">元 measurements</dt><dd class={mono}>{dryRun.source_measurements} 件</dd>
            <dt class="text-slate-500">kept</dt><dd class={mono}>{dryRun.kept} 件</dd>
            <dt class="text-slate-500">excluded</dt><dd class={mono}>{dryRun.excluded.length} 件</dd>
            <dt class="text-slate-500">通常 blood</dt><dd class={mono}>{String(dryRun.normal_blood_exists)}</dd>
            <dt class="text-slate-500">derived active</dt><dd class={mono}>{dryRun.derived_active}</dd>
            <dt class="text-slate-500">derived superseded</dt><dd class={mono}>{dryRun.derived_superseded}</dd>
          </dl>

          <table class="mt-3 w-max min-w-full text-xs">
            <thead><tr class="border-b">
              <th class="px-2 py-1 text-left">#</th><th class="px-2 py-1 text-left">項目</th>
              <th class="px-2 py-1 text-right">値</th><th class="px-2 py-1 text-right">期待値</th>
              <th class="px-2 py-1 text-left">一致</th>
            </tr></thead>
            <tbody>
              {dryRun.items.map((it, i) => {
                const exp = EXPECTED_ITEMS[i];
                const okRow = !!exp && it.name === exp[0] && Number(it.value_num) === exp[1];
                return (
                  <tr class="border-b border-slate-100">
                    <td class="px-2 py-1">{i + 1}</td>
                    <td class="px-2 py-1 whitespace-nowrap">{it.name}</td>
                    <td class="px-2 py-1 text-right whitespace-nowrap">{it.value}{it.unit ? ` ${it.unit}` : ''}</td>
                    <td class="px-2 py-1 text-right whitespace-nowrap">{exp ? `${exp[0]} / ${exp[1]}` : '-'}</td>
                    <td class="px-2 py-1">{okRow ? 'OK' : 'NG'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>

          <p class="mt-2 text-xs text-slate-500">
            今回入らなかった項目（**行を作りません。0 を入れません**）:
            <span class={mono}>{dryRun.absent_items.join(' / ') || 'なし'}</span>
            <br />想定していた欠損: <span class={mono}>{EXPECTED_ABSENT.join(' / ')}</span>
          </p>

          <ul class="mt-3 space-y-1 text-xs">
            {evaluated?.checks.map((c) => (
              <li>
                <span class={c.ok ? 'text-brand-700' : 'text-red-700'}>{c.ok ? 'PASS' : 'FAIL'}</span>
                {' '}{c.label}{c.detail ? ` — ${c.detail}` : ''}
              </li>
            ))}
          </ul>
        </>
      )}
      <p class={`mt-3 text-base font-bold ${dryRunPass ? 'text-brand-700' : 'text-red-700'}`}>
        {dryRunPass ? 'DRY-RUN PASS' : 'DRY-RUN FAIL'}
      </p>
    </section>

    <section class="card">
      <h2 class="text-sm font-semibold">反映</h2>
      {!dryRunPass && (
        <p class="mt-2 text-xs text-red-700">DRY-RUN FAIL のためボタンを出しません。</p>
      )}
      {dryRunPass && (
        <>
          <p class="mt-1 text-xs text-slate-600">
            押すと <span class={mono}>{DATE}</span> の血液データを 1 件作成します。
            既に反映済みなら作り直さず止まります。
          </p>
          <button id="apply-btn" type="button"
            class="mt-3 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white disabled:opacity-50"
            data-uid={UID} data-date={DATE}>
            {DATE} の人間ドック血液データを反映
          </button>
          <p id="apply-state" class="mt-2 text-xs text-slate-600" aria-live="polite"></p>
          <dl id="apply-summary" class="mt-3 hidden grid-cols-[auto,1fr] gap-x-3 gap-y-1 text-xs"></dl>
          <div id="apply-next" class="mt-3 hidden text-xs">
            <p class="font-semibold">Dashboard を確認</p>
            <ul class="mt-1 list-disc pl-5">
              <li><a class="text-brand-700 underline" href="/dashboard">ダッシュボード</a></li>
              <li><a class="text-brand-700 underline" href="/trend?type=blood">血液検査の推移グラフ</a></li>
            </ul>
            {!viewerIsSubject && (
              <p class="mt-2 text-slate-600">
                いまサインインしているのは対象者本人ではありません。対象者の画面は
                <strong>既存の代理表示の導線</strong>（Wellfort 管理画面）から開いてください。
                この画面では <code>?u=</code> を組み立てません（認可を迂回しないため）。
              </p>
            )}
          </div>
          <pre id="apply-raw" class="mt-3 hidden max-h-80 overflow-auto rounded bg-slate-100 p-2 font-mono text-[11px]"></pre>
        </>
      )}
    </section>
  </main>

  <script>
    /*
     * APPLY は **同一 origin の POST**（Cookie 認証）。`ADMIN_API_KEY` はブラウザに無い。
     * 二重送信を防ぐためボタンは押した時点で無効化し、成功後も戻さない。
     */
    const btn = document.getElementById('apply-btn') as HTMLButtonElement | null;
    const state = document.getElementById('apply-state');
    const summary = document.getElementById('apply-summary');
    const next = document.getElementById('apply-next');
    const raw = document.getElementById('apply-raw');

    function row(label: string, value: string): string {
      const dt = document.createElement('dt');
      dt.className = 'text-slate-500';
      dt.textContent = label;
      const dd = document.createElement('dd');
      dd.className = 'font-mono text-xs break-all';
      dd.textContent = value;
      return dt.outerHTML + dd.outerHTML;
    }

    btn?.addEventListener('click', async () => {
      if (!btn || btn.disabled) return;
      btn.disabled = true;
      if (state) state.textContent = '反映しています…';
      try {
        const res = await fetch('/api/admin/derived-blood/backfill-one', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            diagnosticUserId: btn.dataset.uid, testDate: btn.dataset.date, apply: true,
          }),
        });
        const j = await res.json();
        if (raw) { raw.textContent = JSON.stringify(j, null, 2); raw.classList.remove('hidden'); }
        if (!res.ok || !j?.ok) {
          if (state) state.textContent = `停止しました（HTTP ${res.status} / ${j?.error ?? 'unknown'}）。再実行しません。`;
          return;
        }
        const a = j.applied ?? {};
        const art = a.artifact ?? {};
        const ready = a.readiness_blood_ready;
        if (summary) {
          summary.innerHTML = [
            row('derived_artifact_id', String(a.derived_artifact_id ?? '-')),
            row('test_type', String(art.test_type ?? '-')),
            row('test_date', String(art.test_date ?? '-')),
            row('source', String(art.source ?? '-')),
            row('imported_by', String(art.imported_by ?? '-')),
            row('status', String(art.status ?? '-')),
            row('measurement_values', String(a.measurement_values_count ?? '-')),
            row('value_num=0 rows', String(a.measurement_values_zero_rows ?? '-')),
            row('health_checkup unchanged', a.health_checkup_unchanged ? 'PASS' : 'FAIL'),
            row('readiness blood ready', String(ready)),
            row('trend hit', String(a.trend?.hit ?? '-')),
            row('trend derived', String(a.trend?.derived ?? '-')),
            row('demo fallback', String(a.demo_fallback)),
          ].join('');
          summary.classList.remove('hidden');
          summary.classList.add('grid');
        }
        if (ready === true) {
          // **異常**。ここで止める（本番 cron が BloodTestData 到着済みと誤認する状態）。
          if (state) state.textContent = '異常: readiness が true です。ここで停止してください。';
          return;
        }
        if (state) state.textContent = '反映しました。';
        next?.classList.remove('hidden');
      } catch (e) {
        if (state) state.textContent = `通信に失敗しました（${e instanceof Error ? e.message : String(e)}）。再実行しません。`;
      }
    });
  </script>
</BaseLayout>
