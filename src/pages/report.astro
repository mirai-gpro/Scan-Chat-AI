---
import AppIcon from '../components/AppIcon.astro';
import BackToDashboard from '../components/BackToDashboard.astro';
import AppNav from '../components/AppNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadReportVM, previewVM } from '../lib/elith-report-queries';
import { renderReportMarkdown } from '../lib/report-view';
import { chapterAnchor } from '../lib/report-sections';
import { applySaveStepOverrides } from '../lib/save-steps';
import { countUnreadImportant } from '../lib/notice-queries';
import { refreshConfig, cfg } from '../lib/app-config';
import { loadDashboard, getHealthAge, withHonorific, formatJpDate } from '../lib/dashboard-queries';
import { AI_PREVENTION_REPORT_LABEL } from '../lib/display-names';
import { WELLNESS_AGE_LABEL } from '../lib/wellness-age';
import { resolveViewer } from '../lib/viewer';
import { noStore } from '../lib/http-cache';

/**
 * AI疾病予防報告書 — 受領 JSON からアプリが生成する報告書。
 *
 * 正本: docs/elith/AI疾病予防報告書_仕様書.md  ※ § 番号は旧版 docs/旧版・ボツ/ai_prevention_report_generation_spec.md
 *
 * 【この画面の役割は可読化だけ】(spec §1.1)
 *   Elith の出力は文章の羅列で読み通せない。**出す文を選んで構造に置く**ことで読ませる。
 *   要約・言い換え・当社の散文の追加はしない (spec §1.0.0)。実測: 受領本文 20,046 字に対し
 *   最初に読む面 (ダイジェスト) は 1,567 字 = 92.2% 減。全文は下の「全編」に畳んで置く。
 *
 * 【章を直書きしない】(spec §1.3.2 / §1.3.5)
 *   構成は `report-sections.ts` のレジストリと `app_config` が決め、この画面は
 *   表示モデル (`report-model.ts`) を回すだけ。**章を足したら印刷ビューにも自動で載る。**
 *
 * 【`?print=1` は別実装ではなくモード引数】(spec §4.4)
 *   iOS の「共有 → PDF」は `@media print` を通らないため、印刷 CSS に依存した設計は採れない。
 *   全展開・UI なしを**通常の画面 CSS で**出し、`@media print` は上乗せに留める。
 */
export const prerender = false;

// Cookie で個人化される SSR ページ: 共有キャッシュに保存させない
noStore(Astro.response);

const url = new URL(Astro.request.url);
// 入場は Cookie で本人を判定する (`src/lib/viewer.ts`)。`?u=` は admin の代理表示のみ。
const viewer = await resolveViewer(Astro);
/**
 * デモ表示の可否は**閲覧している本人が admin か**で決まる (spec §4.6)。
 * **代理表示中 (`?u=` で他人を見ている) は渡さない** — 相手の実データを見せるため。
 */
const u = viewer.uid;
/** 印刷/PDF 用ビュー。全展開・UI なし。 */
const isPrint = url.searchParams.get('print') === '1';
/*
 * `?print=1&autoprint=1` … **印刷ダイアログを自動で開く**紙面 (spec §4.4 案 3)。
 * PC で「PDF にして保存する」を押したときだけこの URL へ送り、手順を読ませずに
 * 1 クリックで保存へ入れる。スマホには付けない — Apple/Google が案内している経路は
 * ブラウザのメニュー側で、印刷ダイアログを通らないため。
 * **紙面の中身は `?print=1` と 1 文字も変わらない** (開くのはブラウザの仕事)ので、
 * ここでは分岐を持たず、下の `<script>` が `location.search` を見て `print()` を呼ぶ。
 */
/*
 * **紙面のタイプを切り替えて確認するモード** (テストフェーズ限定・発注者指示 2026-09-01)。
 * `?preview=1` / `?preview=2` で、受領 JSON から組んだ紙面をタイプ別に見る。
 * **モックではなく本番のアダプタ・本番のレンダラを通した出力**を見せる
 * (紙面の正はモックだが、実装が何を出しているかはここで見る)。
 * 値が無い・不正なときは 1 (既定はタイプ1)。入口は `/dashboard` のデバッグ欄で、
 * **デバッグ欄を遮蔽するときに一緒に閉じる。**
 */
const previewParam = url.searchParams.get('preview');
const previewType: 1 | 2 | null =
  previewParam == null ? null : previewParam === '2' ? 2 : 1;

const authEnabled = !!import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
const needsSignIn = authEnabled && !u;

/*
 * **app_config はデータ取得より前に読み込む。**
 * デモ用アカウントの一覧 (`demo.account_uids`) をここから引くため、
 * 後ろに置くと初回リクエストで admin の登録が効かない (コード既定に落ちる)。
 */
await refreshConfig();
const result = needsSignIn ? null : await loadDashboard(u, viewer.origin);
const data = !result || 'error' in result ? null : result;
const unreadNotices = data ? await countUnreadImportant(data.diagnosticUserId) : 0;

const supportContact = cfg('ui.support_contact');
/**
 * 「手元に残す」の端末別 手順 (spec §4.4)。
 * **OS の更新でメニュー名が変わる**ので、語だけなら `ui.save_steps` で admin から直せる。
 */
const saveGuides = applySaveStepOverrides(cfg('ui.save_steps') ?? '');

/**
 * CSS の `content` に置く文字列。**引用符と改行だけを潰す** (中身は変えない)。
 */
const cssStr = (v: string): string =>
  '"' + v.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\s+/g, ' ').trim() + '"';

const healthAge = data ? await getHealthAge(data.diagnosticUserId) : null;

/**
 * その回の入力にがんリスク検査があったか (spec §1.0.3)。**アプリが判定する。**
 * 見つかればその結果ページへ送れるので、主軸 A の導線もここから決まる。
 */
/*
 * その回の入力にがんリスク検査があったか (spec §1.0.3)。**アプリが判定する。**
 * 見つかればその結果ページへ送れるので、主軸 A の導線もここから決まる。
 *
 * **サンプル表示のときはこれでタイプを決めない** (2026-08-30)。判定は
 * `elith-report-queries.ts` の `sample()` に置いてある — 紙面の材料を選ぶ場所と
 * タイプを決める場所は同じでなければ食い違う (詳細はそのコメント)。
 */
const cancerArtifact = (data?.artifacts ?? []).find((a) => a.test_type === 'cancer_urine') ?? null;

/** 表示モデルの入力。**プレビューと本番で同じものを渡す** (二重に書かない)。 */
const reportCtx = {
  diagnosticUserId: data?.diagnosticUserId ?? null,
  name: data?.appUser?.display_name_cache ? withHonorific(data.appUser.display_name_cache) : 'お客様',
  chronologicalAge: healthAge?.latest?.chronologicalAge ?? null,
  ourWellnessAge: healthAge?.latest?.biologicalAge ?? null,
  // タイプ判定はアプリが持つ (spec §1.0.3)。Elith 出力から推測しない。
  hasCancerRisk: !!cancerArtifact,
  cycleSeq: data?.subscription?.current_cycle_seq ?? null,
};

const vm = previewType != null
  ? previewVM(reportCtx, previewType)
  : await loadReportVM(reportCtx);

/**
 * **走りフッター (見本 全ページ下の帯) とページ番号。**
 *
 * `@page` の**マージンボックス**に置く。ページ番号は `counter(page)` / `counter(pages)` で、
 * ブラウザが数えた実際のページ数なので**採番の捏造にならない**
 * (以前「CSS だけでは採番できない」として入れていなかったが、実測で組めることを確認した)。
 *
 * - **表紙だけ番号を出さない**。見本 p1 も帯を持たない。
 * - **未対応のブラウザでは帯ごと出ない**が、`@page` の余白は効くので紙面は崩れない。
 *   作成日と版は表紙に印字してあるので (spec §4.4)、そこが欠けることもない。
 * - 氏名は**本人の紙面**にしか出ない (PII 分離は外部への受け渡しの話・spec §1.0.2)。
 */
/** 走りフッターの書体。和文の受け皿を明示する (既定任せにしない)。 */
const FOOT_FONT = 'font-family: system-ui, "BIZ UDGothic", "Hiragino Sans", "Noto Sans JP",'
  + ' "Yu Gothic UI", sans-serif; font-size: 9pt; color: #55636A;';
const footLeft = cssStr(`${AI_PREVENTION_REPORT_LABEL}｜${vm.cover.name}`);
const footRight = cssStr(formatJpDate(vm.cover.issuedOn) || vm.cover.issuedOn);
const pageCss = `
@page {
  size: A4;
  /* 左右は紙面側の余白 (.rp-inner の 8.1%) が持つので 0。上下だけここで確保する。 */
  margin: 16mm 0 14mm;
}
/* 表紙は teal の帯を紙の端まで出す (見本 p1)。 */
@page :first { margin-top: 0; }

/*
 * 走りフッターとページ番号は**別の @page 規則に分ける**。
 * マージンボックス未対応のブラウザではこの塊だけが捨てられ、
 * 上の余白指定は生き残る (帯が出ないだけで紙面は崩れない)。
 */
@page {
  /* 帯には氏名 (和文) が入る。**和文の受け皿を明示する** — 既定任せにすると
     環境によって中国語フォントに落ちる (2026-09-03 の実測)。 */
  @bottom-left   { content: ${footLeft};  ${FOOT_FONT} margin-left: 8.1%; }
  @bottom-center { content: counter(page) " / " counter(pages); ${FOOT_FONT} }
  @bottom-right  { content: ${footRight}; ${FOOT_FONT} margin-right: 8.1%; }
}
/* 表紙には番号も帯も振らない (見本 p1 も帯を持たない)。 */
@page :first {
  @bottom-left { content: ""; }
  @bottom-center { content: ""; }
  @bottom-right { content: ""; }
}
`;

const q = (extra: Record<string, string>) => {
  const p = new URLSearchParams();
  if (u) p.set('u', u);
  for (const [k, v] of Object.entries(extra)) p.set(k, v);
  const s = p.toString();
  return s ? `/report?${s}` : '/report';
};

/*
 * 冒頭の数直線 (`?print=1` のみ)。**ダッシュボードの `HealthAgeCard.astro:47-62,101-136` から
 * レイアウトを移植したもの** (発注者指示 2026-08-30「見本の横並びは尊重しつつ、その下に
 * ダッシュボードのバーグラフ表示のレイアウトを移植」)。
 *
 * 【出すのは 2 値と目盛りだけ】判定のゾーン塗り分けはしない・差の解釈文も添えない
 *   (ミッション④ / 紙面の散文は受領 JSON の逐語だけ・spec §4.1)。
 * 【目盛りは 30〜80 歳固定】値がその外に出る検体でも切れないよう 10 歳単位で**外側にだけ**
 *   広げる (狭めない = 回によって物差しが伸縮しない)。
 * 【値は紙面と同じ回のもの】ウェルネス年齢は **Elith 受領値** (`vm.cover.wellnessAge`)、
 *   実年齢は当社 `health_age_scores`。ダッシュボードが出す当社 CABA 値を持ち込まない
 *   (「ウェルネス年齢は Elith 出力の値のみ表示・併記しない」)。
 */
const GAUGE_STEP = 10;
const gWell = vm.cover.wellnessAge;
const gAge = vm.cover.chronologicalAge;
/**
 * 2 値が揃った回だけ描く。片方でも欠けたら数直線を出さない (位置を作らない = 捏造ゼロ)。
 * **画面と PDF の両方に出す** — 裁定 D-C2 の見直し (発注者指示 2026-09-01)。
 */
const showGauge = gWell != null && gAge != null;
const gLo = Math.min(30, Math.floor(Math.min(gWell ?? 30, gAge ?? 30) / GAUGE_STEP) * GAUGE_STEP);
const gHi = Math.max(80, Math.ceil(Math.max(gWell ?? 80, gAge ?? 80) / GAUGE_STEP) * GAUGE_STEP);
const gTicks: number[] = [];
for (let v = gLo; v <= gHi; v += GAUGE_STEP) gTicks.push(v);
const gPos = (v: number) => ((v - gLo) / (gHi - gLo)) * 100;
const gWellPos = gWell != null ? gPos(gWell) : 0;
const gAgePos = gAge != null ? gPos(gAge) : 0;
const gBandLeft = Math.min(gWellPos, gAgePos);
const gBandWidth = Math.abs(gAgePos - gWellPos);

/** 軸の下に並べるカード。**冒頭に出すもの (lead) は除く** (見本 p1 の並び)。 */
const digestByAxis = (axis: 'a' | 'b') => vm.digest.filter((c) => c.axis === axis && !c.lead);
/**
 * 冒頭 (ウェルネス年齢の次) に置く総括。見本 p1 は 2 連大数字のすぐ下に散文を流す。
 * **カードの枠を付けず、見出しも付けない** — 見本のとおり本文がそのまま続く。
 */
const leadCard = vm.digest.find((c) => c.lead) ?? null;
const chaptersByAxis = (axis: 'a' | 'b') => vm.chapters.filter((c) => c.axis === axis);
---

{/*
  幅は**ダッシュボードと同じ `app`** (発注者指示 2026-08-29)。この画面はダッシュボードの
  タイルから来るので、`flow` (lg 以上で 672px 止まり) だと PC・タブレットで直前の画面より
  急に狭くなる。**長文の行長は器ではなく本文側で 38em に止める** (`.report-prose`) ので、
  器を広げても和文 1 行が 90 字に伸びることはなく、表だけが広い幅を使える。
*/}
<BaseLayout title={`${AI_PREVENTION_REPORT_LABEL} | Welltect`} width="app">
  {!isPrint && (
    <AppNav u={u} current="/report" unreadNotices={unreadNotices} supportContact={supportContact} />
  )}

  {/* 紙に押せないボタンを印字しないので `?print=1` では出さない (spec §4.9 と同じ扱い)。 */}
  {!isPrint && (
    <div class="px-5 pt-4">
      <BackToDashboard u={u} />
    </div>
  )}

  {/*
    ══ 紙面 (白いシート)【発注者裁定 2026-08-30】══
    **幅はダッシュボードと同じ。紙面の器だけ見本から採る。**
    `.rp-sheet` に `max-width` を置かないので、器 (BaseLayout `width="app"`) の幅まで
    広がる — **モックの 44rem 固定は採らない**(発注者指示)。
    白地・上部 teal ルール・本文左右 8.1%・地に浮く見え方は見本どおり。
    長文の行長は器でなく本文側で 38em に止める (`.report-prose`)。
    詳細は `global.css` の `.rp-sheet` と 仕様書 §4.3.5。
  */}

  {/* 走りフッターとページ番号 (`@page` のマージンボックス)。SSR で氏名と作成日を埋めるため
    `is:inline` の style で出す — Astro の通常の <style> は静的な値しか持てない。 */}
<style is:inline set:html={pageCss}></style>

<main class={`report-sheet rp-sheet ${isPrint ? 'rp-plain' : ''}`}>

    {/* ══════════ ① 表紙 (見本 p1) ══════════
        見本の表紙は 上端 teal ルール / 淡色パネル / 右上の円モチーフ / タイトル /
        Powered by 行と細罫 / 氏名 / メタ の順。**要素の順序と装飾だけを写す**もので、
        中身 (氏名・作成日・第 N 回) はアプリのデータ (仕様書 §4.3)。 */}
    <header class="rp-cover">
      <h1 class="text-[1.75rem] font-bold leading-tight tracking-tight text-navy-800 sm:text-[2rem]">
        {AI_PREVENTION_REPORT_LABEL}
      </h1>
      <p class="rp-brandline mt-2 font-mono text-xs tracking-[0.14em] text-brand-700">
        Powered by Welltect AI Health Analysis
      </p>
      <p class="mt-5 text-lg font-bold text-navy-800">{vm.cover.name}</p>
      <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-600">
        <span>作成日 {formatJpDate(vm.cover.issuedOn) || vm.cover.issuedOn}</span>
        <span>紙面 {vm.cover.sheetVersion}</span>
        {vm.cover.testedOn && <span>検査 {formatJpDate(vm.cover.testedOn)}</span>}
        {vm.cover.cycleSeq && <span>第 {vm.cover.cycleSeq} 回 / 全 {vm.cover.cycleTotal} 回</span>}
      </p>

      {vm.isSample && !isPrint && (
        <p class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-sm text-amber-800">
          <AppIcon name="info" size={14} />
          サンプル表示（受取仕様の確定前）
        </p>
      )}
    </header>

    {/* 本文。左右マージン 8.1% は `.rp-inner` が持つ (見本の本文左端) */}
    <div class="rp-inner">

    {/* ══════════ ② 2 連の大数字カード (見本 p1) ══════════
        【裁定 D-C2 の見直し・発注者指示 2026-09-01】**画面にも出す。**
        以前は「ダッシュボード上部で表示済みだから画面版には出さない」としていたが、
        **画面と PDF で紙面が違うことの違和感**の方が大きい、という判断
        (「画面とPDFで表示が違う違和感があるので、画面HTMLでも冒頭はウェルネス年齢の
        セクションを再表示させて」)。以後、②と数直線は**画面・PDF 共通**。 */}
    {vm.cover.wellnessAge != null && (
      <div class="rp-nums">
        <div class="rp-num">
          <b class="block font-mono text-[2.4rem] font-medium leading-none text-brand-700">
            {vm.cover.wellnessAge}
          </b>
          <span class="mt-2 block text-sm text-slate-800">{WELLNESS_AGE_LABEL}</span>
        </div>
        <div class="rp-num">
          <b class="block font-mono text-[2.4rem] font-medium leading-none text-slate-700">
            {vm.cover.chronologicalAge ?? '—'}
          </b>
          <span class="mt-2 block text-sm text-slate-800">実年齢</span>
        </div>
      </div>
    )}

    {/* ══════════ ②の下: 実年齢との比較を数直線で ══════════
        発注者指示 2026-08-30「見本の横並びは尊重しつつ、その下にダッシュボードの
        バーグラフ表示のレイアウトを移植」。**見本 p1 の 2 連大数字はそのまま**で、
        その下にダッシュボード (`HealthAgeCard.astro`) の数直線を移植した。
        **画面・PDF の両方に出す** (裁定 D-C2 の見直し・2026-09-01)。 */}
    {showGauge && (
      <div
        class="rp-gauge px-2"
        role="img"
        aria-label={`${WELLNESS_AGE_LABEL} ${gWell} 歳、実年齢 ${gAge} 歳。目盛りは ${gLo} 歳から ${gHi} 歳。`}
      >
        <div class="relative h-7">
          <span
            class="tnum absolute bottom-0 -translate-x-1/2 whitespace-nowrap text-sm font-bold text-brand-700"
            style={`left:${gWellPos.toFixed(2)}%`}
          >{`${WELLNESS_AGE_LABEL} ${gWell}`}</span>
        </div>
        <div class="rp-gauge-track relative h-4 rounded-full">
          {gTicks.slice(1, -1).map((v) => (
            <span class="rp-gauge-tick absolute inset-y-0 w-px" style={`left:${gPos(v).toFixed(2)}%`}></span>
          ))}
          <span
            class="rp-gauge-band absolute inset-y-0"
            style={`left:${gBandLeft.toFixed(2)}%;width:${gBandWidth.toFixed(2)}%`}
          ></span>
          <span
            class="rp-gauge-dot rp-gauge-dot-well absolute top-1/2 -ml-2 -mt-2 h-4 w-4 rounded-full"
            style={`left:${gWellPos.toFixed(2)}%`}
          ></span>
          <span
            class="rp-gauge-dot rp-gauge-dot-age absolute top-1/2 -ml-2 -mt-2 h-4 w-4 rounded-full"
            style={`left:${gAgePos.toFixed(2)}%`}
          ></span>
        </div>
        <div class="relative mt-1.5 h-11">
          {gTicks.map((v) => (
            <span class="tnum absolute -translate-x-1/2 text-sm text-slate-600" style={`left:${gPos(v).toFixed(2)}%`}>{v}</span>
          ))}
          <span
            class="tnum absolute top-5 -translate-x-1/2 whitespace-nowrap text-sm font-bold text-slate-700"
            style={`left:${gAgePos.toFixed(2)}%`}
          >実年齢 {gAge}</span>
        </div>
      </div>
    )}

    {/* ══════════ 冒頭の総括 (見本 p1) ══════════
        見本は 2 連大数字のすぐ下に総括の散文を置く。アブストラクトを**全文そのまま**
        ここに出す (発注者指示 2026-09-03)。**全編からは外してある**ので二重に出ない。
        見出しも枠も付けない — 見本 p1 と同じく本文がそのまま流れる。 */}
    {leadCard && (
      <section class="flex flex-col gap-2.5">
        {leadCard.blocks.map((block) => (
          <>
            {block.kind === 'paragraphs' && block.items.map((t) => (
              <p class="report-prose text-base leading-relaxed text-slate-800">{t}</p>
            ))}
          </>
        ))}
        <p class="mt-0.5 font-mono text-[13px] text-slate-600">{leadCard.source}</p>
      </section>
    )}

    {/* ══════════ 2 本柱 × ダイジェスト ══════════
        軸の帯は**常設**。材料が無い回でも消さない (spec §4.-1)。
        帯が持つのは見出しだけで、ポリシーの説明文は紙面に載せない。
        ⑤ 章扉 = 淡 teal 地 + 丸バッジ + 見出し (見本 p2/p9)。 */}
    {vm.axes.map((axis) => (
      <section class="flex flex-col gap-4">
        <div class="rp-axis mt-2 flex items-center gap-3 px-4 py-3">
          <span class="rp-badge">{axis.key === 'a' ? 'A' : 'B'}</span>
          <h2 class="text-lg font-bold leading-snug text-navy-800">{axis.title}</h2>
        </div>

        {digestByAxis(axis.key).map((card) => (
          <article class={`rp-card flex flex-col gap-2.5 ${
            card.tone === 'emergency' ? 'rp-er px-4 py-3.5' : ''
          }`}>
            {card.tone === 'emergency' && (
              <p class="inline-flex w-fit items-center gap-1.5 text-xs font-semibold text-status-action">
                <AppIcon name="error" size={14} />すぐ受診
              </p>
            )}
            {card.title && (
              <h3 class="rp-h3 text-base font-bold leading-snug text-navy-800">{card.title}</h3>
            )}

            {card.blocks.map((block) => (
              <>
                {block.kind === 'paragraphs' && block.items.map((t) => (
                  <p class="report-prose text-base leading-relaxed text-slate-800">{t}</p>
                ))}

                {/* ⑪ 箇条書き — marker は teal (見本 p3) */}
                {block.kind === 'steps' && (
                  <ol class="ml-5 flex list-decimal flex-col gap-2 text-base marker:font-semibold marker:text-brand-600">
                    {block.items.map((s) => (
                      <li>
                        <b class="text-navy-800">{s.heading}</b>
                        <span class="report-prose mt-0.5 block leading-relaxed text-slate-800">{s.text}</span>
                      </li>
                    ))}
                  </ol>
                )}

                {/* ⑩ 横テーブル — teal ヘッダ・白抜き・ゼブラなし (見本 p9/p12/p17) */}
                {block.kind === 'table' && (
                  <div class="-mx-1 overflow-x-auto">
                    <table class="rp-table text-sm">
                      <thead>
                        <tr>
                          <th>項目</th>
                          <th>今回</th>
                          <th>基準値</th>
                          <th>判定</th>
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((r) => (
                          <tr>
                            <td>
                              {r.name}
                              {/* 2 ファイルは包含関係でないので、本文にしかない値も載せる (spec §7.2)。 */}
                              {r.source === 'report_text' && (
                                <span class="ml-1 rounded bg-slate-100 px-1 text-[11px] text-slate-600">本文</span>
                              )}
                              {r.variants > 1 && (
                                <span class="ml-1 rounded bg-amber-50 px-1 text-[11px] text-amber-800">
                                  {r.variants} 通り
                                </span>
                              )}
                            </td>
                            <td class="whitespace-nowrap font-mono tabular-nums">{r.value}</td>
                            <td class="whitespace-nowrap text-xs text-slate-600">{r.reference || '—'}</td>
                            {/* 判定は Elith の原文をそのまま。色だけで意味を伝えない (アイコン+テキスト+色)。 */}
                            <td class={`min-w-[11rem] text-xs leading-snug ${
                              r.tone === 'flagged' ? 'font-semibold text-status-watch'
                              : r.tone === 'within' ? 'text-status-ok' : 'text-slate-500'
                            }`}>
                              {r.judgement || '—'}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                {/* ⑨ 左ラベル型テーブル (見本 p3/p6) — 現状評価 / 行動提案 */}
                {block.kind === 'pairs' && (
                  <div class="flex flex-col gap-4">
                    {block.items.map((p) => (
                      <div>
                        <h4 class="mb-1.5 text-sm font-bold text-brand-700">{p.heading}</h4>
                        <div class="rp-lrow text-base">
                          <span class="rp-lkey">現状評価</span>
                          <span class="rp-lval report-prose leading-relaxed text-slate-800">{p.current}</span>
                        </div>
                        <div class="rp-lrow text-base">
                          <span class="rp-lkey">行動提案</span>
                          <span class="rp-lval report-prose leading-relaxed text-slate-800">{p.action}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {/* 週プラン (左ラベル型の応用) */}
                {block.kind === 'weeks' && (
                  <div class="flex flex-col">
                    {block.items.map((w) => (
                      <div class="rp-wrow text-base">
                        <b class="rp-wkey">{w.heading}</b>
                        <span class="rp-wval report-prose leading-relaxed text-slate-800">{w.text}</span>
                      </div>
                    ))}
                  </div>
                )}
              </>
            ))}

            {/* ══════════ 詳細への導線 ══════════
                【発注者裁定 2026-09-01・案 03「カード下端の淡色バー」】
                出典と操作を 1 つにまとめ、**カード幅いっぱいの押せる面**にする。
                主要利用者は 50〜65 代なので、下線だけの弱い導線にしない。
                地 `#F0FAFB` と枠 `#A8DCD8` は**どちらも見本にある色**(表紙のパネルと円)。

                **`?print=1` では出さない。** 紙に押せないボタンが印字されるため
                (保存手順を印刷ビューに置かないのと同じ理屈・spec §4.4)。
                **章が無い回は出さない** (`detailAnchor` が null)。押しても何も起きない
                リンクを置かない。そのときは従来どおり出典だけを出す。 */}
            {!isPrint && card.detailAnchor ? (
              <a class="rp-jump" href={`#${card.detailAnchor}`} data-jump>
                <span class="rp-jump-lbl">
                  <span>詳しい説明を読む</span>
                  <small class="font-mono">{card.source}</small>
                </span>
                <AppIcon name="next" size={18} class="shrink-0 text-brand-600" />
              </a>
            ) : (
              /* 13px 以上にする。11px は禁止事項「12px 以下を作らない」に触れていた。 */
              <p class="mt-0.5 font-mono text-[13px] text-slate-600">{card.source}</p>
            )}
          </article>
        ))}

        {/*
          主軸 A の導線 (spec §4.0.1「詳細はリンクで別画面へ送る」)。
          **その回にがんリスク検査があったときだけ出す。** 無い回 (タイプ 2) は送る先が
          存在しないので出さない — 押せば 404 になるリンクを置かない。
          A に材料が無い回でも帯は立つ。**アプリが代わりの所見を書かない** (spec §4.0.1)。
        */}
        {axis.key === 'a' && !vm.isSample && cancerArtifact && (
          <p class="px-1 text-sm text-slate-600">
            <a class="font-semibold text-brand-700 underline" href={`/result/${cancerArtifact.id}${u ? `?u=${u}` : ''}`}>
              がんリスク検査の結果を見る →
            </a>
          </p>
        )}

        {/*
          **軸が空でも当社の文で埋めない**【発注者裁定 D-C3・2026-08-29】
          「Elith の出力 JSON に無い文言・表現は使わない」。以前ここに当社の散文
          （「今回の受領分からは要点を取り出せませんでした」等）を置いていたが、
          裁定により撤去した。
          **黙って空になることの検知は紙面ではなく抽出監査で行う**（仕様書 §4.4 / §5.2）。
        */}
      </section>
    ))}

    {/* ══════════ 全編 ══════════
        ダイジェストで選ばれなかった文はここに全部ある。捨てていない。
        `?print=1` では**折りたたみを使わない** — 畳んだ状態が PDF に漏れると本文が欠ける
        (iOS の「共有 → PDF」は印刷 CSS を通らない・spec §4.4)。 */}
    {!!vm.chapters.length && (
      <section class="mt-4 flex flex-col gap-3">
        <h2 class="border-t border-slate-200 pt-5 text-lg font-bold text-navy-800">全編</h2>
        {(['a', 'b'] as const).flatMap((ax) => chaptersByAxis(ax)).map((ch) => (
          <details class="rp-card card" id={chapterAnchor(ch.key)} open={isPrint || !ch.collapsed}>
            <summary class={`cursor-pointer text-base font-bold text-navy-800 ${isPrint ? 'list-none' : ''}`}>
              {ch.title}
            </summary>
            <div class="md-region md-summary mt-3 flex flex-col gap-4">
              {ch.topics.map((t) => (
                <div id={t.anchor}>
                  {t.heading && <h3 class="rp-h3 text-base font-bold text-navy-800">{t.heading}</h3>}
                  <div set:html={renderReportMarkdown(t.body)} />
                </div>
              ))}

              {/* 受領した検査値の全行。ダイジェストは Elith が取り上げた 8 項目だけを出している。 */}
              {ch.table && !!ch.table.length && (
                <div class="overflow-x-auto">
                  <table class="rp-table text-sm">
                    <thead>
                      <tr>
                        <th>項目</th>
                        <th>今回</th>
                        <th>基準値</th>
                        <th>判定</th>
                      </tr>
                    </thead>
                    <tbody>
                      {ch.table.map((r) => (
                        <tr>
                          <td>
                            {r.name}
                            {r.source === 'report_text' && (
                              <span class="ml-1 rounded bg-slate-100 px-1 text-[11px] text-slate-600">本文</span>
                            )}
                            {r.variants > 1 && (
                              <span class="ml-1 rounded bg-amber-50 px-1 text-[11px] text-amber-800">
                                {r.variants} 通り
                              </span>
                            )}
                          </td>
                          <td class="whitespace-nowrap font-mono tabular-nums">{r.value}</td>
                          <td class="whitespace-nowrap text-xs text-slate-600">{r.reference || '—'}</td>
                          <td class="text-xs leading-snug text-slate-600">{r.judgement || '—'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </details>
        ))}
      </section>
    )}


    {/* ══════════ 手元に残す (spec §4.4 手段 A) ══════════
        **端末別に手順を出す** (発注者裁定 2026-09-02・案 1＋案 3)。
        以前は iPhone 1 機種ぶんの手順しか無く、PC にも同じ文が出ていた
        (PC に「共有ボタン」は無いので読んでも実行できない = テストユーザーの「分かり難い」)。

        **印刷ビューには置かない** — 手順そのものが保存された PDF に載るため。 */}
    {!isPrint && (
      <section class="mt-4 flex flex-col gap-3 border-t border-slate-200 pt-5" id="save-section">
        <h2 class="text-base font-bold text-navy-800">手元に残す</h2>

        {/* 押すもの (案 3)。**ボタンは 1 つ** — 以前は 2 つ並んでいてどちらを押すのか読めず、
            しかも「端末に保存する」を押しても保存されなかった (手順が出るだけ)。
            既定の飛び先は `?print=1` = **JavaScript が無くても成立する**。
            PC では下の script が `&autoprint=1` を足し、押した瞬間に印刷ダイアログが開く。 */}
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <a class="btn-pair border-brand-600 bg-brand-600 px-4 text-white hover:bg-brand-700"
             href={q({ print: '1' })} data-save-go>
            <AppIcon name="download" size={16} />PDF にして保存する
          </a>
          {/* 紙面だけ見たい人のために残す。ただし主役ではないので文字リンクに落とす。 */}
          <a class="text-[13px] text-brand-700 underline underline-offset-2" href={q({ print: '1' })}>
            印刷用の紙面をひらく
          </a>
        </div>

        {/* 端末別の手順。**サーバは 4 端末ぶんを全部描く** — 端末はブラウザでしか判定できず、
            JavaScript が動かない環境では 4 つとも見えているのが正しい (行き止まりにしない)。 */}
        {saveGuides.map((g) => (
          <div class="flex flex-col gap-2" data-save-guide={g.key}>
            <div class="rp-devhead">
              <span>{g.heading}</span>
              {/* 判定を外したとき・別の端末で残したいときの逃げ道。JS が無いと働かないので既定は隠す。 */}
              <button type="button" class="rp-devsw" data-save-switch hidden>別の端末</button>
            </div>
            <ol class="rp-steps">
              {g.steps.map((step) => (
                <li data-opens-dialog={step.opensDialog ? '1' : undefined}>
                  <span>
                    {step.parts.map((part) =>
                      typeof part === 'string' ? <Fragment>{part}</Fragment>
                      : 'b' in part ? <b>{part.b}</b>
                      : <kbd class="rp-kbd">{part.kbd}</kbd>,
                    )}
                  </span>
                </li>
              ))}
            </ol>
            {g.note && <p class="text-[13px] text-slate-600">{g.note}</p>}
          </div>
        ))}

        {/* 端末を選び直す。**判定できなかった回は最初から開く** (当てずっぽうで 1 つ選ばない)。 */}
        <div class="rp-picker" data-save-picker hidden>
          {saveGuides.map((g) => (
            <button type="button" class="rp-pick" data-save-pick={g.key} aria-pressed="false">
              {g.label}
            </button>
          ))}
        </div>

        <p class="text-[13px] text-slate-600">
          端末や OS の版によって、メニューの名前が変わることがあります。
          保存した紙面は、この画面を開かなくても読めます。
        </p>
      </section>
    )}
    </div>{/* /.rp-inner */}
  </main>
</BaseLayout>

<script>
  /*
   * ダイジェストの「詳しい説明を読む」から全編の章へ飛ぶとき、**先に章を開く**。
   * 全編は既定で畳んである (`report.sections.collapsed`) ので、開かずに飛ぶと
   * 見出しの位置で止まって中身が見えない。
   *
   * **リンク自体は素の `<a href="#...">`** なので、この script が動かなくても
   * 移動はする (開くのは上乗せ)。`?print=1` にはこの導線を出していない。
   */
  function openTarget(hash: string): void {
    if (!hash || hash === '#') return;
    let el: Element | null = null;
    try { el = document.querySelector(hash); } catch { return; }
    const details = el?.closest('details');
    if (details && !details.open) details.open = true;
  }
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[data-jump]');
    if (a) openTarget(a.getAttribute('href') ?? '');
  });
  /*
   * 同一ページ内でハッシュだけが変わる場合 (戻る/進む・保存したリンクを踏み直す)。
   * `<script>` は再実行されないので、ここで拾わないと**その回だけ開かない**
   * (実測で取りこぼした)。
   */
  addEventListener('hashchange', () => openTarget(location.hash));
  // 直接 `/report#ch-...` で開かれた場合。位置合わせのため開いてから scroll し直す。
  if (location.hash) {
    openTarget(location.hash);
    requestAnimationFrame(() => {
      try { document.querySelector(location.hash)?.scrollIntoView(); } catch { /* 不正な hash */ }
    });
  }

  /* ────────────────────────────────────────────────────────────
   * 「手元に残す」— 端末を見分けて 1 本だけ出す (spec §4.4・裁定 2026-09-02)。
   *
   * **fail-safe が要件**: 判定できない / この script が動かないときは、サーバが描いた
   * 4 端末ぶんがそのまま見えている状態に留める。**空にしない・当てずっぽうで 1 つ選ばない。**
   * ボタンの既定の飛び先も `?print=1` なので、JS 無しでも保存の入口は塞がらない。
   * ──────────────────────────────────────────────────────────── */
  type Plat = 'windows' | 'mac' | 'iphone' | 'android';
  const PLAT_KEY = 'welltect.report.platform';

  /**
   * **iPadOS 13+ は Mac の UA を名乗る**ので、タッチ点の数で分ける。
   * 判定はブラウザでしかできない (同じ HTML が別の端末で開かれるため、サーバでは決めない)。
   */
  function detectPlatform(): Plat | null {
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const hinted = (nav.userAgentData?.platform ?? '').toLowerCase();
    const ua = navigator.userAgent;
    if (hinted === 'android' || /Android/.test(ua)) return 'android';
    if (hinted === 'ios' || /iPhone|iPad|iPod/.test(ua)) return 'iphone';
    // iPad は Macintosh を名乗る。**デスクトップの Mac にタッチ画面は無い**ので、
    // タッチ点が 1 つでもあれば iPad。`> 1` にすると取りこぼす (実測: 閾値 1 で Mac 判定になった)。
    if (/Mac/.test(ua) && navigator.maxTouchPoints > 0) return 'iphone';
    if (hinted === 'macos' || /Mac/.test(ua)) return 'mac';
    if (hinted === 'windows' || /Windows/.test(ua)) return 'windows';
    return null;
  }

  const saveSection = document.getElementById('save-section');
  if (saveSection) {
    const guides = [...saveSection.querySelectorAll<HTMLElement>('[data-save-guide]')];
    const picker = saveSection.querySelector<HTMLElement>('[data-save-picker]');
    const goBtn = saveSection.querySelector<HTMLAnchorElement>('[data-save-go]');

    const applyPlatform = (plat: Plat): void => {
      for (const g of guides) g.hidden = g.dataset.saveGuide !== plat;
      for (const sw of saveSection.querySelectorAll<HTMLElement>('[data-save-switch]')) sw.hidden = false;
      for (const b of saveSection.querySelectorAll('[data-save-pick]')) {
        b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.savePick === plat));
      }
      /*
       * PC ではボタンが印刷ダイアログを開くので、「Ctrl+P を押す」の行は出さない
       * (押した後にすることだけが残る)。`hidden` の行は描かれないため採番も飛ばない。
       */
      const desktop = plat === 'windows' || plat === 'mac';
      for (const li of saveSection.querySelectorAll<HTMLElement>('[data-opens-dialog]')) li.hidden = desktop;
      if (goBtn) {
        const u = new URL(goBtn.getAttribute('href') ?? '/report', location.href);
        if (desktop) u.searchParams.set('autoprint', '1');
        else u.searchParams.delete('autoprint');
        goBtn.setAttribute('href', u.pathname + u.search);
      }
    };

    let stored: string | null = null;
    try { stored = localStorage.getItem(PLAT_KEY); } catch { /* プライベートモード等 */ }
    const isPlat = (v: string | null): v is Plat =>
      v === 'windows' || v === 'mac' || v === 'iphone' || v === 'android';
    const initial = isPlat(stored) ? stored : detectPlatform();
    if (initial) applyPlatform(initial);
    // **判定できなかった回だけ最初から 4 択を出す。** 手順は 4 つとも見えたまま。
    else if (picker) picker.hidden = false;

    saveSection.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      if (target?.closest('[data-save-switch]')) {
        if (picker) picker.hidden = !picker.hidden;
        return;
      }
      const pick = target?.closest<HTMLElement>('[data-save-pick]');
      if (pick && isPlat(pick.dataset.savePick ?? null)) {
        const plat = pick.dataset.savePick as Plat;
        applyPlatform(plat);
        if (picker) picker.hidden = true;
        // 表示の好みなので DB に入れない (推移グラフの表示項目と同じ扱い)。
        try { localStorage.setItem(PLAT_KEY, plat); } catch { /* 保存できなくても表示は効く */ }
      }
    });
  }

  /*
   * `?print=1&autoprint=1` … 印刷ダイアログを自分で開く。**PC からしか来ない**
   * (モバイルの導線は `&autoprint=1` を付けない)。画像やフォントが載る前に開くと
   * 途中の紙面が刷られるので `load` を待つ。
   */
  {
    const sp = new URLSearchParams(location.search);
    if (sp.get('print') === '1' && sp.get('autoprint') === '1') {
      addEventListener('load', () => {
        try { window.print(); } catch { /* 印刷できない環境では紙面がそのまま残る */ }
      });
    }
  }
</script>

<style is:global>
  /*
    印刷 CSS は**上乗せだけ**。`?print=1` は通常の画面 CSS で紙面が成立しているので、
    印刷 CSS が効かない経路 (iOS の 共有 → PDF) でも同じ紙面になる (spec §4.4)。
  */
  /*
    紙面の外の地。**このページだけ**に効く (Astro はページ単位でスタイルを束ねる)。
    白い紙が地に浮いて見えることで「報告書の紙面」として読める (仕様書 §4.3.5)。
  */
  body { background: #F2F2F2; }

  @media print {
    body { background: #fff; }
    nav, header.app-nav, .no-print { display: none !important; }
    .report-sheet { padding: 0 !important; }
    details > summary { list-style: none; }

    /*
     * ── 改ページ ────────────────────────────────────────────
     * **以前は カード・表・章 を丸ごと `break-inside: avoid` にしていた。**
     * 1 ページに収まらない塊まで「割らない」と宣言したため、入りきらないカードが
     * 丸ごと次ページへ送られ、**手前に巨大な空白**が残っていた
     * (実測 2026-09-03: 32 ページ中 使用率 1.7% / 11.5% / 24.1% / 26.2% のページ)。
     *
     * 割ってよいものは割り、**割ってはいけない最小単位だけ**を守る。
     */
    .rp-card, .report-sheet details, .report-sheet table, .card { break-inside: auto; }
    /* 割ると意味が壊れるもの = 2 連大数字・数直線・表の 1 行・左ラベル行・週プラン・救急枠 */
    .rp-nums, .rp-gauge, .rp-lrow, .rp-wrow, .rp-er, .rp-axis,
    .report-sheet tr { break-inside: avoid; }
    /*
     * 番号つきの項目 (「まず確認すること」等) は**小見出しと本文で割らない**。
     * 割ると見出しだけがページの最後に残る (実測: p1 の末尾が「2. 相談先とタイミング」だけ)。
     * ページより長い項目はブラウザが従来どおり割るので、行き止まりにはならない。
     */
    .report-sheet li { break-inside: avoid; }
    /* 見出しがページの最後に取り残されない (「全編」だけのページが出ていた) */
    .rp-axis, .rp-h3, .report-sheet h2, .report-sheet h3, .report-sheet h4,
    details > summary { break-after: avoid; }
    /* 表がページをまたぐときは teal のヘッダを次ページにも出す */
    .report-sheet thead { display: table-header-group; }
    /* 1 行だけ残す/送るをしない */
    .report-sheet p, .report-sheet li { orphans: 2; widows: 2; }
  }
</style>
