---
import AppIcon from '../components/AppIcon.astro';
import BackToDashboard from '../components/BackToDashboard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ScanOverlay from '../components/ScanOverlay.astro';
import { getUserUploads } from '../lib/scan-queries';
import { testTypeLabel, formatJpDate } from '../lib/dashboard-queries';
import { qrSvgPath } from '../lib/qr';
import { publicUrl } from '../lib/public-url';
import { resolveViewer } from '../lib/viewer';
import { noStore } from '../lib/http-cache';

export const prerender = false;

// Cookie で個人化される SSR ページ: 共有キャッシュに保存させない
noStore(Astro.response);

// PC ではカメラ撮影を提供しない (要件 F-A5) ため、同じページをスマートフォンで
// 開いてもらうための QR を作る。?u= を含めるので端末を移しても同じユーザーで開く。
/*
 * QR は **公開 URL** で作る。`Astro.request.url` はプロキシの内側の URL に
 * なることがあり、実測 (2026-09-04) では 25 モジュール = 約 26 バイトの QR
 * (= localhost 等) が出て読み取っても開けなかった。詳細は public-url.ts。
 */
const pageUrl = publicUrl(Astro.request);
const qr = qrSvgPath(pageUrl, { cell: 4, margin: 4, ec: 'M' });

const url = new URL(Astro.request.url);
// 入場は Cookie で本人を判定する (`src/lib/viewer.ts`)。`?u=` は admin の代理表示のみ。
const viewer = await resolveViewer(Astro);
const diagnosticUserId = viewer.uid;
const uploads = diagnosticUserId ? await getUserUploads(diagnosticUserId) : [];
const dashUrl = diagnosticUserId ? `/dashboard?u=${encodeURIComponent(diagnosticUserId)}` : '/dashboard';
---

<BaseLayout title="AI スキャン | Welltect" width="app">
  <header class="flex items-center justify-between px-5 pt-6 pb-3">
    <BackToDashboard u={diagnosticUserId} class="!px-2.5 !text-sm" />
    <h1 class="text-base font-semibold">スキャン</h1>
    <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
      1 / 3
    </span>
  </header>

  <main class="flex flex-1 flex-col px-5 pb-8">

    <!-- ============================================================== -->
    <!-- パネル: ready（カメラ起動前のオンボーディング）                  -->
    <!-- ============================================================== -->
    <section id="panel-ready" class="flex flex-1 flex-col items-center gap-5 pt-2 text-center">
      <div class="flex h-20 w-20 items-center justify-center rounded-3xl bg-brand-50 text-4xl">
        <AppIcon name="result" size={20} />
      </div>
      <div class="space-y-1">
        <h2 class="text-lg font-bold">健診結果をスキャン</h2>
        <p class="text-xs text-slate-600">
          検査用紙をカメラで読み取り、AI が項目を自動で認識します。
        </p>
      </div>
      {/* ━━━ メインアクション: ファイル (primary) + カメラ (secondary) ━━━ */}
      <div class="w-full space-y-2">
        <label
          for="scan-file"
          class="group flex w-full cursor-pointer flex-col items-center justify-center gap-1 rounded-2xl bg-brand-600 px-5 py-5 text-center font-semibold text-white transition hover:bg-brand-700 active:scale-[0.98]"
        >
          <AppIcon name="attachment" size={32} />
          <span class="text-base">ファイルをアップロード</span>
          <span class="text-xs font-normal text-white/85">PDF / JPEG / PNG / WebP / HEIC<span class="text-white/65"> (最大 10 MB・複数選択可)</span></span>
        </label>
        {/*
          **`multiple` が要る** (2026-09-10 発注者報告)。
          複数ページの検査票は 1 回のダイアログでまとめて選べるのが自然で、
          これが無いと 1 枚選ぶたびにダイアログを開き直すことになる。
          受け取り側 (change ハンドラ) も `files[0]` ではなく全件を順に積む。
        */}
        <input
          id="scan-file"
          type="file"
          multiple
          class="hidden"
          accept="application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif"
        />

        {/*
          カメラ撮影はスマートフォン限定 (要件 F-A5: PC はカメラスキャン非対応)。
          タッチ端末 (pointer: coarse) でだけ表示し、PC ではアップロードのみにする。
          判定は CSS のポインタ種別で行い、JS が無効でも崩れないようにする。
        */}
        <button
          id="scan-start"
          class="touch-only min-h-touch w-full items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-5 py-3 text-base font-semibold text-slate-700 transition hover:border-brand-400 hover:bg-brand-50 active:scale-[0.99]"
        >
          <AppIcon name="camera" size={20} />
          <span>カメラで撮影</span>
        </button>

        {/* PC 向け: カメラの代わりにスマートフォンへの導線を出す。 */}
        <div class="pointer-only rounded-2xl border border-slate-200 bg-white p-4 text-left">
          <p class="flex items-center gap-2 text-base font-semibold text-navy-800">
            <AppIcon name="camera" size={20} class="text-slate-600" />
            カメラ撮影はスマートフォンから
          </p>
          <p class="mt-1.5 text-sm text-slate-700">
            PC ではファイルのアップロードのみに対応しています。用紙を撮影して読み取る場合は、
            下の QR コードをスマートフォンで読み取ってください。
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-5">
            {/* QR。サーバ側で生成した静的 SVG (外部サービスへ URL を送らない)。 */}
            <svg
              viewBox={`0 0 ${qr.size} ${qr.size}`}
              width="160"
              height="160"
              class="shrink-0 rounded-lg border border-slate-200 bg-white p-1"
              role="img"
              aria-label="このページを開くための QR コード"
            >
              <rect width={qr.size} height={qr.size} fill="#FFFFFF" />
              <path d={qr.path} fill="#102B3A" />
            </svg>
            <p class="min-w-0 flex-1 text-sm text-slate-700">
              スマートフォンのカメラを向けると、このページが開きます。<br />
              読み取れない場合は下の URL をお使いください。
            </p>
          </div>

          <div class="mt-3 flex flex-wrap items-center gap-2">
            <input
              id="scan-share-url"
              type="text"
              readonly
              class="min-h-touch flex-1 rounded-xl border border-slate-300 bg-slate-50 px-3 text-sm text-slate-800"
              aria-label="このページの URL"
            />
            <button
              id="scan-share-copy"
              type="button"
              class="btn-secondary !py-2 !text-sm"
            >
              <AppIcon name="attachment" size={16} class="mr-1.5" />URL をコピー
            </button>
          </div>
          <p id="scan-share-msg" class="mt-1.5 text-sm text-brand-700" aria-live="polite"></p>
        </div>
      </div>

      {/* ━━━ これまでにスキャンした検査一覧 ━━━ */}
      {uploads.length > 0 && (
        <section class="w-full text-left">
          <header class="mb-2 flex items-center justify-between px-1">
            <h3 class="flex items-center gap-1.5 text-xs font-bold text-slate-700">
              <span><AppIcon name="book" size={20} /></span>
              <span>これまでにスキャンした検査</span>
            </h3>
            <a href={dashUrl} class="text-xs text-brand-600 hover:underline">全件 ›</a>
          </header>
          <ul class="space-y-1.5">
            {uploads.slice(0, 5).map((a) => {
              const tt = testTypeLabel(a.test_type);
              const href = diagnosticUserId
                ? `/result/${a.id}?u=${encodeURIComponent(diagnosticUserId)}`
                : `/result/${a.id}`;
              return (
                <li>
                  <a
                    href={href}
                    class="flex items-center gap-2.5 rounded-xl border border-slate-200 bg-white px-3 py-2 transition hover:border-brand-300 hover:shadow-sm"
                  >
                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-mist text-base">
                      <AppIcon name={tt.icon} size={20} class="text-brand-700" />
                    </span>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-baseline justify-between gap-2">
                        <h4 class="truncate text-sm font-medium text-slate-800">{tt.name}</h4>
                        <time class="shrink-0 text-xs text-slate-500">{formatJpDate(a.test_date)}</time>
                      </div>
                      <p class="mt-0.5 truncate text-xs text-slate-500">
                        {a.lab_name ?? 'ユーザー UL'}
                        {a.page_count && a.page_count > 1 && <span> · {a.page_count}pg</span>}
                      </p>
                    </div>
                    <span class="shrink-0 text-slate-400">›</span>
                  </a>
                </li>
              );
            })}
          </ul>
          {uploads.length > 5 && (
            <p class="mt-2 text-center text-xs text-slate-500">
              他 {uploads.length - 5} 件 — <a href={dashUrl} class="text-brand-600 hover:underline">ダッシュボードで確認</a>
            </p>
          )}
        </section>
      )}

      {/* ━━━ 撮影のコツ (折りたたみ) ━━━ */}
      <details class="w-full text-left">
        <summary class="min-h-touch cursor-pointer text-sm font-medium text-slate-700 hover:text-slate-900">
          <span class="inline-flex items-center gap-2">
            <AppIcon name="tip" size={18} class="text-slate-600" />きれいに読み取るコツ
          </span>
        </summary>
        <ul class="mt-2 space-y-1 rounded-xl bg-slate-50 p-3 text-xs text-slate-700">
          <li class="flex items-start gap-2"><span class="mt-0.5 shrink-0 text-slate-600" aria-hidden><AppIcon name="tip" size={20} /></span>明るい場所で撮影してください</li>
          <li class="flex items-start gap-2"><span class="mt-0.5 shrink-0 text-slate-600" aria-hidden><AppIcon name="report" size={20} /></span>用紙全体が枠に収まるようにかざします</li>
          <li class="flex items-start gap-2"><span class="mt-0.5 shrink-0 text-slate-600" aria-hidden><AppIcon name="lock" size={20} /></span>画像はサーバに保存されません</li>
        </ul>
      </details>
    </section>

    <!-- ============================================================== -->
    <!-- パネル: active / busy（カメラ起動中・解析中）                   -->
    <!-- ============================================================== -->
    <section id="panel-active" class="flex flex-1 flex-col gap-4" hidden>
      <div class="relative aspect-[3/4] w-full overflow-hidden rounded-2xl bg-black">
        <video
          id="scan-video"
          class="h-full w-full object-cover"
          playsinline
          muted
          autoplay></video>
        <ScanOverlay id="scan-overlay" />
        <canvas id="scan-canvas" class="hidden"></canvas>

        <!-- 撮影ガイド枠 -->
        <div class="pointer-events-none absolute inset-4 rounded-xl border-2 border-white/70"></div>

        <!-- 信頼度の凡例 -->
        <div class="pointer-events-none absolute left-3 top-3 rounded-full bg-navy-900/85 px-2.5 py-1 text-xs text-white">
          <span class="mr-1 inline-block h-2 w-2 rounded-full bg-emerald-400 align-middle"></span>
          高信頼
          <span class="ml-2 mr-1 inline-block h-2 w-2 rounded-full bg-amber-300 align-middle"></span>
          要確認
        </div>

        <!-- 解析中オーバーレイ -->
        <div id="busy-overlay" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-navy-900/85 text-white" hidden>
          <div class="h-10 w-10 animate-spin rounded-full border-2 border-white/30 border-t-white"></div>
          <p class="text-sm font-medium">AI が解析しています…</p>
        </div>
      </div>

      <!-- セカンダリ操作行 -->
      <div class="flex items-center justify-between gap-2">
        <label class="inline-flex items-center gap-2 text-sm">
          <input
            id="scan-detect-toggle"
            type="checkbox"
            class="h-4 w-4 rounded border-slate-400 text-brand-600 focus:ring-brand-500"
          />
          AR 検知
        </label>
        <button id="hint-toggle" type="button" class="chip text-xs">
          <AppIcon name="tip" size={20} /> 補足を追加
        </button>
      </div>

      <!-- ヒント入力（折りたたみ） -->
      <div id="hint-panel" hidden>
        <input
          id="scan-hint"
          type="text"
          class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
          placeholder="例: 右前腕、3 日前から赤み"
          maxlength="200"
        />
      </div>

      <p id="scan-status" class="min-h-5 text-center text-xs text-slate-500" aria-live="polite"></p>

      <!-- プライマリ CTA -->
      <button id="scan-shot" class="btn-primary !py-4 text-lg">
        <AppIcon name="camera" size={20} /> 撮影
      </button>
    </section>

    <!-- ============================================================== -->
    <!-- パネル: confirm（1 枚撮るごとの確認）                            -->
    <!--                                                                -->
    <!-- 【なぜ要るか】以前は撮影＝即解析で、ブレや画角のミスに気づくのが     -->
    <!-- 結果画面まで行った後だった。複数ページを撮り重ねるには、1 枚ごとに   -->
    <!-- 「これでよい / 撮り直す」を挟めないと積めない (発注者指示)。        -->
    <!-- **前のページには戻らない。** 撮り直せるのはいま撮った 1 枚だけで、  -->
    <!-- それ以前をやり直す手段は「最初からやり直す」だけ。                -->
    <!-- ============================================================== -->
    <section id="panel-confirm" class="flex flex-1 flex-col gap-4" hidden>
      <div class="flex items-center justify-between gap-3">
        <p class="text-base font-semibold text-navy-800">
          <span id="confirm-page-label">1 枚目</span> — この写真でよろしいですか
        </p>
        <button id="confirm-restart" type="button"
          class="inline-flex min-h-touch shrink-0 items-center gap-1.5 rounded-full border border-slate-500 bg-white px-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
          最初からやり直す
        </button>
      </div>

      <p class="text-sm text-slate-700">
        文字がはっきり読めるか、用紙の端まで写っているかをご確認ください。
      </p>

      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
        {/* 撮影画像。PDF は画像として表示できないので下の代替を出す。 */}
        <img id="confirm-image" alt="撮影した用紙のプレビュー" class="max-h-[52vh] w-full object-contain" hidden />
        <div id="confirm-nopreview" class="flex flex-col items-center gap-2 px-4 py-10 text-center" hidden>
          <AppIcon name="attachment" size={32} class="text-slate-500" />
          <p class="text-base font-medium text-slate-700">PDF を追加しました</p>
          <p id="confirm-nopreview-name" class="text-sm text-slate-600"></p>
          <p class="text-sm text-slate-600">PDF は画面でのプレビューができません。</p>
        </div>
      </div>

      {/*
        読み込めなかったファイルの控え。複数選択で 1 つだけ大きすぎた場合などに、
        **黙って捨てずに**名前と理由を出す。色だけに頼らずアイコン+文字も添える。
      */}
      <div
        id="confirm-skipped"
        class="flex items-start gap-2 rounded-xl border border-status-watch bg-status-watch-bg px-3 py-2 text-sm text-status-watch"
        hidden
      >
        <AppIcon name="watch" size={18} class="mt-0.5 shrink-0" />
        <p id="confirm-skipped-text"></p>
      </div>

      {/*
        アイコンは経路によらず中立なものにしてある (`refresh` / `next`)。
        カメラのアイコンを出すと、アップロードで入れた 1 枚の「撮り直す」が
        カメラを名乗ることになるため。ラベルだけを JS で入れ替える。
      */}
      <div class="grid grid-cols-2 gap-2">
        <button id="confirm-retake" type="button" class="btn-pair btn-graph">
          <AppIcon name="refresh" size={18} /><span id="confirm-retake-label">撮り直す</span>
        </button>
        <button id="confirm-next" type="button" class="btn-pair btn-data">
          <AppIcon name="next" size={18} />次の用紙
        </button>
      </div>
      {/*
        ここでは送信しない。**確定点は次の確認画面 1 か所だけ**にする
        (発注者指示)。まとめ送信は後戻りできないので、1 枚ごとの画面から
        いきなり始めない。
      */}
      <button id="confirm-done" class="btn-primary !py-4 text-lg">
        <AppIcon name="check" size={20} /> これで全部（確認へ）
      </button>
    </section>

    <!-- ============================================================== -->
    <!-- パネル: review（全ページの最終確認 → まとめて送信）               -->
    <!-- 唯一の確定点。ここを押すまで 1 枚も読み取らない。                  -->
    <!-- **1 枚ずつの取り消しは置かない** (前のページへ戻らない方針)。      -->
    <!-- ============================================================== -->
    <section id="panel-review" class="flex flex-1 flex-col gap-4" hidden>
      <div class="flex items-center justify-between gap-3">
        <p class="text-base font-semibold text-navy-800">
          <span id="review-count">0</span> 枚を送信します
        </p>
        <button id="review-restart" type="button"
          class="inline-flex min-h-touch shrink-0 items-center gap-1.5 rounded-full border border-slate-500 bg-white px-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
          最初からやり直す
        </button>
      </div>

      <p class="text-sm text-slate-700">
        この内容で読み取ります。読み取りは全ページまとめて行うため、少し時間がかかります。
      </p>

      {/* 送るものを目で確かめるための一覧。押せる要素は置かない (1 枚だけの取り消しはしない)。 */}
      <ul id="review-thumbs" class="flex flex-wrap gap-2"></ul>

      <div class="mt-auto flex flex-col gap-2">
        <button id="review-send" class="btn-primary !py-4 text-lg">
          <AppIcon name="send" size={20} /> 全てを送信
        </button>
        {/*
          追加は**手段を選ばせる**。1 つのボタンにするとカメラかファイルの
          どちらかを名乗ることになり、もう片方で入れた人が行き止まりになる。
          カメラ側は `touch-only` (要件 F-A5「PC はカメラスキャン非対応」) なので
          PC では「ファイルを選ぶ」1 つだけが出る。
        */}
        <button id="review-add-camera" type="button" class="btn-pair btn-graph touch-only">
          <AppIcon name="camera" size={18} />カメラで撮影
        </button>
        <button id="review-add-file" type="button" class="btn-pair btn-data">
          <AppIcon name="attachment" size={18} />ファイルを選ぶ
        </button>
      </div>

      {/* 送信中の進捗。1 画像 = 1 リクエストなので順に進む。 */}
      <div id="review-progress" class="rounded-xl border border-slate-200 bg-white p-4" hidden>
        <p id="review-progress-text" class="text-base font-medium text-navy-800" aria-live="polite">読み取り中…</p>
        <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
          <div id="review-progress-bar" class="h-full w-0 rounded-full bg-brand-600 transition-all"></div>
        </div>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- パネル: result（解析結果 + ユーザー検証）                       -->
    <!-- ============================================================== -->
    <section id="panel-result" class="flex flex-1 flex-col gap-4" hidden>
      <!-- サマリ -->
      <div class="flex items-center gap-3 rounded-2xl bg-slate-100 px-4 py-3 text-slate-800">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-500 text-white"><AppIcon name="result" size={20} /></span>
        <p id="scan-result-summary" class="text-sm font-semibold">解析結果</p>
      </div>

      <!-- 表全体のトリミング画像 + ブロックオーバーレイ -->
      <section class="card !p-0">
        <h3 class="border-b border-slate-100 px-4 py-3 text-sm font-semibold">
          表全体 (タップでブロックを確認)
        </h3>
        <div id="trimmed-image" class="p-3"></div>
      </section>

      <!-- 選択ブロックの詳細 -->
      <section id="block-detail" class="card !p-0" hidden>
        <header class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
          <h3 id="block-detail-title" class="text-sm font-semibold">ブロック詳細</h3>
          <button id="block-detail-close" type="button" class="text-slate-400 hover:text-slate-700" aria-label="閉じる">✕</button>
        </header>
        <div id="block-detail-body" class="overflow-x-auto p-3"></div>
      </section>

      <!-- 詳細データ (デバッグ) -->
      <details class="rounded-2xl border border-dashed border-slate-300 p-3">
        <summary class="min-h-touch cursor-pointer text-sm font-medium text-slate-700">詳細データ (開発用)</summary>
        <div class="mt-2 space-y-3">
          <div>
            <p class="mb-1 text-xs uppercase tracking-wide text-slate-400">
              Gemini raw markdown <span id="scan-finish" class="ml-1 rounded bg-slate-200 px-1.5 py-0.5 text-xs font-normal text-slate-700"></span>
            </p>
            <pre id="scan-raw" class="max-h-[480px] overflow-auto whitespace-pre-wrap break-words rounded bg-slate-50 p-2 text-xs text-slate-700"></pre>
          </div>
          <div>
            <p class="mb-1 text-xs uppercase tracking-wide text-slate-400">下流診断 AI 送信用 Markdown (編集反映)</p>
            <pre id="scan-result" class="max-h-72 overflow-auto whitespace-pre-wrap break-words rounded bg-slate-50 p-2 text-xs text-slate-700"></pre>
          </div>
        </div>
      </details>

      <!-- CTA: 確認して送信 / 再撮影 -->
      <div class="mt-auto flex flex-col gap-2 pt-2">
        <button id="scan-submit" type="button" class="btn-primary !py-4 text-lg" disabled>
          ✓ 確認して送信
        </button>
        <p id="scan-submit-hint" class="text-center text-xs text-slate-500" aria-live="polite"></p>
        <button id="scan-retake" type="button" class="btn-secondary">
          もう一度撮影する
        </button>

        <!-- テスト用: Elith 連携バケット (S3) への書き出し -->
        <div class="mt-1 rounded-xl border border-dashed border-slate-300 p-2">
          <button id="scan-export-s3" type="button" class="btn-secondary w-full !py-2 text-sm" disabled>
            <AppIcon name="cloud" size={20} /> S3へ書き出し（Elith用・テスト）
          </button>
          <p id="scan-export-status" class="mt-1 break-words text-center text-xs text-slate-500" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <!-- 行修正モーダル: セル単位で疑念解消 -->
    <div id="row-edit-modal" class="fixed inset-0 z-50 flex items-end justify-center bg-slate-900/60 p-4 md:items-center" hidden>
      <div class="flex max-h-[90vh] w-full max-w-lg flex-col rounded-2xl bg-white" role="dialog" aria-modal="true">
        <header class="flex items-start justify-between gap-2 border-b border-slate-100 px-4 py-3">
          <h4 id="row-edit-title" class="text-base font-semibold">行の修正</h4>
          <button id="row-edit-cancel" type="button" class="text-slate-400 hover:text-slate-700" aria-label="閉じる">✕</button>
        </header>
        <div id="row-edit-cells" class="flex-1 space-y-2 overflow-y-auto px-3 py-3"></div>
        <footer class="border-t border-slate-100 px-4 py-3">
          <p class="mb-2 text-xs text-slate-500">
            <span class="inline-block h-2 w-2 rounded bg-amber-300"></span> 要確認のセル: 修正を入力するか「このまま OK」で解消します。
          </p>
          <button id="row-edit-save" type="button" class="btn-primary w-full !py-2 text-sm"><AppIcon name="save" size={20} /> 保存して閉じる</button>
        </footer>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- パネル: error                                                   -->
    <!-- ============================================================== -->
    <section id="panel-error" class="flex flex-1 flex-col items-center justify-center gap-6 text-center" hidden>
      <div class="flex h-20 w-20 items-center justify-center rounded-3xl bg-rose-50 text-4xl">
        <AppIcon name="watch" size={20} />
      </div>
      <div class="space-y-2">
        <h2 class="text-lg font-bold">スキャンを開始できません</h2>
        <p id="error-message" class="text-sm text-slate-600"></p>
      </div>
      <div class="mt-auto flex w-full flex-col gap-2">
        <button id="error-retry" class="btn-primary w-full !py-4 text-lg">再試行</button>
        <a href={diagnosticUserId ? `/?u=${encodeURIComponent(diagnosticUserId)}` : '/'} class="btn-secondary text-center">トップへ戻る</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { initCameraScan } from '../scripts/camera-scan';
  import type { AnalyzeResult, ScanState } from '../scripts/camera-scan';
  import { ScanVerificationController } from '../scripts/scan-verification';
  import { prepareScanUpload, UploadTooLargeError } from '../scripts/scan-upload';
  import { ScanPageList, mergeResults } from '../scripts/scan-pages';
  import { getOrCreateDiagnosticId } from '../lib/diagnostic-id';

  function $<T extends HTMLElement = HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Element #${id} not found`);
    return el as T;
  }

  // 直近の読込元ファイル名 (アップロード経由のみ。書き出しファイル名に組み込む)
  let lastSourceFileName: string | null = null;

  type Panel = 'ready' | 'active' | 'confirm' | 'review' | 'result' | 'error';
  const panels: Record<Panel, HTMLElement> = {
    ready: $('panel-ready'),
    active: $('panel-active'),
    confirm: $('panel-confirm'),
    review: $('panel-review'),
    result: $('panel-result'),
    error: $('panel-error'),
  };

  function show(panel: Panel): void {
    (Object.keys(panels) as Panel[]).forEach((key) => {
      panels[key].hidden = key !== panel;
    });
  }

  /* ──────────────────────────────────────────────────────────────
   * 複数ページのスキャン (発注者指示 2026-09-04)
   *
   *   撮影 / アップロード → **1 枚ごとに確認** → 撮り直す / 次の用紙 / これで全部
   *                       → 最終確認 → **全てを送信** (ここで初めて読み取る)
   *
   * ・**確定点は「全てを送信」1 か所だけ。** それまで 1 枚も /api/scan へ送らない
   * ・**前のページには戻らない。** 撮り直せるのは今の 1 枚だけで、
   *   それ以前をやり直す手段は「最初からやり直す」のみ
   * ・読み取りは 1 画像 = 1 リクエストで順に回す (Vercel 60 秒制限。CLAUDE.md)
   * ────────────────────────────────────────────────────────────── */
  const pages = new ScanPageList();
  /**
   * カメラ制御。DOMContentLoaded 後に入る。
   * 上のページ操作から参照するので、ハンドラ内の const ではなくここに置く。
   */
  let camera: import('../scripts/camera-scan').CameraScanController | null = null;

  /**
   * カメラを使える端末か。**判定は CSS の `.touch-only` と同じ `(pointer: coarse)`**
   * にそろえる (要件 F-A5「PC はカメラスキャン非対応」・global.css)。
   * ここがずれると「画面に出ていないカメラが JS から起動する」ことになる。
   */
  function cameraAvailable(): boolean {
    return window.matchMedia?.('(pointer: coarse)').matches ?? false;
  }

  /**
   * 「次の用紙」「撮り直す」で使う手段。**いま確認中の 1 枚を入れた経路に合わせる**
   * (2026-09-10 発注者報告: PC でファイルを選んだあと「次」を押すとカメラが起動していた)。
   * PC はカメラ非対応なので、撮影由来でもファイルへ落とす。
   */
  function currentMethod(): 'camera' | 'file' {
    if (!cameraAvailable()) return 'file';
    return pages.last?.origin === 'file' ? 'file' : 'camera';
  }

  /** ファイル選択ダイアログを開く。**click ハンドラから同期で呼ぶこと** (ユーザー操作の延長でしか開かない)。 */
  function openFilePicker(): void {
    $<HTMLInputElement>('scan-file').click();
  }

  /** カメラを開始する。video の表示復帰もここで必ず行う (アップロード経路が隠したままにしない)。 */
  async function startCamera(): Promise<void> {
    show('active');
    $('scan-video').hidden = false;
    await camera?.start();
  }

  /** いま確認中 (= 最後に積んだ) の 1 枚を確認画面に描く。積む処理とは分けてある。 */
  function renderConfirm(skipped: string[] = []): void {
    const page = pages.last;
    if (!page) {
      // 1 枚も無い状態で確認画面を出さない (撮り直しで最後の 1 枚を捨てたとき)。
      show('ready');
      return;
    }
    const img = $<HTMLImageElement>('confirm-image');
    const nop = $('confirm-nopreview');
    const preview = page.previewDataUrl ?? (page.kind === 'pdf' ? null : page.dataUrl);

    $('confirm-page-label').textContent = `${pages.length} 枚目`;
    if (preview) {
      img.src = preview;
      img.hidden = false;
      nop.hidden = true;
    } else {
      // PDF は画面で中身を見せられない。黙って空にせず理由を出す。
      img.hidden = true;
      img.removeAttribute('src');
      nop.hidden = false;
      $('confirm-nopreview-name').textContent = page.name ?? '';
    }
    // ボタンの名乗りを実際の動作に合わせる (カメラを開かないのに「撮り直す」と言わない)。
    $('confirm-retake-label').textContent = currentMethod() === 'file' ? '選び直す' : '撮り直す';

    const note = $('confirm-skipped');
    note.hidden = skipped.length === 0;
    $('confirm-skipped-text').textContent = skipped.length
      ? `次のファイルは追加できませんでした: ${skipped.join(' / ')}`
      : '';

    camera?.stop();
    show('confirm');
  }

  /** 1 枚積んで確認画面へ。撮影の入口 (アップロードは複数まとめて積むので別経路)。 */
  function pushPageAndConfirm(
    src: Parameters<typeof pages.add>[0],
    name: string | null,
    origin: Parameters<typeof pages.add>[2],
  ): void {
    pages.add(src, name, origin);
    renderConfirm();
  }

  /** 最終確認画面。送るものを目で確かめてもらう。 */
  function showReview(): void {
    $('review-count').textContent = String(pages.length);
    const list = $('review-thumbs');
    list.innerHTML = '';
    pages.all.forEach((pg, i) => {
      const li = document.createElement('li');
      li.className = 'flex w-20 flex-col items-center gap-1';
      const thumb = pg.previewDataUrl ?? (pg.kind === 'pdf' ? null : pg.dataUrl);
      if (thumb) {
        const im = document.createElement('img');
        im.src = thumb;
        im.alt = '';
        im.className = 'h-20 w-20 rounded-lg border border-slate-200 object-cover';
        li.appendChild(im);
      } else {
        const box = document.createElement('span');
        box.className = 'grid h-20 w-20 place-items-center rounded-lg border border-slate-200 bg-slate-50 text-sm text-slate-600';
        box.textContent = 'PDF';
        li.appendChild(box);
      }
      const cap = document.createElement('span');
      cap.className = 'text-sm text-slate-600';
      cap.textContent = `${i + 1} 枚目`;
      li.appendChild(cap);
      list.appendChild(li);
    });
    $('review-progress').hidden = true;
    $<HTMLButtonElement>('review-send').disabled = pages.length === 0;
    camera?.stop();
    show('review');
  }

  /** 最初からやり直す。撮った分を全部捨てる (確認を挟む)。 */
  function restartAll(): void {
    if (pages.length > 0 && !confirm(`撮影した ${pages.length} 枚を破棄して、最初からやり直します。よろしいですか？`)) return;
    pages.clear();
    lastSourceFileName = null;
    camera?.stop();
    show('ready');
  }

  /** 全ページをまとめて読み取る。**ここが唯一の確定点**。 */
  async function sendAll(): Promise<void> {
    const total = pages.length;
    if (total === 0) return;
    const sendBtn = $<HTMLButtonElement>('review-send');
    // 追加は 2 つある (カメラ / ファイル)。送信中はどちらも押させない。
    const addBtns = ['review-add-camera', 'review-add-file'].map((id) => $<HTMLButtonElement>(id));
    sendBtn.disabled = true;
    addBtns.forEach((b) => { b.disabled = true; });
    $('review-progress').hidden = false;

    const results = [];
    for (let i = 0; i < total; i += 1) {
      $('review-progress-text').textContent = `${i + 1} / ${total} 枚目を読み取り中…`;
      $('review-progress-bar').style.width = `${Math.round((i / total) * 100)}%`;
      const r = await camera!.analyzeToResult(pages.all[i], {
        statusText: `${i + 1} / ${total} 枚目を読み取り中…`,
      });
      // 1 枚落ちても残りは続ける。落ちた枚数は後で伝える (黙って捨てない)。
      if (r) results.push(r);
    }
    $('review-progress-bar').style.width = '100%';

    if (results.length === 0) {
      $('error-message').textContent = '読み取れませんでした。撮り直してお試しください。';
      sendBtn.disabled = false;
      addBtns.forEach((b) => { b.disabled = false; });
      show('error');
      return;
    }
    if (results.length < total) {
      // 全部は読めなかった。**成功分だけ進める**が、その事実は必ず出す。
      alert(`${total} 枚のうち ${total - results.length} 枚が読み取れませんでした。読み取れた ${results.length} 枚分で続けます。`);
    }

    const merged = mergeResults(results);
    pages.clear();
    await renderResult(merged);
    camera?.stop();
    show('result');
  }

  async function renderResult(r: AnalyzeResult): Promise<void> {
    // Gemini 生 markdown (推論値列含む) — 監査の透明性のため raw のまま表示
    ($('scan-raw') as HTMLPreElement).textContent = r.markdown || '(empty)';
    const finish = r.finishReason ?? '';
    const finishEl = $('scan-finish');
    finishEl.textContent = finish ? `finish: ${finish}` : '';
    const hasBadFinish = finish === 'MAX_TOKENS' || finish === 'SAFETY';
    finishEl.classList.toggle('bg-rose-200', hasBadFinish);
    finishEl.classList.toggle('text-rose-900', hasBadFinish);

    const diagnosticId = getOrCreateDiagnosticId();
    const exportStatus = $('scan-export-status');

    // 確定 Markdown を S3 (Elith 連携) へ書き出す共有関数。
    // 「確認して送信」(完了) 時の自動書き出しと、手動ボタンの両方から使う。
    /**
     * 確認済みのスキャン結果をアプリの DB へ保存する。
     * これが入るまでスキャンは DB に何も残さず、検査結果ページに
     * 「人間ドック / 健康診断」の中身を出せなかった (原本画像は保存しない方針)。
     * **失敗しても S3 書き出しは続ける** — 片方が落ちてもう片方まで止めない。
     */
    async function saveScanToDb(markdownClean: string): Promise<void> {
      try {
        const res = await fetch('/api/scan/save', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ markdownClean, pageCount: r.pageCount ?? 1 }),
        });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (!res.ok || !data.ok) {
          // 黙って落とさない。書き出し状況の行に併記する。
          exportStatus.textContent = `検査結果の保存に失敗しました (${data.error ?? res.status})`;
        }
      } catch (err) {
        exportStatus.textContent = `検査結果の保存に失敗しました (${String(err)})`;
      }
    }

    async function exportScanToS3(): Promise<void> {
      // #scan-result は検証編集を反映した「下流送信用 Markdown」
      const markdownClean = ($('scan-result') as HTMLPreElement).textContent?.trim() || r.markdownClean;
      if (!markdownClean) {
        exportStatus.textContent = '書き出す Markdown がありません。';
        return;
      }
      const diagnosticUserId = new URLSearchParams(location.search).get('u');
      // 先にアプリの DB へ (画面に出すのはこちら)。落ちても S3 書き出しは続ける。
      await saveScanToDb(markdownClean);
      exportStatus.textContent = ' S3へ書き出し中…';
      try {
        const res = await fetch('/api/scan/export', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            markdownClean,
            diagnosticId,
            diagnosticUserId,
            hint: ($('scan-hint') as HTMLInputElement | null)?.value || null,
            sourceFileName: lastSourceFileName,
          }),
        });
        const data = (await res.json()) as {
          ok?: boolean; configured?: boolean; bucket?: string; folder?: string;
          uploaded?: { key: string }[]; message?: string; error?: string;
        };
        if (data.ok && data.configured) {
          exportStatus.textContent = ` S3へ書き出しました: s3://${data.bucket}/${data.folder} (${data.uploaded?.length ?? 0} ファイル)`;
        } else if (data.configured === false) {
          exportStatus.textContent = `ⓘ S3未設定のため変換のみ実行 (フォルダ: ${data.folder})。サーバ環境変数 AWS_REGION を設定すると自動アップロードします。`;
        } else {
          exportStatus.textContent = ` 失敗: ${data.error ?? '不明なエラー'}`;
        }
      } catch (e) {
        exportStatus.textContent = ` 通信エラー: ${e instanceof Error ? e.message : String(e)}`;
      }
    }

    // 検証 UI: 表トリミング画像 + ブロック詳細 + 行修正モーダル
    const controller = new ScanVerificationController(
      {
        trimmedImage: $('trimmed-image'),
        blockDetail: $('block-detail'),
        blockDetailTitle: $('block-detail-title'),
        blockDetailBody: $('block-detail-body'),
        resultSummary: $('scan-result-summary'),
        downstreamPreview: $('scan-result'),
        submitBtn: $<HTMLButtonElement>('scan-submit'),
        submitHint: $('scan-submit-hint'),
        rowEditModal: $('row-edit-modal'),
        rowEditTitle: $('row-edit-title'),
        rowEditCellsContainer: $('row-edit-cells'),
        rowEditSaveBtn: $<HTMLButtonElement>('row-edit-save'),
        rowEditCancelBtn: $<HTMLButtonElement>('row-edit-cancel'),
        // 完了 (確認して送信) 時に S3 へ自動書き出ししてから /chat へ遷移
        onBeforeSubmit: exportScanToS3,
      },
      r,
      diagnosticId,
    );
    await controller.render();

    // block-detail パネルの閉じるボタン
    $('block-detail-close').onclick = () => {
      $('block-detail').hidden = true;
    };

    // 手動の書き出しボタン (完了前にも任意で書き出せる)
    const exportBtn = $<HTMLButtonElement>('scan-export-s3');
    exportBtn.disabled = false;
    exportBtn.onclick = async () => {
      exportBtn.disabled = true;
      try {
        await exportScanToS3();
      } finally {
        exportBtn.disabled = false;
      }
    };
  }

  document.addEventListener('DOMContentLoaded', () => {
    const controller = camera = initCameraScan({
      video: $<HTMLVideoElement>('scan-video'),
      canvas: $<HTMLCanvasElement>('scan-canvas'),
      shotBtn: $<HTMLButtonElement>('scan-shot'),
      status: $('scan-status'),
      hint: $<HTMLInputElement>('scan-hint'),
      onStateChange: (state: ScanState) => {
        $('busy-overlay').hidden = state !== 'busy';
        const shot = $<HTMLButtonElement>('scan-shot');
        shot.textContent = state === 'busy' ? '解析中…' : ' 撮影 & 解析';
      },
      onCapture: () => {
        // カメラ撮影はファイル名なし。直前のアップロード名を引き継がない。
        lastSourceFileName = null;
      },
      /*
       * **撮影しても解析しない。** 1 枚ごとに確認画面へ送る (発注者指示)。
       * これが無いとブレ・画角のミスに結果画面まで気づけず、複数ページも積めない。
       */
      onShot: (dataUrl) => {
        lastSourceFileName = null;
        pushPageAndConfirm({ dataUrl, kind: 'image' }, null, 'camera');
      },
      onAnalyze: (result) => {
        void renderResult(result);
        controller.stop();
        show('result');
      },
      onError: (msg) => {
        $('error-message').textContent = msg;
        show('error');
      },
    });

    // ── 1 枚ごとの確認 ──
    // **入れた経路と同じ手段で続ける**。以前はどちらも無条件に
    // `controller.start()` を呼んでいたため、PC でファイルを選んだ人にも
    // カメラが起動し (=カメラが無いので失敗しエラー画面)、スマホでは
    // 実際にカメラが開いていた (2026-09-10 発注者報告)。
    $('confirm-retake').addEventListener('click', async () => {
      const method = currentMethod();
      pages.dropLast();          // 撮り直す (選び直す) のは「いまの 1 枚」だけ
      if (method === 'file') {
        // 先に 1 枚戻した画面を出してからダイアログを開く。
        // **閉じただけ (キャンセル) でも表示と枚数が食い違わない**ようにするため。
        renderConfirm();
        openFilePicker();
        return;
      }
      await startCamera();
    });
    $('confirm-next').addEventListener('click', async () => {
      if (currentMethod() === 'file') { openFilePicker(); return; }
      await startCamera();
    });
    $('confirm-done').addEventListener('click', () => showReview());
    $('confirm-restart').addEventListener('click', () => restartAll());

    // ── 最終確認 ──
    // ここは**手段を選ばせる** (カメラで入れた人もファイルで足せる。逆も同じ)。
    $('review-add-camera').addEventListener('click', () => void startCamera());
    $('review-add-file').addEventListener('click', () => openFilePicker());
    $('review-restart').addEventListener('click', () => restartAll());
    $('review-send').addEventListener('click', () => void sendAll());

    $('scan-start').addEventListener('click', () => void startCamera());

    // ファイルアップロード経路 (PDF / 画像)。**選んだ全件を順に積む**。
    $<HTMLInputElement>('scan-file').addEventListener('change', async (e) => {
      const target = e.target as HTMLInputElement;
      const files = Array.from(target.files ?? []);
      target.value = ''; // 同じファイルの再選択を許可
      if (files.length === 0) return;

      // 上限 (10 MB) の判定と、Vercel のボディ上限に収めるための縮小は
      // scan-upload.ts に集約してある (受け付ける上限と送れる上限は別物)。
      const skipped: string[] = [];
      const before = pages.length;
      for (const file of files) {
        // **選んだ順に 1 件ずつ**。並列にすると積む順が崩れて紙の順番が入れ替わる。
        try {
          const prepared = await prepareScanUpload(file);
          // アップロードも撮影と同じページ列へ積む (発注者指示)。ここでは解析しない。
          pages.add(prepared, prepared.note ? `${file.name}・${prepared.note}` : file.name, 'file');
          lastSourceFileName = file.name; // 書き出しファイル名に組み込む
        } catch (err) {
          // 1 件落ちても残りは積む。**黙って捨てない**ので名前と理由を控えて確認画面に出す。
          skipped.push(`${file.name}（${err instanceof UploadTooLargeError ? err.message : String(err)}）`);
        }
      }
      if (pages.length === before) {
        // 1 件も積めなかったときだけエラー画面へ (積めた分がある間は流れを止めない)。
        $('error-message').textContent = skipped.join('\n');
        show('error');
        return;
      }
      renderConfirm(skipped);
    });

    /*
     * 結果画面の「もう一度撮影する」。ここも PC ではカメラが起動して必ず失敗していた
     * (上の「次の用紙」と同じ欠陥)。PC はカメラ非対応なのでファイル選択へ回し、
     * **押した先で起きることに名乗りを合わせる**。
     */
    if (!cameraAvailable()) $('scan-retake').textContent = 'もう一度ファイルを選ぶ';
    $('scan-retake').addEventListener('click', async () => {
      if (!cameraAvailable()) { openFilePicker(); return; }
      await startCamera();
    });

    $('error-retry').addEventListener('click', () => {
      $('error-message').textContent = '';
      show('ready');
    });

    $('hint-toggle').addEventListener('click', () => {
      const h = $('hint-panel');
      h.hidden = !h.hidden;
      if (!h.hidden) ($('scan-hint') as HTMLInputElement).focus();
    });

    window.addEventListener('pagehide', () => controller.stop());

    show('ready');
  });

  // ── PC 向け: このページの URL を表示してコピーできるようにする ──
  // (カメラはスマートフォン限定のため、端末を移してもらう導線)
  {
    const urlInput = document.getElementById('scan-share-url') as HTMLInputElement | null;
    const copyBtn = document.getElementById('scan-share-copy');
    const msg = document.getElementById('scan-share-msg');
    if (urlInput) urlInput.value = window.location.href;
    copyBtn?.addEventListener('click', async () => {
      if (!urlInput) return;
      try {
        await navigator.clipboard.writeText(urlInput.value);
        if (msg) msg.textContent = 'コピーしました。スマートフォンのブラウザで開いてください。';
      } catch {
        urlInput.select();
        if (msg) msg.textContent = 'コピーできませんでした。選択状態にしたので手動でコピーしてください。';
      }
    });
  }
</script>
