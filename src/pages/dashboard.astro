---
import AppIcon from '../components/AppIcon.astro';
import AppNav from '../components/AppNav.astro';
import SignInPanel from '../components/SignInPanel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import UrgentAlertBanner from '../components/dashboard/UrgentAlertBanner.astro';
import DailyQuests from '../components/dashboard/DailyQuests.astro';
import OnlineConsultCard from '../components/dashboard/OnlineConsultCard.astro';
import SituationalCards from '../components/dashboard/SituationalCards.astro';
import ProgressSection from '../components/dashboard/ProgressSection.astro';
import TestResultsSection from '../components/dashboard/TestResultsSection.astro';
import HealthInsightCard from '../components/dashboard/HealthInsightCard.astro';
import HealthAgeCard from '../components/dashboard/HealthAgeCard.astro';
import ReportLinkCard from '../components/dashboard/ReportLinkCard.astro';
import ProductsLinkCard from '../components/dashboard/ProductsLinkCard.astro';
import AddToHomeCard from '../components/AddToHomeCard.astro';
import { loadDashboard, formatGreeting, getHealthAge, formatJpDate, testTypeLabel } from '../lib/dashboard-queries';
import { getLatestMeasurements } from '../lib/measurement-queries';
import { countUnreadImportant } from '../lib/notice-queries';
import { refreshConfig, cfg } from '../lib/app-config';
import { demoFallbackEnabled } from '../lib/demo-data';
import { isSpecialAccount } from '../lib/special-accounts';
import { getLatestInterviewCompletion } from '../lib/interview-completion';
import { isBridgeConfigured } from '../lib/supabase';
import { resolveViewer } from '../lib/viewer';
import {
  extractUrgentAlert,
  extractDailyQuests,
  extractSituationalCards,
  findSection,
} from '../lib/elith-parser';
import { noStore } from '../lib/http-cache';

export const prerender = false;

// Cookie で個人化される SSR ページ: 共有キャッシュに保存させない
noStore(Astro.response);

const url = new URL(Astro.request.url);
// 入場は Cookie で本人を判定する (`src/lib/viewer.ts`)。`?u=` は admin の代理表示のみ。
const viewer = await resolveViewer(Astro);
/*
 * 表示中のユーザー。`?u=` は admin の代理表示のときだけ効く。
 * **デモ表示の可否はこの uid だけで決まる** (`demo-accounts.ts`)。
 * 閲覧者が admin かどうかは関係ない = 代理表示中も相手の実データが見える。
 */
const u = viewer.uid;

// === [一時デバッグ] HP↔#2 ブリッジ接続状態の可視化 ===
// `?debug=bridge` を付けて開くとサーバー側 env の有無をUIに表示する。
// デバッグ表示は admin だけ (本番相当への切替・2026-08-30)。
const debugBridge = url.searchParams.get('debug') === 'bridge' && viewer.isAdmin;
// **閲覧者の origin で見る** — staging の閲覧者に production の構成状況を出すと、
// 「configured=true なのに空」の切り分けができなくなる (2026-09-11)。
const bridgeConfigured = isBridgeConfigured(viewer.origin);
const bridgeEnvNames = viewer.origin === 'staging'
  ? (['HP_BRIDGE_STAGING_FUNCTION_URL', 'HP_BRIDGE_STAGING_SHARED_SECRET'] as const)
  : (['HP_BRIDGE_SUPABASE_URL', 'HP_BRIDGE_READONLY_KEY'] as const);
const envSeen = (name: string) =>
  !!((import.meta.env as Record<string, string | undefined>)[name]
    || (typeof process !== 'undefined' ? (process.env as Record<string, string | undefined>)?.[name] : ''));
// 値そのものは絶対に出さない (secret を含むため)。**有無だけ**。
const bridgeUrlSeen = envSeen(bridgeEnvNames[0]);
const bridgeKeySeen = envSeen(bridgeEnvNames[1]);

/*
 * 表示中のデプロイを特定するための刻印。
 * 「直したはずの表示が変わらない」ときに、コードの問題かデプロイ未反映かを
 * 切り分けるために出す。値は Vercel のシステム環境変数
 * (VERCEL_GIT_COMMIT_REF / VERCEL_GIT_COMMIT_SHA — 公式ドキュメント
 *  vercel.com/docs/environment-variables/system-environment-variables。
 *  どちらも runtime で参照できるが、プロジェクト設定の
 *  「Enable access to System Environment Variables」が必要)。
 * ローカルでは未設定なので 'local' を出す。
 */
const envStr = (name: string): string => {
  const v = (import.meta.env as Record<string, string | undefined>)[name];
  if (v) return v;
  if (typeof process !== 'undefined' && process.env) return (process.env as Record<string, string | undefined>)[name] ?? '';
  return '';
};
const buildRef = envStr('VERCEL_GIT_COMMIT_REF') || 'local';
const buildSha = (envStr('VERCEL_GIT_COMMIT_SHA') || 'local').slice(0, 7);
console.log('[bridge-debug]', { origin: viewer.origin, bridgeConfigured, bridgeUrlSeen, bridgeKeySeen, buildRef, buildSha });

// テストフェーズの前提 (発注者指定 2026-08-20):
//   Wellfort の admin なら誰でもアクセスでき、全員が同じデータ・同じ表示になる。
//   クライアントに UI を確認してもらうために必要な状態なので、この仕組みは維持する。
//   本番相当への切替 (?u= 入場の廃止・PUBLIC_DEMO_FALLBACK=false・デバッグ表示の遮蔽) は
//   総合テストの段階で行う。
const authEnabled = !!import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
const needsSignIn = authEnabled && !u;

/*
 * **app_config はデータ取得より前に読み込む。**
 * デモ用アカウントの一覧 (`demo.account_uids`) をここから引くため、
 * 後ろに置くと初回リクエストで admin 画面からの登録が効かない (コード既定に落ちる)。
 */
await refreshConfig();
const result = needsSignIn ? null : await loadDashboard(u, viewer.origin);

const hasError = result ? 'error' in result : false;
const data = !result || hasError ? null : (result as Exclude<typeof result, { error: string }>);

/*
 * デバッグ欄の表示用。**判定そのものは各クエリの中で同じ関数が使われている**ので、
 * ここは「表示中の uid でデモが出るか」を見せているだけ (二重管理にならない)。
 */
const demoShown = demoFallbackEnabled(data?.diagnosticUserId);

// ── 実データ (STEP 1/2 で作った diagnosis.measurement_values から読む) ──
// 判定・助言はアプリで作らない。検査票の値・基準値と、検査機関が付けた flag のみを渡す。
const latest = data ? await getLatestMeasurements(data.resultUid) : null;

// ウェルネス年齢 (選択ユーザー本人の diagnostic_user_id で取得)
const healthAge = data ? await getHealthAge(data.diagnosticUserId) : null;

const unreadNotices = data ? await countUnreadImportant(data.diagnosticUserId) : 0;

/*
 * ══════════════════════════════════════════════════════════════════════
 * **「AI疾病予防報告書 単品購入」の画面にするか** (発注者指示 2026-09-15)。
 * ══════════════════════════════════════════════════════════════════════
 * 正本 `docs/operations/スペシャルアカウント_仕様書.md` §14。
 *
 * スペシャルアカウントは **EC で購入していない**ので、サブスク契約も検査キットも
 * 構造的に存在しない。材料は**自分でスキャンした検診・人間ドック ＋ AI問診**だけ＝
 * CLAUDE.md の「報告書は 2 タイプある」の**タイプ2 (単品購入)** と同じ形。
 *
 * → コースプラン前提の枠 (キット進捗 / 検査 5 種) をそのまま出すと、
 *   **永久に埋まらない枠が 5 つ居座る**ので、単品購入の進捗に差し替える。
 *
 * **判定は `isSpecialAccount(uid)` 1 本。** 「キットが 0 件なら」で判定しない —
 * 実顧客でも連携前は 0 件になり、コースプランの人の画面が黙って変わってしまう。
 */
const singlePurchase = isSpecialAccount(data?.diagnosticUserId);

/*
 * ① AI問診の完了。**DB の事実だけ**を見る (`diagnosis.interview_completions`)。
 * 端末の localStorage は見ない — スマホで問診して PC で開くと「未回答」になるため
 * (この記録を足した理由そのもの)。
 *
 * **入口 (course / single) で引くかどうかを変えない** (2026-09-23 修正)。
 * 2026-09-15 に進捗を `ProgressSection` 1 本へ統合したとき、**AI問診の行は course でも
 * 出る**ようになった (`ProgressSection.astro` の `steps` は mode で分岐しない) のに、
 * この取得だけが「単品購入でしか使わない」という統合前の前提のまま残っていた。
 * → **コースプランの利用者は問診を完了しても永久に「未実行」**になっていた (実測 2026-09-23)。
 *
 * 行を出すなら、その行の根拠も必ず引く。**片方だけを mode で絞らない。**
 */
const interviewDone = data ? await getLatestInterviewCompletion(data.diagnosticUserId) : null;
const checkups = (data?.artifacts ?? []).filter((a) => a.test_type === 'health_checkup');

/*
 * **報告書のタイルを押せるか** (発注者指示 2026-09-15「報告書が無い場合はグレーアウトに」)。
 *
 * 材料が 1 件も無い回に開くと `emptyVM` = 帯だけの紙面になる
 * (`elith-report-queries.ts` の `emptyVM`)。それを「報告書」として開かせない。
 *
 * **受領日の有無だけで決めない** — デモ用アカウントは行が無くてもサンプルを開けるので、
 * デモのときは押せるままにする (`loadReportVM` が sample() を返す経路)。
 */
const reportAvailable = !!data?.latestResult || demoShown;

/*
 * **報告書の「New」(新着) 判定** (発注者要望 2026-09「作成済のステータス New バッジ等」)。
 *
 * 定義 = **受領日 (received_at) から N 日以内**。決定論・新規状態なし・PII なし・サーバ側で完結する。
 * 「未閲覧か」では判定しない — 端末をまたぐ閲覧済みの記録 (DB 列/localStorage) が要り、
 * per-device で不整合が出るため (この定義は後で差し替え可・app_config は見せ方だけ持つ)。
 *
 * N は app_config `ui.report_new_days` (既定 14)。整数でない/0 以下は既定に落とす。
 * デモのサンプルは received_at が無い → New は出ない (新着ではないので正しい)。
 */
const reportNewDays = (() => {
  const n = Number.parseInt(cfg('ui.report_new_days'), 10);
  return Number.isFinite(n) && n > 0 ? n : 14;
})();
const reportIsNew = (() => {
  const iso = data?.latestResult?.received_at;
  if (!iso) return false;
  const received = new Date(iso).getTime();
  if (Number.isNaN(received)) return false;
  return Date.now() - received <= reportNewDays * 24 * 60 * 60 * 1000;
})();

// 画面文言 (app_config)。未設定なら空文字が返り、UI 側で非表示になる。
const healthAgeFollowup = cfg('ui.health_age_followup');
const supportContact = cfg('ui.support_contact');
/*
 * **単品購入でもプラン名を出す** (発注者指示 2026-09-15)。
 * コースプランは契約 (`subscription.plan_name`) から引くが、単品購入は EC 購入が無いので
 * 引ける契約が存在しない。**当社が名乗る表示名**なので app_config に置いて差し替え可にする
 * (画面文言は app_config = CLAUDE.md の流儀)。
 */
const singlePurchasePlanName = cfg('ui.single_purchase_plan_name');

const greeting    = data ? formatGreeting(data) : '';
const sections    = data?.elithSections ?? [];
const urgentAlert = data ? extractUrgentAlert(sections) : null;
const quests      = data ? extractDailyQuests(sections) : [];
const situations  = data ? extractSituationalCards(sections) : [];
const abstract    = findSection(sections, 'アブストラクト');
const totalChars  = sections.reduce((sum, s) => sum + (s.char_count || 0), 0);

// あいさつ帯に出す「最新の検査」の種別名。
const latestTypeName = latest ? testTypeLabel(latest.testType).name : '';

// OEM 相手先ブランド向けデモ顧客 (山田太郎 / da000001) はロゴを差し替える
const DEMO_OEM_UID = 'da000001-0000-0000-0000-000000000000';
const isDemoBrand = data?.diagnosticUserId === DEMO_OEM_UID;
// OEM デモのときだけ差し替える。未指定なら AppLogo が Welltect ロゴを解決する。
const logoSrc = isDemoBrand ? '/gan-checker-logo.svg' : undefined;
const logoAlt = isDemoBrand ? 'がんチェッカー' : 'Welltect';
const q = u ? `?u=${encodeURIComponent(u)}` : '';
---

<BaseLayout title={data ? `${greeting} | Welltect` : 'マイページ | Welltect'} width="app">
  {debugBridge && (
    <div style="position:fixed;top:0;left:0;right:0;z-index:9999;background:#102B3A;color:#fff;font-size:12px;padding:6px 10px;font-family:monospace;">
      bridge[origin={viewer.origin} configured={String(bridgeConfigured)} url={String(bridgeUrlSeen)} key={String(bridgeKeySeen)}]
      kit[source={data?.shipmentSource ?? '-'} n={String(data?.shipments?.length ?? 0)} uid={data?.resultUid ?? '-'}]
      build[{buildRef}@{buildSha}]
      <span id="dbg-scrim">scrim[?]</span>
    </div>
  )}
  {debugBridge && (
    /* 実際に適用されているスクリム色をそのまま出す (CSS が新しいか古いかの判定用)。 */
    <script is:inline>
      (() => {
        const el = document.createElement('div');
        el.className = 'sheet-backdrop';
        el.style.position = 'absolute';
        el.style.left = '-9999px';
        el.style.animation = 'none'; // フェード中の値を読まないよう止める
        document.body.appendChild(el);
        const cs = getComputedStyle(el);
        const out = document.getElementById('dbg-scrim');
        if (out) out.textContent = `scrim[${cs.backgroundColor} op=${cs.opacity}]`;
        el.remove();
      })();
    </script>
  )}
  {needsSignIn && (
    <SignInPanel supportContact={supportContact} />
  )}

  {hasError && (
    <main class="flex flex-1 flex-col items-center justify-center gap-3 px-5 text-center">
      <AppIcon name="watch" size={32} class="text-status-action" />
      <h1 class="text-lg font-bold text-navy-800">ダッシュボードを読み込めませんでした</h1>
      <p class="text-base text-status-action">{(result as { error: string }).error}</p>
      <p class="text-sm text-slate-600">supabase/README.md の手順で local stack が起動しているか確認してください。</p>
    </main>
  )}

  {!needsSignIn && !hasError && (
    <>
      <AppNav u={u} current="/dashboard" unreadNotices={unreadNotices} logoSrc={logoSrc} logoAlt={logoAlt} supportContact={supportContact} />

      {data?.usingDemoData && (
        <div class="border-b border-amber-200 bg-amber-50 px-4 py-2.5 text-center text-sm text-amber-800">
          表示内容は、開発テスト検証やデモンストレーション用に、サンプル（デモ）の検査結果を表示しています。氏名等も全て仮名です。
        </div>
      )}

      {/*
        あいさつ帯は 1 列 (PC は 1 行) に畳む (発注者指示 2026-08)。
        3 行積むと本題 (ウェルネス年齢 / 検査結果) が下へ押し出されるため。
        スマホは 390px に横 1 行で入らないので、そのまま縦に折り返す。
        区切りの「／」は 1 行に並ぶ lg 以上でだけ出す (折り返すと行末に取り残される)。
      */}
      <header class="hero-gradient flex flex-col gap-1.5 px-5 py-4 lg:flex-row lg:flex-wrap lg:items-baseline lg:justify-between lg:gap-x-5">
        <h1 class="text-2xl font-bold tracking-tight text-navy-800 lg:whitespace-nowrap">
          {greeting}、こんにちは。
        </h1>
        <p class="flex flex-col gap-1 text-base text-slate-700 lg:flex-row lg:items-baseline lg:gap-2.5">
          {latest?.testDate && (
            <span class="tnum whitespace-nowrap">最新の検査: {latestTypeName} {formatJpDate(latest.testDate)}</span>
          )}
          {latest?.testDate && data?.latestResult?.received_at && (
            <span aria-hidden="true" class="hidden text-slate-300 lg:inline">／</span>
          )}
          {data?.latestResult?.received_at && (
            <span class="tnum whitespace-nowrap">最新の AI 診断: {formatJpDate(data.latestResult.received_at)}</span>
          )}
        </p>
      </header>

      <main class="flex flex-1 flex-col gap-5 px-5 pb-12 pt-5">

        {/* ① 注意項目 — 非表示 (緊急受診勧告 URGENT ALERT): {urgentAlert && <UrgentAlertBanner alert={urgentAlert} />} */}

        {/*
          ② ウェルネス年齢 ＋ ②-2 AI疾病予防報告書。
          報告書のタイルは**検査カードと同寸 (17rem)** に固定し、余った幅はウェルネス年齢に回す
          (発注者指示 2026-08)。タイルは brand 塗りで、この画面で塗りはこの 1 枚だけ。
          items-stretch で高さを揃える (v0.5 の items-start から変更 — タイルが同寸になり、
          中身が少なくて間延びする問題が消えたため)。
          ウェルネス年齢が無い (算出前) ときは報告書を全幅の帯で出す。
        */}
        {healthAge?.latest ? (
          <div class="grid grid-cols-1 items-stretch gap-5 lg:grid-cols-[minmax(0,1fr)_17rem]">
            <HealthAgeCard latest={healthAge.latest} followup={healthAgeFollowup} canGraph={(healthAge.trend?.points?.length ?? 0) >= 2} q={q} />
            <ReportLinkCard href={`/report${q}`} receivedAt={data?.latestResult?.received_at} available={reportAvailable} isNew={reportIsNew} />
          </div>
        ) : (
          <ReportLinkCard href={`/report${q}`} receivedAt={data?.latestResult?.received_at} available={reportAvailable} isNew={reportIsNew} />
        )}

        {/*
          ②-3 **進捗は検査結果より上に置く** (発注者指示 2026-09-15)。
          利用者にとって「次にすること」が本題で、検査結果は**その結果として後から埋まる**もの。
          順番を逆にすると、まだ何も無い検査カードを越えた先に本題が来る。

          **中身は入口で変わる** (`ProgressSection`):
            course … ① AI問診 → ② スキャン → ③ 検査キット → ④ 報告書
            single … ① AI問診 → ② スキャン →           ③ 報告書
        */}
        <ProgressSection
          mode={singlePurchase ? 'single' : 'course'}
          planName={singlePurchase ? singlePurchasePlanName : data?.subscription?.plan_name}
          interviewCompletedAt={interviewDone?.completedAt ?? null}
          checkupCount={checkups.length}
          latestCheckupDate={checkups[0]?.test_date ?? null}
          reportReceivedAt={data?.latestResult?.received_at ?? null}
          reportIsNew={reportIsNew}
          shipments={data?.shipments ?? []}
          nextTestAt={data?.subscription?.next_test_at}
          diagnosticUserId={data?.diagnosticUserId ?? ''}
          detailHref={`/kit${q}`}
          q={q}
        />

        {/* ③ 次にすること — 非表示 (本日の健康クエスト): <DailyQuests quests={quests} /> */}

        {/*
          ④ 検査結果 (検査 5 種)。
          v1.0 で「直近の検査結果 (項目カード)」「検査値の推移」「検査履歴」をここに統合した。
          推移グラフは種別ごとに /trend へ切り出し、履歴は「データ」の遷移先 (結果ページ) に置く。
        */}
        <TestResultsSection artifacts={data?.artifacts ?? []} q={q} onlyTypes={singlePurchase ? ['health_checkup'] : undefined} />


        {/*
          ⑥ 主要導線。AI スキャンと AI 問診は**同格**なので同じ淡色にする
          (発注者指示 2026-08: AI 問診の白 →「データ」ボタンと同色)。
          brand 塗りは AI疾病予防報告書のタイルに寄せてあるので、ここでは使わない。
        */}
        {/*
          **単品購入ではここを出さない。** 行き先が上の進捗カードのボタンと同じ (/scan・/chat) で、
          同じ画面に同じ行き先のボタンが 2 つ並ぶ。進捗カード側は「済んだか」まで出せるので、
          重複するならそちらを残す。コースプランの人には従来どおり出す。
        */}
        {!singlePurchase && (
          <section aria-label="主要な操作">
            <h2 class="sr-only">主要な操作</h2>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <a
                href={`/scan${q}`}
                class="flex min-h-touch items-center gap-3 rounded-2xl border border-brand-600 bg-brand-50 px-4 py-4 transition hover:bg-brand-100"
              >
                <AppIcon name="scan" size={28} class="text-brand-700" />
                <span class="flex flex-col">
                  <span class="text-base font-semibold text-brand-700">AI スキャン</span>
                  <span class="text-sm text-slate-600">検診・人間ドックの結果を読み取る</span>
                </span>
              </a>
              <a
                href={`/chat${q}`}
                class="flex min-h-touch items-center gap-3 rounded-2xl border border-brand-600 bg-brand-50 px-4 py-4 transition hover:bg-brand-100"
              >
                <AppIcon name="interview" size={28} class="text-brand-700" />
                <span class="flex flex-col">
                  <span class="text-base font-semibold text-brand-700">AI 問診</span>
                  <span class="text-sm text-slate-600">生活習慣を記録する</span>
                </span>
              </a>
            </div>
          </section>
        )}

        {/* ⑦ 医師との面談 (オプション)。AI コーチとは相手が違うので枠を分ける。 */}
        <OnlineConsultCard />

        {/* 非表示 (今日の気付き): <HealthInsightCard diagnosticUserId={data?.diagnosticUserId ?? ''} /> */}
        {/* 非表示 (シチュエーション別アドバイス): {situations.length > 0 && <SituationalCards cards={situations} />} */}
        {/* 非表示 (AI ヘルスコーチ)。1st ローンチ見送り (発注者判断 2026-08)。 */}

        {/* ⑩ ホーム画面への追加 (追加済み / 閉じたあとは出ない。判定はクライアント側) */}
        <AddToHomeCard />

        {/* ⑪ 商品一覧 (発注者指示 2026-09-16)。**利用者に見える最後の枠**
             — この下はテストフェーズの確認用フッタで、総合テストで遮蔽する。 */}
        <ProductsLinkCard />

        {/* テストフェーズの確認用フッタ (総合テストで遮蔽する)。§02 参照。 */}
        <details class="rounded-2xl border border-dashed border-slate-300 p-4">
          <summary class="min-h-touch cursor-pointer text-sm font-medium text-slate-600">
            デバッグ (テストフェーズ確認用)
          </summary>
          <dl class="mt-3 space-y-1 text-sm text-slate-600">
            <div class="flex justify-between gap-3"><dt>diagnostic_user_id:</dt><dd class="font-mono break-all">{data?.diagnosticUserId}</dd></div>
            {/*
              **AI問診を観測ログ付きで開く導線** (2026-09-23)。
              `?trace=1` を付けて開いた回だけ、問診画面の右下に
              「観測ログをコピー」が出る (`live-trace.ts` の `mountTraceButton`)。

              【なぜ要るか】実機は iPhone で JS コンソールを開けないうえ、
              **ホーム画面から起動していると URL 欄が無く `?trace=1` を付けられない**。
              読み上げが飛ぶ不具合の原因を、採取できないまま推測で 2 回外している。
              ここに置けば**1 タップ**で採れる。デバッグ欄なので通常の利用者には出ない。
            */}
            <div class="flex justify-between gap-3">
              <dt>AI問診の観測ログ:</dt>
              <dd>
                <a href={`/chat${q ? `${q}&` : '?'}trace=1`} class="font-semibold text-brand-700 underline">
                  観測ログ付きで開く
                </a>
                <span class="ml-1 text-slate-500">（画面右下の「観測ログをコピー」で採取）</span>
              </dd>
            </div>
            {/*
              **admin 判定とその根拠**。判定は静かに外れるので、根拠を画面に出せないと
              「なぜダミーが出ないのか」が誰にも分からない (実測 2026-08-30: 本番で
              報告書が空になり、原因の特定に何往復もした)。**推測でなくここを見る。**
            */}
            <div class="flex justify-between gap-3">
              <dt>admin 判定:</dt>
              <dd>
                {viewer.isAdmin ? '✓ admin' : '✗ admin ではない'}
                {viewer.adminBy === 'cookie' && <span class="ml-1">（根拠: サインイン時に管理者リストで確認）</span>}
                {!viewer.isAdmin && (
                  <span class="ml-1">（サインインした email が admin の管理者リストに無いか、リストを引けていない）</span>
                )}
              </dd>
            </div>
            {/*
              **デモ表示は uid だけで決まる** (admin 権限とは無関係)。
              「出さない」なら、その uid をデモ用アカウントに登録すれば出る
              (wellfort-site admin → 設定「デモ」→「デモ用アカウントの uid」に上の
              diagnostic_user_id を足す。再デプロイ不要・反映は最大 45 秒)。
            */}
            <div class="flex justify-between gap-3">
              <dt>デモ表示:</dt>
              <dd>
                {demoShown ? '出す（デモ用アカウント）' : '出さない（このアカウントは実データのみ）'}
              </dd>
            </div>
            <div class="flex justify-between gap-3"><dt>検査アーティファクト:</dt><dd class="tnum">{data?.artifacts.length} 件</dd></div>
            <div class="flex justify-between gap-3"><dt>検査値 (最新回):</dt><dd class="tnum">{latest?.items.length ?? 0} 件</dd></div>
            <div class="flex justify-between gap-3"><dt>キット出荷:</dt><dd class="tnum">{data?.shipments.length} 件</dd></div>
            <div class="flex justify-between gap-3"><dt>Elith sections:</dt><dd class="tnum">{sections.length} 件 / {totalChars.toLocaleString()} 字</dd></div>
            <div class="flex justify-between gap-3"><dt>abstract:</dt><dd>{abstract ? `${abstract.char_count}字` : 'なし'}</dd></div>
            {/*
              **本番表示**。受領 JSON を**本番のアダプタ・本番のレンダラ**に通した紙面を
              タイプ別に見る (発注者指示 2026-09-01)。既定はタイプ1。
              **モックへのリンクは置かない** — モックは紙面の正だが**本番の画面で見せるものではなく**
              (発注者指示 2026-09-01)、リポジトリの `docs/elith/mock/*.html` に在り、
              実装との突き合わせは `npm run verify:sheet-contract` が機械で行う。
              デバッグ欄を遮蔽するときに `?preview=` も一緒に閉じる。
            */}
            <p class="pt-3">紙面 (受領 JSON から生成):</p>
            <div class="flex flex-wrap gap-2 pt-1">
              <a href="/report?preview=1" class="chip">タイプ1 コースプラン</a>
              <a href="/report?preview=2" class="chip">タイプ2 単品購入相当</a>
            </div>
            <p class="pt-3">他ユーザーで試す:</p>
            <div class="flex flex-wrap gap-2 pt-1">
              <a href="/dashboard?u=d0000001-0000-0000-0000-000000000000" class="chip">真鍋 (横ばい)</a>
              <a href="/dashboard?u=d0000002-0000-0000-0000-000000000000" class="chip">田中 (改善)</a>
              <a href="/dashboard?u=d0000003-0000-0000-0000-000000000000" class="chip">山田 (悪化)</a>
              <a href="/dashboard?u=d0000004-0000-0000-0000-000000000000" class="chip">鈴木 (検査なし)</a>
              <a href="/dashboard?u=d0000009-0000-0000-0000-000000000000" class="chip">中村 (検査中)</a>
              <a href="/dashboard?u=da000001-0000-0000-0000-000000000000" class="chip">山田太郎 (OEMデモ)</a>
            </div>
          </dl>
        </details>
      </main>
    </>
  )}
</BaseLayout>
