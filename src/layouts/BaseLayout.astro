---
import '../styles/global.css';
import GoogleOneTap from '../components/GoogleOneTap.astro';
import { LOGO } from '../lib/brand.ts';

interface Props {
  title?: string;
  description?: string;
  /**
   * 本文の最大幅。
   *   'app'   … 業務画面 (ダッシュボード/進捗/結果)。PC まで広げる。
   *   'flow'  … 単一導線 (問診/スキャン/サインイン)。読みやすさ優先で中幅に留める。
   *   'full'  … 幅制御を親に委ねる。
   * 既定は 'flow' (従来の max-w-md 相当の挙動に最も近い)。
   */
  width?: 'app' | 'flow' | 'full';
}

const {
  title = 'Welltect',
  description = 'Welltect — 検査結果とAI診断を、わかりやすく整理してお届けします。',
  width = 'flow',
} = Astro.props;

// F-A3 のブレークポイント (sm640 / md768 / lg1024 / xl1280) に沿う。
// 従来は全ページ max-w-md 固定で、PC で極端に間延びしていた。
const WIDTH = {
  // 業務画面は PC で本文が間延びしない範囲まで広げる。lg 以上は 2 カラムに
  // 組む前提の幅で、単一カラムのまま広げるとタブレット表示のまま巨大化する。
  //
  // **md (768px) の段を必ず置く**。sm(640) の次が lg(1024) だと、その間の
  // タブレット (iPad 縦 834px 等) が 672px で頭打ちになり、左右に 80px ずつ
  // 余白が残って間延びして見える (実測 2026-08)。
  app:  'w-full max-w-md sm:max-w-2xl md:max-w-3xl lg:max-w-5xl xl:max-w-7xl 2xl:max-w-[88rem]',
  // flow は読み物向けなので意図的に狭い (和文 38 字前後に収める)。広げない。
  flow: 'w-full max-w-md sm:max-w-xl lg:max-w-2xl',
  full: 'w-full',
} as const;
---

<!doctype html>
<html lang="ja">
  <head>
    {/*
      **代理表示中だけ、同一オリジンの `/api/...` を `/admin-view/<ctx>/api/...` に載せ替える。**
      正本 `docs/specs/secure_shared_access_and_admin_impersonation_spec_20260930.md` §38-U27。

      【なぜ中央でやるか】画面の JS は `fetch('/api/scan/save')` のように素のパスで書かれており
      (実測 20 か所以上)、代理表示中はそのままだと **context がサーバへ届かない**。
      ページごとに書き換えると必ず 1 か所漏れる (漏れると「代理表示のつもりで admin 本人に書く」)。
      → **fetch を 1 か所で包む。** ページ側のコードは 1 行も変えない。

      【いつ動くか】**`/admin-view/` を開いているときだけ。** 通常の画面では
      このスクリプトは何も置き換えない (`fetch` も差し替えない) ので**挙動不変**。

      【サーバ側の 403 と対で効く。片方だけでは足りない】
        ・この載せ替えが**無い**と、`/api/scan/save` に context が届かず
          サーバは **admin 本人**として扱う → `writeTargetUid` は admin 自身の uid なので
          `denyReadOnlyWrite` は**発火せず、admin 本人の検査結果として保存される**。
        ・この載せ替え**だけ**では、context を外した手製のリクエストを止められない。
      → **運ぶのがここ (`BaseLayout`)、止めるのがサーバ (`src/lib/write-guard.ts`)。**
        検査 `verify:admin-handoff` は**両方**を見る (W-1〜W-9)。
    */}
    <script is:inline>
      (() => {
        const m = /^\/admin-view\/([A-Za-z0-9_-]{32,64})(?=\/|$)/.exec(location.pathname);
        if (!m) return;                       // ★ 通常の画面では何もしない
        const prefix = '/admin-view/' + m[1];
        const orig = window.fetch.bind(window);
        window.fetch = (input, init) => {
          try {
            // 文字列 / URL / Request の 3 通りとも受ける。
            const raw = typeof input === 'string' ? input
              : input instanceof URL ? input.href
              : input && typeof input.url === 'string' ? input.url : null;
            if (raw) {
              const u = new URL(raw, location.origin);
              // **同一オリジンの /api/ だけ。** 外部 (Google・Supabase 等) には触らない。
              if (u.origin === location.origin && u.pathname.startsWith('/api/')) {
                u.pathname = prefix + u.pathname;
                const next = u.pathname + u.search + u.hash;
                return typeof input === 'string' || input instanceof URL
                  ? orig(next, init)
                  : orig(new Request(next, input), init);
              }
            }
          } catch { /* 何かあれば素通し (通信を壊さない) */ }
          return orig(input, init);
        };
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <!-- Executive Navy。ダークモードは提供しないため単一値。 -->
    <meta name="theme-color" content="#102B3A" />
    {/*
      タブの favicon。**ロゴ全体ではなくマーク (円+W) だけ**を使う
      (発注者指摘 2026-08「ファビコンも小さいので文字を削除してマークだけに」)。
      16px まで縮むとワードマーク "welltect" の線幅が 1px を切って潰れ、
      何のアイコンか分からなくなるため (ホーム画面アイコンで先に確認済みの現象)。
      画像は scripts/build-pwa-icons.mjs が原本から**切り出すだけ**で生成する
      (色も形も変えない)。背景は透過なので明るいタブでも暗いタブでも浮かない。
      ロゴ原本が未配置のあいだは暫定の favicon.svg にフォールバックする。
      **作り直したら `?v=` を上げること** (ブラウザがタブのアイコンを握り続けるため)。
    */}
    <link
      rel="icon"
      type={LOGO.pending ? 'image/svg+xml' : 'image/png'}
      href={LOGO.pending ? '/favicon.svg' : '/favicon-mark.png?v=1'}
    />

    {/*
      ホーム画面に追加したときのアイコン / 表示名。
        - Android (Chrome) は manifest の icons を使う。192 と 512 が必須
          (web.dev/articles/install-criteria の installability criteria)。
        - iOS Safari は manifest ではなく `apple-touch-icon` を使う
        - **URL の `?v=` は必ずアイコンを作り直すたびに上げること**。Chrome は
          manifest の `icons` が同じならアイコン URL を immutable 扱いして
          再ダウンロードしないため、中身だけ差し替えても**インストール済みの
          ホーム画面アイコンは永久に古いまま**になる
          (出典: web.dev/articles/manifest-updates)
          (Apple: Configuring Web Applications)。180x180 を 1 枚置く。
        - 画像は scripts/build-pwa-icons.mjs が Welltect ロゴから生成する
          (ロゴは加工せず、白地の正方形に余白付きで配置するだけ)。
    */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <meta name="apple-mobile-web-app-title" content="Welltect" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <title>{title}</title>
  </head>
  <body class="min-h-full">
    <div class={`mx-auto flex min-h-screen flex-col safe-top safe-bottom ${WIDTH[width]}`}>
      <slot />
    </div>
    {/* Google One Tap (PUBLIC_GOOGLE_CLIENT_ID 未設定なら何もレンダリングしない) */}
    <GoogleOneTap />

    {/*
      最小の Service Worker (オフライン案内だけ)。中身と「やらないこと」は public/sw.js を読む。
      正本: docs/elith/AI疾病予防報告書_仕様書.md §4.4 (発注者判断 2026-08-28)。

      **報告書をキャッシュするための仕組みではない。** `/report` は SSR なので、
      キャッシュすると認証を通さず HTML を返すことになる。オフラインで残す手段は
      「印刷ビュー → 共有 → PDF で『ファイル』へ保存」の方 (手段 A)。

      登録に失敗しても画面は壊さない (SW が無い＝今までどおり)。
      `?sw=off` で登録を解除できる — 実機で SW が悪さをしたときの逃げ道。
    */}
    <script is:inline>
      (function () {
        if (!('serviceWorker' in navigator)) return;
        try {
          if (new URL(location.href).searchParams.get('sw') === 'off') {
            navigator.serviceWorker.getRegistrations()
              .then(function (rs) { rs.forEach(function (r) { r.unregister(); }); })
              .catch(function () {});
            return;
          }
          addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          });
        } catch (e) { /* 登録できない環境では何もしない */ }
      })();
    </script>
  </body>
</html>
